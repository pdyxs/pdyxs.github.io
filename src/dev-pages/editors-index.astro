---
// Dev-only: lists the registered editors. See editor.astro.
import Base from '../layouts/Base.astro';
---
<Base title="Dev editors">
  <main class="ed-index">
    <h1>Dev editors</h1>
    <ul id="editors"></ul>
    <script>
      const list = document.getElementById('editors')!;
      const editors: { id: string; name: string }[] = await (await fetch('/__dev-editors/editors')).json();
      for (const e of editors) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/dev/editors/${e.id}`;
        a.textContent = e.name;
        li.append(a);
        list.append(li);
      }
    </script>
  </main>
</Base>

<style>
  .ed-index {
    max-width: 52rem;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md);
  }
  h1 {
    margin: 0 0 var(--space-md);
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2rem, 5vw, 2.75rem);
  }
  #editors { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-sm); }
  #editors :global(a) {
    display: block;
    padding: var(--space-sm) var(--space-md);
    border: var(--border-width) solid var(--color-border);
    font-weight: 600;
    text-decoration: none;
  }
  #editors :global(a:hover) { background: var(--color-bg-hover); }
</style>
