---
// Full-page cold load for a lens location. Adding a lens is a registry data
// entry (src/lib/lens-registry.ts) — this route file never changes. Rendering
// is delegated to LensPage.astro, shared with the `/` shortcut so `/` and
// `/lens/home` render identical output.
import { LENS_REGISTRY } from '../../lib/lens-registry';
import LensPage from '../../components/LensPage.astro';

export async function getStaticPaths() {
  return LENS_REGISTRY.map(l => ({ params: { name: l.id } }));
}

const { name } = Astro.params;
---
<LensPage name={name!} />
