---
export const partial = true;

import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const puzzles = await getCollection('puzzles');
  return puzzles.map(p => ({ params: { id: p.id }, props: { puzzle: p } }));
}

const { puzzle } = Astro.props;
const uid = `puzzles/${puzzle.id}`;
const { Content } = await render(puzzle);
const playUrl = puzzle.data.sudokupad_url ?? puzzle.data.url;
---

<div class="stack-card" data-uid={uid}>
  <div class="stack-card-header">
    <h2 class="stack-card-title">{puzzle.data.title}</h2>
    <button class="stack-card-close" aria-label="Close">×</button>
  </div>
  <div class="stack-card-body">
    {puzzle.data.image && (
      <img src={puzzle.data.image} alt={`Preview of ${puzzle.data.title}`} class="puzzle-image" />
    )}
    <dl class="puzzle-meta">
      {puzzle.data.puzzle_type && <><dt>Type</dt><dd>{puzzle.data.puzzle_type}</dd></>}
      <dt>Difficulty</dt><dd>{puzzle.data.difficulty}</dd>
      <dt>Published</dt><dd>{puzzle.data.date.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' })}</dd>
    </dl>
    <Content />
    <div class="puzzle-actions">
      <a href={playUrl} target="_blank" rel="noopener noreferrer" class="puzzle-play-link">Play puzzle →</a>
      {puzzle.data.sudokupad_url && (
        <a href={puzzle.data.url} target="_blank" rel="noopener noreferrer" class="puzzle-lmd-link">Logic Masters page</a>
      )}
    </div>
  </div>
</div>
