---
import { getImage } from 'astro:assets';
import { getAllCards } from '../../lib/cards';
import type { CardMeta, ResolvedCard } from '../../lib/cards';
import { getTagRegistry, flattenTagDisplay } from '../../lib/tag-registry';
import type { TagDisplay } from '../../lib/tag-display';
import { computeRelatedCardsIndex } from '../../lib/card-identity';
import { resolveLocalImage, isRemoteImageUrl } from '../../lib/images';
import Base from '../../layouts/Base.astro';
import StackNav from '../../components/StackNav.astro';
import CardStackCard from '../../components/CardStackCard.astro';

export async function getStaticPaths() {
  const cards = await getAllCards();
  // Reachability filter (see computeStatusVisibility): a card whose status
  // isn't reachable (e.g. draft, outside isDev) gets no static path at all —
  // its URL 404s. tagDisplay/relatedCardsIndex are built from this same
  // reachable set so neither ever surfaces a non-reachable card.
  const reachableCards = cards.filter(c => c.visibility.reachable);
  // Computed once here (not per-card) since it walks the whole content tree —
  // shared across every static path this route generates.
  const tagDisplay = flattenTagDisplay(await getTagRegistry(reachableCards));
  const relatedCardsIndex = computeRelatedCardsIndex(reachableCards);
  // The whole resolved card rides along, so neither this page nor
  // CardStackCard ever re-derives any of it (issue #77). Base.astro's share
  // metadata (canonical/OG/Twitter/JSON-LD, issue #71) reads it here; the card
  // fragment reads it via the `card` prop.
  return reachableCards.map(c => ({
    params: { path: c.uid },
    props: {
      card: c,
      tagDisplay,
      relatedCards: relatedCardsIndex.get(c.uid) ?? [],
    },
  }));
}

const { path } = Astro.params;
const { card, tagDisplay, relatedCards } = Astro.props as {
  card: ResolvedCard;
  tagDisplay: Record<string, TagDisplay>;
  relatedCards: CardMeta[];
};
const { title, description, date, image } = card;

// Share-image resolution (the thin effect): a colocated header image goes
// through astro:assets at OG's canonical 1200px width; a remote image is used
// as-is only when the URL ends in a known image extension (dead Jekyll-era
// embed/video links would otherwise become a broken og:image). Anything else
// leaves `ogImage` undefined and resolveOgImage falls back to the site default.
const localImage = resolveLocalImage(path!, image);
let ogImage: string | undefined;
if (localImage) {
  ogImage = (await getImage({ src: localImage, width: 1200, format: 'jpeg' })).src;
} else if (image && isRemoteImageUrl(image)) {
  ogImage = image;
}
---

<Base {title} {description} {date} image={ogImage} ogType={date ? 'article' : 'website'}>
  <div id="homepage" hidden></div>
  <StackNav activeUid={path}>
    <CardStackCard {card} {tagDisplay} {relatedCards} />
  </StackNav>
</Base>
