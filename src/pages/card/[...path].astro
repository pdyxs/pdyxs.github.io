---
import { getCollection, render } from 'astro:content';
import { getAllCards } from '../../lib/cards';
import Base from '../../layouts/Base.astro';
import CardHeader from '../../components/CardHeader.astro';
import StackNav from '../../components/StackNav.astro';
import GenericRenderer from '../../components/card-renderers/GenericRenderer.astro';
import { COLLECTION_RENDERERS } from '../../lib/renderers';

export async function getStaticPaths() {
  const cards = await getAllCards();
  const tags = await getCollection('tag');
  return [
    ...cards.map(c => ({ params: { path: c.uid } })),
    ...tags.map(t => ({ params: { path: `tag/${t.id}` } })),
  ];
}

const { path } = Astro.params;
const parts = path!.split('/');
const collection = parts[0];
const id = parts.slice(1).join('/');

const entries = await getCollection(collection as any);
const entry = entries.find((e: any) => e.id === id);
const rendered = entry ? await render(entry as any) : null;
const Content = rendered?.Content;

const rendererName: string | undefined = (entry?.data as any)?.renderer;
const Renderer =
  (rendererName ? COLLECTION_RENDERERS[rendererName] : null) ??
  COLLECTION_RENDERERS[collection] ??
  GenericRenderer;

const title: string = (entry?.data as any)?.title ?? (entry?.data as any)?.name ?? '';
---

<Base title={title}>
  <div id="homepage" hidden></div>
  <StackNav activeUid={path}>
    <div class="stack-card stack-card--active" data-uid={path}>
      <CardHeader {title} titleSuffix={(entry?.data as any)?.titleSuffix}>
        <button class="stack-card-close" aria-label="Close">×</button>
      </CardHeader>
      <div class="body-wrapper open">
        <div class="stack-card-body">
          <div class="stack-card-body-inner">
            <Renderer {entry} {Content} />
          </div>
        </div>
      </div>
    </div>
  </StackNav>
</Base>
