---
import { getCollection } from 'astro:content';
import { getAllCards } from '../../lib/cards';
import Base from '../../layouts/Base.astro';
import StackNav from '../../components/StackNav.astro';
import CardStackCard from '../../components/CardStackCard.astro';

export async function getStaticPaths() {
  const cards = await getAllCards();
  const tags = await getCollection('tag');
  return [
    ...cards.map(c => ({ params: { path: c.uid } })),
    ...tags.map(t => ({ params: { path: `tag/${t.id}` } })),
  ];
}

const { path } = Astro.params;

// Cheap title lookup for <title> — CardStackCard does the (potentially
// expensive) Content render itself; this only needs frontmatter.
const parts = path!.split('/');
const collection = parts[0];
const id = parts.slice(1).join('/');
let title = '';
if (id !== '') {
  if (collection === 'tag') {
    const tags = await getCollection('tag');
    title = tags.find((t: any) => t.id === id)?.data.name ?? '';
  } else {
    const allContent = await getCollection('content');
    const entry = allContent.find((e: any) => e.id === path);
    title = (entry?.data as any)?.title ?? '';
  }
}
---

<Base {title}>
  <div id="homepage" hidden></div>
  <StackNav activeUid={path}>
    <CardStackCard path={path!} />
  </StackNav>
</Base>
