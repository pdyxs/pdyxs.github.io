---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CardLink from '../components/CardLink.astro';
import StackNav from '../components/StackNav.astro';

const panels = (await getCollection('cards', c => c.data.panel === true))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Base>
  <div id="homepage">
    <header class="site-header">
      <h1 class="site-title">pdyxs.wtf</h1>
      <p class="site-tagline">Paul Sztajer — Software Engineer & Creative Technologist</p>
    </header>

    <main class="site-main">
      <nav class="panel-links">
        {panels.map(panel => (
          <CardLink
            uid={`cards/${panel.id}`}
            title={panel.data.title}
            titleSuffix={panel.data.titleSuffix}
          />
        ))}
      </nav>
    </main>
  </div>

  <StackNav />
</Base>

