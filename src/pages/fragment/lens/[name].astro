---
// Fragment partial: renders just the `.stack-card` markup for a lens
// location, with island props baked in — no <html> shell. In-app navigation
// fetches this instead of the full page + stripping it client-side.
export const partial = true;

import { LENS_REGISTRY, isLensVisible } from '../../../lib/lens-registry';
import LensStackCard from '../../../components/LensStackCard.astro';

export async function getStaticPaths() {
  // See src/pages/lens/[name].astro: a devOnly lens is excluded from static
  // path enumeration outside the dev/preview server, so its fragment 404s
  // in a production build too.
  return LENS_REGISTRY.filter(l => isLensVisible(l, import.meta.env.DEV)).map(l => ({ params: { name: l.id } }));
}

const { name } = Astro.params;
---
<LensStackCard name={name!} />
