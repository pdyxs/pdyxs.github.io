---
import Base from '../layouts/Base.astro';
import StackNav from '../components/StackNav.astro';
import BrowsePage from '../components/BrowsePage.svelte';
import { getAllCards } from '../lib/cards';
import { buildAllDimensionHierarchies } from '../lib/browse-helpers';

const allCards = await getAllCards();
const hierarchies = buildAllDimensionHierarchies(allCards);

// Serialise CardMeta for the client — dates must become ISO strings (not Date
// objects) so they survive JSON serialisation inside props.
const serialisedCards = allCards.map(card => ({
  ...card,
  date: card.date?.toISOString() ?? null,
}));
---

<Base title="Browse" description="Explore all content by dimension">
  <BrowsePage
    client:load
    cards={serialisedCards}
    hierarchies={hierarchies}
  />
  <StackNav />
</Base>
