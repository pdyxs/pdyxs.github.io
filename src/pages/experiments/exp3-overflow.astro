---
// EXPERIMENT 3 — overflow ⋯ strip behaviour
import Base from '../../layouts/Base.astro';
---

<Base title="Exp 3: overflow ⋯ strip">
  <main class="exp-main">
    <h1>Exp 3 — Overflow <code>⋯</code> strip</h1>
    <p class="exp-note">
      When more than 3 collapsed cards exist, the middle ones collapse into a <code>⋯</code>
      slot. This page prototypes: (a) the collapsed strip look; (b) the expanded panel;
      (c) the peek state on desktop (active card shrinks); (d) the right-side flat
      <code>⋯</code> indicator (Option C from Exp 2).
    </p>

    <!-- ── A: Collapsed ⋯ strip look ─────────────────────────────────── -->

    <div class="exp-label">A1 — ⋯ strip: left side (between first and last)</div>
    <div class="fan-row" style="--stagger:8px; --n:3">
      <div class="fan-inner">
        <div class="fan-corner" style="--i:0"></div>
        <div class="fan-strip" style="--i:0"><div class="fan-hdr fan-hdr--vert"><span class="fan-title">Alpha (first)</span></div></div>
        <div class="fan-corner" style="--i:1"></div>
        <div class="fan-strip fan-strip--overflow" style="--i:1"><div class="fan-hdr fan-hdr--vert fan-hdr--overflow"><span class="fan-overflow-glyph">⋯</span></div></div>
        <div class="fan-corner" style="--i:2"></div>
        <div class="fan-strip" style="--i:2"><div class="fan-hdr fan-hdr--vert"><span class="fan-title">Epsilon (last)</span></div></div>
        <div class="fan-active">
          <div class="fan-hdr"><span class="fan-title">Zeta — Active</span><button class="fan-close">×</button></div>
          <div class="fan-body"><p>3 visible slots: first, ⋯, last. Middle cards hidden.</p></div>
        </div>
      </div>
    </div>

    <div class="exp-label">A2 — ⋯ strip: right side (flat, 2+ cards on right)</div>
    <div class="fan-row" style="--stagger:8px; --n:2; --m:0">
      <div class="fan-inner">
        <div class="fan-corner" style="--i:0"></div>
        <div class="fan-strip" style="--i:0"><div class="fan-hdr fan-hdr--vert"><span class="fan-title">Alpha</span></div></div>
        <div class="fan-corner" style="--i:1"></div>
        <div class="fan-strip" style="--i:1"><div class="fan-hdr fan-hdr--vert"><span class="fan-title">Beta</span></div></div>
        <div class="fan-active" style="margin-right: calc(48px - var(--border-width))">
          <div class="fan-hdr"><span class="fan-title">Gamma — Active</span><button class="fan-close">×</button></div>
          <div class="fan-body"><p>Any 2+ cards to the right → flat ⋯ strip.</p></div>
        </div>
        <div class="fan-strip-rc fan-strip--overflow"><div class="fan-hdr fan-hdr--vert fan-hdr--overflow"><span class="fan-overflow-glyph">⋯</span></div></div>
      </div>
    </div>

    <!-- ── B: Expanded ⋯ panel ───────────────────────────────────────── -->

    <div class="exp-label">B — ⋯ strip expanded: hidden cards listed inside</div>
    <div class="fan-row" style="--stagger:8px; --n:3">
      <div class="fan-inner">
        <div class="fan-corner" style="--i:0"></div>
        <div class="fan-strip" style="--i:0"><div class="fan-hdr fan-hdr--vert"><span class="fan-title">Alpha</span></div></div>
        <div class="fan-corner" style="--i:1"></div>
        <div class="fan-strip fan-strip--overflow fan-strip--expanded" style="--i:1">
          <div class="fan-hdr fan-hdr--vert fan-hdr--overflow"><span class="fan-overflow-glyph">⋯</span></div>
          <div class="fan-overflow-panel">
            <div class="fan-overflow-header">Hidden cards</div>
            <button class="fan-overflow-item">Beta Initiative</button>
            <button class="fan-overflow-item">Gamma Work</button>
            <button class="fan-overflow-item">Delta Project</button>
            <button class="fan-overflow-item">Epsilon Thing</button>
          </div>
        </div>
        <div class="fan-corner" style="--i:2"></div>
        <div class="fan-strip" style="--i:2"><div class="fan-hdr fan-hdr--vert"><span class="fan-title">Epsilon</span></div></div>
        <div class="fan-active">
          <div class="fan-hdr"><span class="fan-title">Zeta — Active</span><button class="fan-close">×</button></div>
          <div class="fan-body"><p>⋯ expanded: hidden cards listed as an overlay panel. Click one to navigate.</p></div>
        </div>
      </div>
    </div>

    <!-- ── C: Peek state (active card shrinks on desktop when ⋯ expands) -->

    <div class="exp-label">C — peek state: active card shrinks when ⋯ expands on desktop</div>
    <div class="fan-row" style="--stagger:8px; --n:3">
      <div class="fan-inner">
        <div class="fan-corner" style="--i:0"></div>
        <div class="fan-strip" style="--i:0"><div class="fan-hdr fan-hdr--vert"><span class="fan-title">Alpha</span></div></div>
        <div class="fan-corner" style="--i:1"></div>
        <div class="fan-strip fan-strip--overflow fan-strip--expanded" style="--i:1">
          <div class="fan-hdr fan-hdr--vert fan-hdr--overflow"><span class="fan-overflow-glyph">⋯</span></div>
          <div class="fan-overflow-panel">
            <div class="fan-overflow-header">Hidden cards</div>
            <button class="fan-overflow-item">Beta Initiative</button>
            <button class="fan-overflow-item">Gamma Work</button>
            <button class="fan-overflow-item">Delta Project</button>
          </div>
        </div>
        <div class="fan-corner" style="--i:2"></div>
        <div class="fan-strip" style="--i:2"><div class="fan-hdr fan-hdr--vert"><span class="fan-title">Epsilon</span></div></div>
        <div class="fan-active fan-active--peek">
          <div class="fan-hdr"><span class="fan-title">Zeta — Active ↩</span></div>
          <div class="fan-body"><p>Body hidden. Header slightly wider than a normal collapsed strip so it's a visible "return here" tap target.</p></div>
        </div>
      </div>
    </div>

  </main>
</Base>

<style>
  .exp-main {
    padding: var(--space-lg) var(--space-md);
    max-width: 100%;
  }

  h1 {
    font-size: 1.1rem;
    border-bottom: var(--border-width) solid var(--color-border);
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .exp-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .exp-label {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    margin-bottom: var(--space-xs);
    margin-top: var(--space-lg);
  }

  /* ── Row / inner (copied from exp2) ──────────────────────────────── */

  .fan-row {
    padding-top: calc(var(--n) * var(--stagger, 8px));
    padding-bottom: calc(var(--m, 0) * var(--stagger, 8px));
    overflow-x: clip;
    margin-bottom: var(--space-xl);
  }

  .fan-inner {
    position: relative;
    display: flex;
    flex-direction: row;
    overflow: visible;
  }

  /* ── Collapsed strip (left side) ─────────────────────────────────── */

  .fan-strip {
    position: absolute;
    width: 48px;
    top: calc((var(--i) - var(--n)) * var(--stagger, 8px));
    bottom: calc((var(--n) - var(--i)) * var(--stagger, 8px));
    left: calc(var(--i) * 48px);
    z-index: calc(var(--i) + 1);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }

  .fan-corner {
    position: absolute;
    left: calc((var(--i) + 1) * 48px - var(--border-width));
    top: calc((var(--i) - var(--n)) * var(--stagger, 8px));
    right: calc(var(--m, 0) * 48px + (var(--n) - var(--i)) * var(--stagger, 8px));
    height: var(--stagger, 8px);
    border-top: var(--border-width) solid var(--color-border);
    border-right: var(--border-width) solid var(--color-border);
    z-index: calc(var(--i) + 1);
  }

  /* ── Right flat strip (Option C) ─────────────────────────────────── */

  .fan-strip-rc {
    position: absolute;
    width: 48px;
    right: 0;
    top: 0;
    bottom: 0;
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }

  /* ── Overflow strip variants ─────────────────────────────────────── */

  .fan-strip--overflow {
    background: var(--color-bg);   /* slightly different background to hint it's special */
  }

  .fan-strip--expanded {
    z-index: 99;
    overflow: visible;  /* let the panel drop below the strip's normal bounds */
  }

  /* ── Overflow glyph header ───────────────────────────────────────── */

  .fan-hdr--overflow {
    justify-content: center;
    align-items: center;
    background: none;
    border-bottom: none;
  }

  .fan-overflow-glyph {
    font-size: 1.2rem;
    font-family: var(--font-ui);
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
  }

  /* ── Expanded overflow panel (list of hidden cards) ──────────────── */

  /* Panel drops down from the top of the strip as an overlay */
  .fan-overflow-panel {
    position: absolute;
    top: 0;
    left: calc(-1 * var(--border-width));  /* align outer edge with strip's left border */
    width: 160px;
    display: flex;
    flex-direction: column;
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
    z-index: 1;
  }

  .fan-overflow-header {
    padding: var(--space-xs) var(--space-md);
    font-size: 0.68rem;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    border-bottom: var(--border-width) solid var(--color-border);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .fan-overflow-item {
    background: none;
    border: none;
    border-bottom: var(--border-width) solid var(--color-border);
    padding: var(--space-sm) var(--space-md);
    text-align: left;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--color-text);
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .fan-overflow-item:last-child { border-bottom: none; }
  .fan-overflow-item:hover { background: var(--color-bg); }

  /* ── Active card ─────────────────────────────────────────────────── */

  .fan-active {
    margin-left: calc(var(--n) * 48px - var(--border-width));
    margin-right: max(calc(var(--m, 0) * 48px - var(--border-width)), 0px);
    flex: 1;
    min-width: 0;
    position: relative;
    z-index: calc(var(--n) + 1);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
  }

  /* Peek state: body hidden, header stays as a "return here" target */
  .fan-active--peek {
    flex: 0 0 72px;   /* slightly wider than a collapsed strip (48px) */
    min-height: 160px; /* keeps fan-inner tall so absolutely-positioned strips stay visible */
  }

  .fan-active--peek .fan-body {
    display: none;
  }

  .fan-active--peek .fan-hdr {
    writing-mode: vertical-rl;
    flex: 1;
    border-bottom: none;
    justify-content: flex-start;
    align-items: center;
    padding: var(--space-md) var(--space-xs);
    background: repeating-linear-gradient(
      to right,
      transparent 0px, transparent 18px,
      var(--color-bg-stripes) 19px, var(--color-bg-stripes) 20px
    );
    overflow: hidden;
  }

  /* ── Headers ─────────────────────────────────────────────────────── */

  .fan-hdr {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-heading);
    font-size: 1rem;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px, transparent 18px,
      var(--color-bg-stripes) 19px, var(--color-bg-stripes) 20px
    );
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .fan-title {
    background: var(--color-surface);
    padding: 0 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .fan-hdr--vert {
    writing-mode: vertical-rl;
    flex: 1;
    border-bottom: none;
    justify-content: flex-start;
    align-items: center;
    padding: var(--space-md) var(--space-xs);
    background: repeating-linear-gradient(
      to right,
      transparent 0px, transparent 18px,
      var(--color-bg-stripes) 19px, var(--color-bg-stripes) 20px
    );
    overflow: hidden;
  }

  .fan-hdr--vert .fan-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Body ────────────────────────────────────────────────────────── */

  .fan-body {
    padding: var(--space-md) var(--space-lg);
    font-size: 0.9rem;
    flex: 1;
  }

  .fan-body p { margin: 0 0 var(--space-sm); }
  .fan-body p:last-child { margin: 0; }

  .fan-close {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.4rem;
    font-weight: 300;
    font-family: var(--font-ui);
    line-height: 1;
    padding: 0;
    color: var(--color-text);
    flex-shrink: 0;
  }
</style>
