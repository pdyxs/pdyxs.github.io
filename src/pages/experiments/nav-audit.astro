---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getAllCards, getCardsForTag } from '../../lib/cards';
import type { CardMeta } from '../../lib/cards';

const isDev = import.meta.env.DEV;

type AuditData = {
  panels: { id: string; title: string }[];
  reachableCards: CardMeta[];
  unreachableCards: CardMeta[];
  totalCards: number;
};

let audit: AuditData | null = null;

if (isDev) {
  const allCards = await getAllCards();
  const allTags = await getCollection('tag');

  // Build uid → raw body map from all collections that have markdown
  const [cards, posts, projects, puzzles, stories, work] = await Promise.all([
    getCollection('cards'),
    getCollection('posts'),
    getCollection('projects'),
    getCollection('puzzles'),
    getCollection('stories'),
    getCollection('work'),
  ]);

  const bodyByUid = new Map<string, string>();
  for (const e of cards)    bodyByUid.set(`cards/${e.id}`,    (e as any).body ?? '');
  for (const e of posts)    bodyByUid.set(`posts/${e.id}`,    (e as any).body ?? '');
  for (const e of projects) bodyByUid.set(`projects/${e.id}`, (e as any).body ?? '');
  for (const e of puzzles)  bodyByUid.set(`puzzles/${e.id}`,  (e as any).body ?? '');
  for (const e of stories)  bodyByUid.set(`stories/${e.id}`,  (e as any).body ?? '');
  for (const e of work)     bodyByUid.set(`work/${e.id}`,     (e as any).body ?? '');

  const tagBySlug = new Map(allTags.map(t => [t.id, t]));

  const tagLinkRe = /\[.*?\]\(tag:([^)]+)\)/g;
  const pushCardRe = /data-push-card="([^"]+)"/g;
  const collectionLinkRe = /\[.*?\]\(collection:([^)?]+)(?:\?[^)]+)?\)/g;

  function extractLinks(body: string): { tags: string[]; pushCards: string[]; collections: string[] } {
    return {
      tags: [...body.matchAll(tagLinkRe)].map(m => m[1]),
      pushCards: [...body.matchAll(pushCardRe)].map(m => m[1]),
      collections: [...body.matchAll(collectionLinkRe)].map(m => m[1]),
    };
  }

  // BFS through the navigation graph
  const reachableUids = new Set<string>();
  const visitedTagSlugs = new Set<string>();

  const panels = (await getCollection('cards', c => c.data.panel === true))
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

  const queue: string[] = panels.map(p => `cards/${p.id}`);

  while (queue.length > 0) {
    const uid = queue.shift()!;
    if (reachableUids.has(uid)) continue;
    reachableUids.add(uid);

    const body = bodyByUid.get(uid) ?? '';
    const { tags, pushCards, collections } = extractLinks(body);

    for (const slug of tags) {
      if (visitedTagSlugs.has(slug)) continue;
      visitedTagSlugs.add(slug);
      const tag = tagBySlug.get(slug);
      if (!tag) continue;
      for (const c of getCardsForTag(tag, allCards)) {
        if (!reachableUids.has(c.uid)) queue.push(c.uid);
      }
    }

    for (const pushUid of pushCards) {
      if (!reachableUids.has(pushUid)) queue.push(pushUid);
    }

    // collection: links — the collection view card is reachable, and so is every
    // card in that collection (the view shows them all).
    for (const collectionUid of collections) {
      reachableUids.add(collectionUid);
      for (const c of allCards.filter(c => c.collection === collectionUid)) {
        if (!reachableUids.has(c.uid)) queue.push(c.uid);
      }
    }
  }

  audit = {
    panels: panels.map(p => ({ id: p.id, title: p.data.title })),
    reachableCards: allCards.filter(c => reachableUids.has(c.uid)),
    unreachableCards: allCards.filter(c => !reachableUids.has(c.uid)),
    totalCards: allCards.length,
  };
}
---

<Base title="Nav Audit">
  <div class="audit">
    <h1>Navigation Audit</h1>

    {!isDev && <p>This page is only available in development mode.</p>}

    {isDev && audit && (
      <>
        <p class="summary">
          <strong>{audit.reachableCards.length}</strong> of <strong>{audit.totalCards}</strong> cards reachable from homepage.
          {audit.unreachableCards.length > 0 &&
            <span class="unreachable-count"> {audit.unreachableCards.length} unreachable.</span>
          }
        </p>

        <section>
          <h2>Unreachable Cards ({audit.unreachableCards.length})</h2>
          {audit.unreachableCards.length === 0
            ? <p class="all-good">All cards are reachable.</p>
            : (
              <table>
                <thead><tr><th>Collection</th><th>UID</th><th>Title</th></tr></thead>
                <tbody>
                  {audit.unreachableCards.map(c => (
                    <tr>
                      <td class="collection">{c.collection}</td>
                      <td><a href={`/card/${c.uid}`}>{c.uid}</a></td>
                      <td>{c.title}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )
          }
        </section>
      </>
    )}
  </div>
</Base>

<style>
  .audit {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-lg);
    font-family: var(--font-body);
  }

  h1 { margin-bottom: var(--space-md); }
  h2 { margin: var(--space-lg) 0 var(--space-sm); border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-xs); }

  .summary { font-size: 1.1rem; margin-bottom: var(--space-lg); }
  .unreachable-count { color: var(--color-danger, #c0392b); margin-left: var(--space-sm); }

  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th { text-align: left; padding: var(--space-xs) var(--space-sm); border-bottom: 2px solid var(--color-border); }
  td { padding: var(--space-xs) var(--space-sm); border-bottom: 1px solid var(--color-border); }
  .collection { opacity: 0.6; }

  .all-good { color: var(--color-success, #27ae60); }
</style>
