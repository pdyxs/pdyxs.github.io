---
// EXPERIMENT 1 RESULT — writing-mode: vertical-rl on collapsed card header
// CONFIRMED. Do not modify. Delete when feature is built.
import Base from '../../layouts/Base.astro';
---

<Base title="Exp 1: collapsed header (confirmed)">
  <main class="exp-main">
    <h1>Exp 1 — Confirmed: <code>writing-mode: vertical-rl</code></h1>

    <p class="exp-note">
      Collapsed cards use <code>writing-mode: vertical-rl</code> with a surface-colour title
      background. Header fills card height via <code>flex: 1</code> on a flex-column card.
      Border-bottom removed from header (card outer border covers it).
    </p>

    <div class="exp-label">2 collapsed + 1 active</div>
    <div class="mock-stack">
      <div class="mock-card mock-collapsed">
        <div class="mock-header mock-header--vert">
          <span class="mock-title">Alpha Project</span>
        </div>
      </div>
      <div class="mock-card mock-collapsed">
        <div class="mock-header mock-header--vert">
          <span class="mock-title">Beta Initiative</span>
        </div>
      </div>
      <div class="mock-card mock-active">
        <div class="mock-header">
          <span class="mock-title">Gamma — Active Card</span>
          <button class="mock-close">×</button>
        </div>
        <div class="mock-body">
          <p>Active card body content. Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        </div>
      </div>
    </div>

    <div class="exp-label">Active card in the middle</div>
    <div class="mock-stack">
      <div class="mock-card mock-collapsed">
        <div class="mock-header mock-header--vert">
          <span class="mock-title">Alpha Project</span>
        </div>
      </div>
      <div class="mock-card mock-collapsed">
        <div class="mock-header mock-header--vert">
          <span class="mock-title">Beta Initiative</span>
        </div>
      </div>
      <div class="mock-card mock-active">
        <div class="mock-header">
          <span class="mock-title">Gamma — Active Card</span>
          <button class="mock-close">×</button>
        </div>
        <div class="mock-body">
          <p>Active card in the middle. Collapsed cards on both sides.</p>
        </div>
      </div>
      <div class="mock-card mock-collapsed">
        <div class="mock-header mock-header--vert">
          <span class="mock-title">Delta Thing</span>
        </div>
      </div>
      <div class="mock-card mock-collapsed">
        <div class="mock-header mock-header--vert">
          <span class="mock-title">Epsilon Work</span>
        </div>
      </div>
    </div>

    <div class="exp-label">Long titles</div>
    <div class="mock-stack">
      <div class="mock-card mock-collapsed">
        <div class="mock-header mock-header--vert">
          <span class="mock-title">A Very Long Project Name Here</span>
        </div>
      </div>
      <div class="mock-card mock-collapsed">
        <div class="mock-header mock-header--vert">
          <span class="mock-title">Another Quite Long Title For Testing</span>
        </div>
      </div>
      <div class="mock-card mock-active">
        <div class="mock-header">
          <span class="mock-title">Active Card</span>
          <button class="mock-close">×</button>
        </div>
        <div class="mock-body">
          <p>Long titles truncate cleanly with text-overflow: ellipsis.</p>
        </div>
      </div>
    </div>
  </main>
</Base>

<style>
  .exp-main {
    padding: var(--space-lg) var(--space-md);
    max-width: 100%;
  }

  h1 {
    font-size: 1.1rem;
    border-bottom: var(--border-width) solid var(--color-border);
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .exp-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .exp-label {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    margin-bottom: var(--space-xs);
  }

  /* ── Stack ────────────────────────────────────────────────────── */

  .mock-stack {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    border: var(--border-width) solid var(--color-border);
    margin-bottom: var(--space-lg);
  }

  .mock-card {
    display: flex;
    flex-direction: column;
    border-right: var(--border-width) solid var(--color-border);
  }

  .mock-card:last-child { border-right: none; }

  .mock-collapsed {
    flex-shrink: 0;
    width: 48px;
  }

  .mock-active { flex: 1; }

  /* ── Header — horizontal (active) ────────────────────────────── */

  .mock-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-heading);
    font-size: 1rem;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px, transparent 18px,
      var(--color-bg-stripes) 19px, var(--color-bg-stripes) 20px
    );
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .mock-title {
    background: var(--color-surface);
    padding: 0 2px;
  }

  /* ── Header — vertical (collapsed) ───────────────────────────── */

  .mock-header--vert {
    writing-mode: vertical-rl;
    flex: 1;
    border-bottom: none;
    justify-content: flex-start;
    align-items: center;
    padding: var(--space-md) var(--space-xs);
    background: repeating-linear-gradient(
      to right,
      transparent 0px, transparent 18px,
      var(--color-bg-stripes) 19px, var(--color-bg-stripes) 20px
    );
    overflow: hidden;
  }

  .mock-header--vert .mock-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Body ─────────────────────────────────────────────────────── */

  .mock-body {
    padding: var(--space-md) var(--space-lg);
    font-size: 0.9rem;
  }

  .mock-body p { margin: 0 0 var(--space-sm); }
  .mock-body p:last-child { margin: 0; }

  .mock-close {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.4rem;
    font-weight: 300;
    font-family: var(--font-ui);
    line-height: 1;
    padding: 0;
    color: var(--color-text);
    flex-shrink: 0;
  }
</style>
