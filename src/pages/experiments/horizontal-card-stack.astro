---
// EXPERIMENT PAGE: horizontal-card-stack
// Standalone visual mock — no reliance on existing card/stack CSS classes.
// Delete this file when experiments are resolved.
import Base from '../../layouts/Base.astro';
---

<Base title="Experiment: horizontal-card-stack">
  <main class="exp-main">
    <h1>Experiment: horizontal-card-stack</h1>
    <p class="exp-intro">
      Standalone visual mock. No existing card CSS — just experimenting with layout and look.
    </p>

    <!-- ══════════════════════════════════════════════════════════════
         EXP 1: writing-mode on collapsed header (confirmed in prev session)
         Keeping one reference row for comparison during Exp 2/3.
         ══════════════════════════════════════════════════════════════ -->
    <section class="exp-section">
      <h2>Exp 1 — Collapsed header style (reference)</h2>
      <p class="exp-note">Confirmed: <code>writing-mode: vertical-rl</code> with surface-colour background on title.</p>

      <div class="mock-stack">
        <div class="mock-card mock-collapsed">
          <div class="mock-header mock-header--vert">
            <span class="mock-title">Alpha Project</span>
          </div>
        </div>
        <div class="mock-card mock-collapsed">
          <div class="mock-header mock-header--vert">
            <span class="mock-title">Beta Initiative</span>
          </div>
        </div>
        <div class="mock-card mock-active">
          <div class="mock-header">
            <span class="mock-title">Gamma — Active Card</span>
            <button class="mock-close">×</button>
          </div>
          <div class="mock-body">
            <p>Active card body content. Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
         EXP 2: layered / fanned stagger
         Full-size cards overlapping — only peeking edge visible
         ══════════════════════════════════════════════════════════════ -->
    <section class="exp-section">
      <h2>Exp 2 — Layered stagger (full-size cards, only edge visible)</h2>
      <p class="exp-note">
        Each collapsed card is full-size behind the next. You see only its left strip (peek) and
        its top step. Vary stagger + peek to find the right feel.
      </p>

      <div class="exp-label">3 collapsed — peek 56px, stagger 8px</div>
      <div class="fan-stack" style="--peek:56px; --stagger:8px; --n:3">
        <div class="fan-card fan-collapsed" style="--i:0">
          <div class="fan-header fan-header--vert"><span class="fan-title">Alpha Project</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-collapsed" style="--i:1">
          <div class="fan-header fan-header--vert"><span class="fan-title">Beta Initiative</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-collapsed" style="--i:2">
          <div class="fan-header fan-header--vert"><span class="fan-title">Gamma Work</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-active">
          <div class="fan-header">
            <span class="fan-title">Delta — Active</span>
            <button class="mock-close">×</button>
          </div>
          <div class="fan-body">
            <p>Active card. peek=56px, stagger=8px.</p>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          </div>
        </div>
      </div>

      <div class="exp-label">3 collapsed — peek 56px, stagger 12px</div>
      <div class="fan-stack" style="--peek:56px; --stagger:12px; --n:3">
        <div class="fan-card fan-collapsed" style="--i:0">
          <div class="fan-header fan-header--vert"><span class="fan-title">Alpha Project</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-collapsed" style="--i:1">
          <div class="fan-header fan-header--vert"><span class="fan-title">Beta Initiative</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-collapsed" style="--i:2">
          <div class="fan-header fan-header--vert"><span class="fan-title">Gamma Work</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-active">
          <div class="fan-header">
            <span class="fan-title">Delta — Active</span>
            <button class="mock-close">×</button>
          </div>
          <div class="fan-body">
            <p>Active card. peek=56px, stagger=12px.</p>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          </div>
        </div>
      </div>

      <div class="exp-label">3 collapsed — peek 64px, stagger 8px</div>
      <div class="fan-stack" style="--peek:64px; --stagger:8px; --n:3">
        <div class="fan-card fan-collapsed" style="--i:0">
          <div class="fan-header fan-header--vert"><span class="fan-title">Alpha Project</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-collapsed" style="--i:1">
          <div class="fan-header fan-header--vert"><span class="fan-title">Beta Initiative</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-collapsed" style="--i:2">
          <div class="fan-header fan-header--vert"><span class="fan-title">Gamma Work</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-active">
          <div class="fan-header">
            <span class="fan-title">Delta — Active</span>
            <button class="mock-close">×</button>
          </div>
          <div class="fan-body">
            <p>Active card. peek=64px, stagger=8px.</p>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          </div>
        </div>
      </div>

      <div class="exp-label">5 collapsed — peek 56px, stagger 8px (stress test)</div>
      <div class="fan-stack" style="--peek:56px; --stagger:8px; --n:5">
        <div class="fan-card fan-collapsed" style="--i:0">
          <div class="fan-header fan-header--vert"><span class="fan-title">Alpha</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-collapsed" style="--i:1">
          <div class="fan-header fan-header--vert"><span class="fan-title">Beta</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-collapsed" style="--i:2">
          <div class="fan-header fan-header--vert"><span class="fan-title">Gamma</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-collapsed" style="--i:3">
          <div class="fan-header fan-header--vert"><span class="fan-title">Delta</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-collapsed" style="--i:4">
          <div class="fan-header fan-header--vert"><span class="fan-title">Epsilon</span></div>
          <div class="fan-body"><p>Card body</p></div>
        </div>
        <div class="fan-card fan-active">
          <div class="fan-header">
            <span class="fan-title">Zeta — Active</span>
            <button class="mock-close">×</button>
          </div>
          <div class="fan-body">
            <p>5 collapsed + active. Does it get too wide?</p>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
         EXP 3: overflow ⋯ element
         ══════════════════════════════════════════════════════════════ -->
    <section class="exp-section">
      <h2>Exp 3 — Overflow <code>⋯</code> element</h2>
      <p class="exp-note">
        When >3 collapsed cards exist: show first + ⋯ + last. Desktop: clicking ⋯ expands it
        and shrinks the active card to a peek strip.
      </p>

      <div class="exp-label">3a — collapsed overflow (first + ⋯ + last)</div>
      <div class="mock-stack">
        <div class="mock-card mock-collapsed">
          <div class="mock-header mock-header--vert"><span class="mock-title">First Card</span></div>
        </div>
        <div class="mock-overflow">
          <span class="mock-overflow-glyph">⋯</span>
          <span class="mock-overflow-count">3 hidden</span>
        </div>
        <div class="mock-card mock-collapsed">
          <div class="mock-header mock-header--vert"><span class="mock-title">Previous Card</span></div>
        </div>
        <div class="mock-card mock-active">
          <div class="mock-header">
            <span class="mock-title">Current Active</span>
            <button class="mock-close">×</button>
          </div>
          <div class="mock-body">
            <p>5 total collapsed — first and last visible, 3 hidden in ⋯.</p>
          </div>
        </div>
      </div>

      <div class="exp-label">3b — expanded overflow (desktop: active card shrinks to peek)</div>
      <div class="mock-stack">
        <div class="mock-card mock-collapsed">
          <div class="mock-header mock-header--vert"><span class="mock-title">First Card</span></div>
        </div>
        <div class="mock-overflow mock-overflow--expanded">
          <div class="mock-overflow-top">
            <span class="mock-overflow-glyph">⋯</span>
            <span class="mock-overflow-count">3 hidden</span>
          </div>
          <div class="mock-overflow-list">
            <div class="mock-overflow-item">Card Bravo</div>
            <div class="mock-overflow-item">Card Charlie</div>
            <div class="mock-overflow-item">Card Delta</div>
          </div>
        </div>
        <div class="mock-card mock-collapsed">
          <div class="mock-header mock-header--vert"><span class="mock-title">Previous Card</span></div>
        </div>
        <div class="mock-card mock-peek">
          <div class="mock-header mock-header--vert mock-header--peek">
            <span class="mock-title">Active — tap to return</span>
          </div>
        </div>
      </div>

      <div class="exp-label">3c — mobile: expanded overflow inline (active stays expanded)</div>
      <div class="mock-stack mock-stack--vertical">
        <div class="mock-overflow mock-overflow--expanded mock-overflow--mobile">
          <div class="mock-overflow-top">
            <span class="mock-overflow-glyph">⋯</span>
            <span class="mock-overflow-count">3 hidden</span>
          </div>
          <div class="mock-overflow-list">
            <div class="mock-overflow-item">Card Bravo</div>
            <div class="mock-overflow-item">Card Charlie</div>
            <div class="mock-overflow-item">Card Delta</div>
          </div>
        </div>
        <div class="mock-card mock-collapsed">
          <div class="mock-header"><span class="mock-title">First Card</span></div>
        </div>
        <div class="mock-card mock-collapsed">
          <div class="mock-header"><span class="mock-title">Previous Card</span></div>
        </div>
        <div class="mock-card mock-active">
          <div class="mock-header">
            <span class="mock-title">Current Active</span>
            <button class="mock-close">×</button>
          </div>
          <div class="mock-body"><p>Active stays expanded on mobile.</p></div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* ── Page chrome ────────────────────────────────────────────────── */

  .exp-main {
    padding: var(--space-lg) var(--space-md);
    max-width: 100%;
    overflow-x: auto;
  }

  h1 {
    font-size: 1.1rem;
    border-bottom: var(--border-width) solid var(--color-border);
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .exp-intro {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }

  .exp-section {
    margin-bottom: var(--space-xl);
  }

  .exp-section h2 {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--color-border-light);
    padding-bottom: var(--space-xs);
    margin-bottom: var(--space-md);
    font-family: var(--font-heading);
    font-weight: 400;
  }

  .exp-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .exp-label {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-family: var(--font-ui);
    margin-bottom: var(--space-xs);
  }

  /* ══════════════════════════════════════════════════════════════════
     EXP 1 MOCK — simple horizontal strip
     ══════════════════════════════════════════════════════════════════ */

  .mock-stack {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    border: var(--border-width) solid var(--color-border);
    margin-bottom: var(--space-lg);
  }

  .mock-stack--vertical {
    flex-direction: column;
  }

  /* Shared card shell */
  .mock-card {
    border-right: var(--border-width) solid var(--color-border);
    display: flex;
    flex-direction: column;
  }

  .mock-card:last-child {
    border-right: none;
  }

  .mock-stack--vertical .mock-card {
    border-right: none;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .mock-stack--vertical .mock-card:last-child {
    border-bottom: none;
  }

  /* Collapsed: slim vertical strip */
  .mock-collapsed {
    flex-shrink: 0;
    width: 48px;
  }

  /* Active: fills remaining space */
  .mock-active {
    flex: 1;
  }

  /* Header — horizontal (active card) */
  .mock-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-heading);
    font-size: 1rem;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 18px,
      var(--color-bg-stripes) 19px,
      var(--color-bg-stripes) 20px
    );
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .mock-title {
    background: var(--color-surface);
    padding: 0 2px;
  }

  /* Header — vertical (collapsed card) */
  .mock-header--vert {
    writing-mode: vertical-rl;
    flex: 1;
    border-bottom: none;
    justify-content: flex-start;
    align-items: center;
    padding: var(--space-md) var(--space-xs);
    background: repeating-linear-gradient(
      to right,
      transparent 0px,
      transparent 18px,
      var(--color-bg-stripes) 19px,
      var(--color-bg-stripes) 20px
    );
    overflow: hidden;
  }

  .mock-header--vert .mock-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Body */
  .mock-body {
    padding: var(--space-md) var(--space-lg);
    font-size: 0.9rem;
  }

  .mock-body p { margin: 0 0 var(--space-sm); }
  .mock-body p:last-child { margin: 0; }

  /* Close button */
  .mock-close {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.4rem;
    font-weight: 300;
    font-family: var(--font-ui);
    line-height: 1;
    padding: 0;
    color: var(--color-text);
    flex-shrink: 0;
  }

  /* Overflow strip */
  .mock-overflow {
    flex-shrink: 0;
    width: 48px;
    border-right: var(--border-width) solid var(--color-border);
    background: var(--color-bg-hover);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    cursor: pointer;
    font-family: var(--font-ui);
  }

  .mock-overflow-glyph {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    line-height: 1;
  }

  .mock-overflow-count {
    font-size: 0.6rem;
    color: var(--color-text-muted);
    writing-mode: vertical-rl;
    white-space: nowrap;
  }

  /* Expanded overflow */
  .mock-overflow--expanded {
    width: 140px;
    justify-content: flex-start;
    padding: 0;
    align-items: stretch;
  }

  .mock-overflow-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-xs);
    border-bottom: 1px solid var(--color-border-light);
    gap: var(--space-xs);
  }

  .mock-overflow-list {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .mock-overflow-item {
    padding: var(--space-xs) var(--space-sm);
    font-size: 0.8rem;
    border-bottom: 1px solid var(--color-border-light);
    cursor: pointer;
  }

  .mock-overflow-item:hover { background: var(--color-bg-hover); }
  .mock-overflow-item:last-child { border-bottom: none; }

  /* Mobile expanded overflow */
  .mock-overflow--mobile {
    width: 100%;
    flex-direction: column;
    border-right: none;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .mock-overflow--mobile .mock-overflow-top {
    flex-direction: row;
    justify-content: flex-start;
    gap: var(--space-sm);
  }

  .mock-overflow--mobile .mock-overflow-count {
    writing-mode: horizontal-tb;
  }

  /* Peek state — active card shrunk to slightly-wider collapsed strip */
  .mock-peek {
    flex-shrink: 0;
    width: 72px;
    background: var(--color-bg-hover);
  }

  .mock-header--peek {
    font-size: 0.85em;
  }

  /* ══════════════════════════════════════════════════════════════════
     EXP 2 FAN STACK — full-size overlapping cards
     ══════════════════════════════════════════════════════════════════ */

  .fan-stack {
    position: relative;
    /* padding-top reserves space above active card for stagger peeking out */
    padding-top: calc(var(--n) * var(--stagger, 8px));
    margin-bottom: calc(var(--space-lg) * 2);
  }

  /* Collapsed cards: absolutely positioned, extending to the right edge.
     Each card's left edge is offset by --peek * index.
     Each card's top edge is offset by --stagger * index. */
  .fan-collapsed {
    position: absolute;
    left: calc(var(--i) * var(--peek, 56px));
    right: 0;
    top: calc(var(--i) * var(--stagger, 8px));
    z-index: var(--i);
    display: flex;
    flex-direction: column;
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
  }

  /* Active card: in normal document flow (sets container height).
     Pushed right past all the peeking strips. */
  .fan-active {
    position: relative;
    margin-left: calc(var(--n) * var(--peek, 56px));
    z-index: var(--n);
    display: flex;
    flex-direction: column;
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
  }

  /* Fan card header — horizontal (active) */
  .fan-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-heading);
    font-size: 1rem;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 18px,
      var(--color-bg-stripes) 19px,
      var(--color-bg-stripes) 20px
    );
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .fan-title {
    background: var(--color-surface);
    padding: 0 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Fan card header — vertical (collapsed) */
  .fan-header--vert {
    writing-mode: vertical-rl;
    flex: 1;
    border-bottom: none;
    justify-content: flex-start;
    align-items: center;
    padding: var(--space-md) var(--space-xs);
    background: repeating-linear-gradient(
      to right,
      transparent 0px,
      transparent 18px,
      var(--color-bg-stripes) 19px,
      var(--color-bg-stripes) 20px
    );
    overflow: hidden;
  }

  /* Fan card body */
  .fan-body {
    padding: var(--space-md) var(--space-lg);
    font-size: 0.9rem;
  }

  .fan-body p { margin: 0 0 var(--space-sm); }
  .fan-body p:last-child { margin: 0; }
</style>
