---
// Throwaway audio diagnostic (crackly audio in Firefox on Linux): the same sounds with and
// without the site around them. No Base layout, so no card stack, dither or view transitions.
// Delete this page when the cause is found.
import FlashGame from '@components/header-media/FlashGame.svelte';
// A glob, not a bare import: the SWF is content, and `main` withholds it until the
// Houston card is inspected, so a hard import would fail the production build.
const houstonSwf = Object.values(
  import.meta.glob<string>('../../content/what/games/analog/houston-we-have-a/game.swf', { query: '?url', import: 'default', eager: true }),
)[0];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Audio test</title>
    <style>
      body { font: 16px/1.5 system-ui, sans-serif; background: #fff; color: #000; max-width: 52rem; margin: 2rem auto; padding: 0 1rem; }
      section { margin-block: 2rem; padding-top: 1rem; border-top: 1px solid #000; }
      button { font: inherit; padding: .4rem .8rem; }
      #status { font-family: monospace; }
    </style>
  </head>
  <body>
    <h1>Audio test</h1>
    <p>Listen for crackle in each, in order. Note which ones crackle.</p>

    <section>
      <h2>1. Plain Web Audio tone (no game, no site)</h2>
      <p>A steady 440 Hz sine. Any crackle here is the browser or your audio setup.</p>
      <button id="tone">Play tone</button> <button id="stop">Stop</button>
      <p id="status"></p>
    </section>

    <section>
      <h2>1b. A Flatland voice line, three ways (no game, no site)</h2>
      <p>The same clip (<code>L7 Line 1b.ogg</code>, 44.1 kHz stereo Vorbis, peaks at -6 dB, so the file itself is not clipped), played by the browser's three audio paths. Which one crackles?</p>
      <p>
        <button id="v-el">A. &lt;audio&gt; element</button>
        <button id="v-wa">B. Web Audio, default rate</button>
        <button id="v-wa44">C. Web Audio, 44.1 kHz context</button>
      </p>
      <p id="v-status" style="font-family:monospace"></p>
    </section>

    <section>
      <h2>2. Houston in Ruffle, on this bare page</h2>
      <p>Press play, then click through its title. Houston has sound effects and an engine hum.</p>
      {houstonSwf ? <FlashGame swfUrl={houstonSwf} width={1024} height={768} client:load /> : <p>Houston's SWF is not on this branch.</p>}
    </section>

    <section>
      <h2>3. Flatland, standalone (not in the site's card)</h2>
      <p><a href="/games/flatland/index.html" target="_blank" rel="noopener">Open Flatland on its own page</a>. Compare with the same game on its card.</p>
    </section>

    <script is:inline>
      let ctx, osc, gain;
      const status = document.getElementById('status');
      document.getElementById('tone').addEventListener('click', () => {
        ctx = ctx || new AudioContext();
        ctx.resume();
        osc && osc.stop();
        osc = ctx.createOscillator(); gain = ctx.createGain();
        osc.frequency.value = 440; gain.gain.value = 0.15;
        osc.connect(gain).connect(ctx.destination); osc.start();
        status.textContent = 'sampleRate ' + ctx.sampleRate + ' Hz, baseLatency ' + (ctx.baseLatency * 1000).toFixed(1) + ' ms, outputLatency ' + ((ctx.outputLatency || 0) * 1000).toFixed(1) + ' ms';
      });
      document.getElementById('stop').addEventListener('click', () => { osc && osc.stop(); osc = null; });

      const VOICE = '/games/flatland/data/audio/L7%20Line%201b.ogg';
      const vstatus = document.getElementById('v-status');
      document.getElementById('v-el').addEventListener('click', () => {
        const a = new Audio(VOICE); a.play(); vstatus.textContent = 'A: <audio> element';
      });
      async function playBuffer(rate, label) {
        const c = rate ? new AudioContext({ sampleRate: rate }) : new AudioContext();
        await c.resume();
        const buf = await c.decodeAudioData(await (await fetch(VOICE)).arrayBuffer());
        const src = c.createBufferSource(); src.buffer = buf; src.connect(c.destination); src.start();
        vstatus.textContent = label + ': context ' + c.sampleRate + ' Hz, clip ' + buf.sampleRate + ' Hz';
      }
      document.getElementById('v-wa').addEventListener('click', () => playBuffer(0, 'B'));
      document.getElementById('v-wa44').addEventListener('click', () => playBuffer(44100, 'C'));
    </script>
  </body>
</html>
