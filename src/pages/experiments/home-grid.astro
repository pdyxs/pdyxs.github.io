---
/**
 * THROWAWAY PROTOTYPE — issue #132.
 *
 * Five slot-grid configurations of the flat 12-column home grid decided in
 * #131, switchable via `?variant=`, on a synthetic card set. Nothing here is
 * production code and nothing imports it; the real thing lives in
 * `src/lib/home-slots.ts` + `global.css` once this ticket resolves.
 *
 * Questions it exists to answer:
 *  1. can a flat grid express "1 and 3 stacked left, taller 2 on the right"?
 *  2. what are the two pixel values (the ~1000px small/large line, home's width)?
 *  3. are two authorable tiers (small, large) enough?
 *  4. do spans that don't sum to 12 read as the author's arithmetic or as a bug?
 *
 * Extra knobs, both throwaway: `?w=` sets the page width so home's `width:`
 * can be eyeballed, `?align=` flips the grid between `start` and `stretch`.
 */
import Base from '../../layouts/Base.astro';
import BrowseCard from '../../components/BrowseCard.svelte';
import type { BrowseCardData } from '../../lib/browse-helpers';

import photoWide from '../../content/what/writing/2017-11-19-its-probably-complicated/1-SfCva9x7ruQJPfmca-vwAA-2x.jpg';
import photoTall from '../../content/what/writing/2017-11-06-qbyte-devlog-cycles-and-cul-de-sacs/1-0oGIuQ6un8Cyur9c7wbULg-2x.jpg';

const base = {
  renderer: 'card',
  priority: 0,
  sort: { key: 'date', direction: 'desc', value: 0 },
} as const;

const CARDS: Record<string, BrowseCardData> = {
  about: {
    ...base,
    uid: 'who/about-me',
    title: 'About me',
    description:
      'Game designer, puzzle setter and software person in Sydney. I make things that ask you to pay attention.',
    date: '2025-06-01',
    tags: ['who:me'],
  },
  project: {
    ...base,
    uid: 'what/games/digital/numbeanies',
    title: 'Numbeanies',
    description:
      'A collectable-card game about numbers, made with the Numberblocks team — 40 cards, a booster mechanic, and an unreasonable amount of arithmetic playtesting.',
    date: '2024-02-11',
    tags: ['what:games', 'where:work/seethrough', 'why:playable'],
    thumb: photoWide.src,
  },
  puzzle: {
    ...base,
    uid: 'what/puzzles/cityscrapers',
    title: 'Cityscrapers',
    description:
      'A skyscraper variant where the clues live inside the grid. Level 3 (Medium).',
    date: '2025-01-08',
    tags: ['what:puzzles', 'why:playable'],
    thumb: photoTall.src,
  },
  post: {
    ...base,
    uid: 'what/writing/its-probably-complicated',
    title: "It's probably complicated",
    description:
      'On why the interesting part of a system is never the part you can name, and what that means for the way we write about our own work.',
    date: '2017-11-19',
    tags: ['what:writing'],
  },
  story: {
    ...base,
    uid: 'what/posts/stories/arctic',
    title: 'Arctic',
    description: 'Thirteen posts, written up a month after the fact.',
    date: '2019-08-02',
    tags: ['what:writing', 'where:europe/norway/svalbard'],
    collapsed: { count: 13 },
  },
};

type ProtoSlot = {
  card: keyof typeof CARDS;
  label?: string;
  seeMore?: boolean;
  variant: 'full' | 'brief';
  span: { small: number; large: number };
  side?: 'right';
  /** NOT in #131's schema. Only variant B sets it — that is the question. */
  rows?: number;
};

type Layout = { name: string; note: string; slots: ProtoSlot[] };

const LAYOUTS: Record<string, Layout> = {
  A: {
    name: 'Target arrangement, as #131 allows it',
    note:
      'Config order 1-2-3. Slot 2 is `side: right`, slots 1 and 3 flow the main track. No row spans, because the schema has none. Watch where slot 3 lands.',
    slots: [
      { card: 'puzzle', label: 'A Puzzle', seeMore: true, variant: 'brief', span: { small: 8, large: 8 } },
      { card: 'project', label: 'A Project', seeMore: true, variant: 'full', span: { small: 4, large: 4 }, side: 'right' },
      { card: 'post', label: 'A Post', seeMore: true, variant: 'brief', span: { small: 8, large: 8 } },
    ],
  },
  B: {
    name: 'Target arrangement, with a rows: key',
    note:
      'Identical config, except slot 2 declares `rows: 2`. This key does NOT exist in #131 — if this is the only layout that reads right, the schema gains it and the map re-opens.',
    slots: [
      { card: 'puzzle', label: 'A Puzzle', seeMore: true, variant: 'brief', span: { small: 8, large: 8 } },
      { card: 'project', label: 'A Project', seeMore: true, variant: 'full', span: { small: 4, large: 4 }, side: 'right', rows: 2 },
      { card: 'post', label: 'A Post', seeMore: true, variant: 'brief', span: { small: 8, large: 8 } },
    ],
  },
  C: {
    name: 'The arrangement gives: full-width third slot',
    note:
      'No row span, no hole. Slots 1 and 2 share row 1; slot 3 spans all 12 beneath them. The picture is still beside a brief card, but only one of them.',
    slots: [
      { card: 'puzzle', label: 'A Puzzle', seeMore: true, variant: 'brief', span: { small: 8, large: 8 } },
      { card: 'project', label: 'A Project', seeMore: true, variant: 'full', span: { small: 4, large: 4 }, side: 'right' },
      { card: 'post', label: 'A Post', seeMore: true, variant: 'brief', span: { small: 12, large: 12 } },
    ],
  },
  D: {
    name: 'Spans that do not sum to 12',
    note:
      "Deliberate arithmetic holes: 5 + 4 leaves 3 columns, 6 + 3 leaves 3. #131 ruled out `grid-auto-flow: dense`, so nothing backfills. Does that read as the author's arithmetic showing, or as a bug?",
    slots: [
      { card: 'puzzle', label: 'A Puzzle', variant: 'brief', span: { small: 5, large: 5 } },
      { card: 'project', label: 'A Project', variant: 'full', span: { small: 4, large: 4 }, side: 'right' },
      { card: 'post', label: 'A Post', variant: 'brief', span: { small: 6, large: 6 } },
      { card: 'story', label: 'A Story', variant: 'brief', span: { small: 3, large: 3 }, side: 'right' },
    ],
  },
  E: {
    name: "Today's home, unmodified",
    note:
      "The four real slots from home.lens.yaml with no `span:` declared — every slot defaults to 12 at every tier. The migration diff should be a no-op, and this is what that looks like.",
    slots: [
      { card: 'about', variant: 'full', span: { small: 12, large: 12 } },
      { card: 'project', label: 'A Project', seeMore: true, variant: 'full', span: { small: 12, large: 12 } },
      { card: 'puzzle', label: 'A Puzzle', seeMore: true, variant: 'full', span: { small: 12, large: 12 } },
      { card: 'post', label: 'A Post', seeMore: true, variant: 'full', span: { small: 12, large: 12 } },
    ],
  },
};

const KEYS = Object.keys(LAYOUTS);
---

<Base title="Home slot grid — prototype (#132)">
  <main class="proto">
    {/* Static output strips search params server-side, so the variant is
        chosen on the client: every layout is rendered and CSS shows one. */}
    <script is:inline>
      (() => {
        const p = new URLSearchParams(location.search);
        const el = document.documentElement;
        el.dataset.protoVariant = p.get('variant') || 'A';
        el.dataset.protoAlign = p.get('align') === 'stretch' ? 'stretch' : 'start';
        el.style.setProperty('--proto-width', (p.get('w') || '1100') === 'full' ? 'none' : `${p.get('w') || '1100'}px`);
      })();
    </script>

    {KEYS.map((key) => (
      <div class="proto-variant" data-key={key}>
        <header class="proto-head">
          <h1>Home slot grid — {key}. {LAYOUTS[key].name}</h1>
          <p class="proto-note">{LAYOUTS[key].note}</p>
          <p class="proto-tier">
            Active tier: <span class="tier-badge"></span> <span class="proto-vp"></span>
          </p>
        </header>

        <div class="proto-page">
          <div class="fp-slot-grid">
            {LAYOUTS[key].slots.map((slot) => (
              <section
                class:list={['fp-slot', slot.side === 'right' && 'fp-slot--rail', `fp-slot--${slot.variant}`]}
                style={`--slot-span-small:${slot.span.small};--slot-span-large:${slot.span.large};${slot.rows ? `--proto-rows:${slot.rows};` : ''}`}
              >
                <p class="proto-spec">
                  span {slot.span.small}/{slot.span.large}{slot.side ? ' · right' : ''} · {slot.variant}{slot.rows ? ` · rows ${slot.rows}` : ''}
                </p>
                {slot.label && <h2 class="fp-slot-label">{slot.label}</h2>}
                <ul class="proto-list">
                  <BrowseCard card={CARDS[slot.card]} />
                </ul>
                {slot.seeMore && <a class="fp-see-more" href="#">See more →</a>}
              </section>
            ))}
          </div>
        </div>
      </div>
    ))}

    <nav class="proto-bar" aria-label="Prototype controls">
      <a class="proto-arrow" data-step="-1" href="#" aria-label="Previous variant">←</a>
      <span class="proto-current"></span>
      <a class="proto-arrow" data-step="1" href="#" aria-label="Next variant">→</a>
      <span class="proto-sep"></span>
      <span class="proto-group">
        width
        {['960', '1100', '1200', '1400', 'full'].map((w) => (
          <a class="proto-chip" data-w={w} href="#">{w}</a>
        ))}
      </span>
      <span class="proto-sep"></span>
      <span class="proto-group">
        align
        {['start', 'stretch'].map((a) => (
          <a class="proto-chip" data-align={a} href="#">{a}</a>
        ))}
      </span>
    </nav>
  </main>

  <script is:inline define:vars={{ NAMES: Object.fromEntries(KEYS.map((k) => [k, LAYOUTS[k].name])) }}>
    // Throwaway: bar wiring, live viewport readout, arrow-key cycling.
    const KEYS = Object.keys(NAMES);
    const el = document.documentElement;
    const p = new URLSearchParams(location.search);
    const state = {
      variant: KEYS.includes(p.get('variant')) ? p.get('variant') : 'A',
      w: p.get('w') || '1100',
      align: p.get('align') === 'stretch' ? 'stretch' : 'start',
    };

    const paint = () => {
      el.dataset.protoVariant = state.variant;
      el.dataset.protoAlign = state.align;
      el.style.setProperty('--proto-width', state.w === 'full' ? 'none' : state.w + 'px');
      document.querySelector('.proto-current').textContent = state.variant + ' — ' + NAMES[state.variant];
      for (const c of document.querySelectorAll('[data-w]')) c.classList.toggle('is-on', c.dataset.w === state.w);
      for (const c of document.querySelectorAll('[data-align]')) c.classList.toggle('is-on', c.dataset.align === state.align);
      for (const v of document.querySelectorAll('.proto-vp')) {
        v.textContent = '· viewport ' + window.innerWidth + 'px · page width ' + (state.w === 'full' ? 'unconstrained' : state.w + 'px');
      }
      const q = new URLSearchParams(state);
      history.replaceState(null, '', '?' + q.toString());
    };

    const step = (n) => {
      state.variant = KEYS[(KEYS.indexOf(state.variant) + n + KEYS.length) % KEYS.length];
      paint();
    };

    document.querySelector('.proto-bar').addEventListener('click', (e) => {
      const a = e.target.closest('a');
      if (!a) return;
      e.preventDefault();
      if (a.dataset.step) step(Number(a.dataset.step));
      else if (a.dataset.w) { state.w = a.dataset.w; paint(); }
      else if (a.dataset.align) { state.align = a.dataset.align; paint(); }
    });

    document.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLElement && e.target.closest('input,textarea,[contenteditable]')) return;
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });

    window.addEventListener('resize', paint);
    paint();
  </script>

<style is:global>
  /* ---- the thing under test: #131's grid, written out verbatim ---- */

  .fp-slot-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--fp-slot-gap, var(--space-lg));
  }

  /* Mobile: every slot is full width and `side` is ignored. */
  .fp-slot {
    grid-column: span 12;
  }

  @media (min-width: 681px) {
    .fp-slot {
      grid-column: span var(--slot-span-small);
    }
    .fp-slot--rail {
      grid-column: span var(--slot-span-small) / -1;
    }
  }

  /* The small/large line — a literal by necessity (#131 premise correction). */
  @media (min-width: 1000px) {
    .fp-slot {
      grid-column: span var(--slot-span-large);
    }
    .fp-slot--rail {
      grid-column: span var(--slot-span-large) / -1;
    }
  }

  /* NOT in the schema — variant B only, and the question this page asks. */
  .fp-slot[style*='--proto-rows'] {
    grid-row: span var(--proto-rows);
  }

  /* ---- stand-in for #130's `brief` variant, which does not exist yet ---- */

  .fp-slot--brief .browse-card-thumb,
  .fp-slot--brief .browse-card-header-meta {
    display: none;
  }

  .fp-slot--brief .browse-card-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---- prototype chrome; none of this ships ---- */

  .proto {
    padding: var(--space-lg) var(--space-md) 6rem;
  }

  /* One layout on screen at a time; the choice is a data attribute on <html>. */
  .proto-variant {
    display: none;
  }

  html[data-proto-variant='A'] .proto-variant[data-key='A'],
  html[data-proto-variant='B'] .proto-variant[data-key='B'],
  html[data-proto-variant='C'] .proto-variant[data-key='C'],
  html[data-proto-variant='D'] .proto-variant[data-key='D'],
  html[data-proto-variant='E'] .proto-variant[data-key='E'] {
    display: block;
  }

  html[data-proto-align='start'] .fp-slot-grid {
    align-items: start;
  }

  html[data-proto-align='stretch'] .fp-slot-grid {
    align-items: stretch;
  }

  .proto-head {
    max-width: 60ch;
    margin: 0 auto var(--space-lg);
  }

  .proto-head h1 {
    font-size: 1.1rem;
    margin: 0 0 var(--space-xs);
  }

  .proto-note,
  .proto-tier {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-xs);
  }

  .tier-badge::after {
    content: 'mobile (<681px)';
    font-weight: 700;
    color: var(--color-text);
  }

  @media (min-width: 681px) {
    .tier-badge::after {
      content: 'small (681–999px)';
    }
  }

  @media (min-width: 1000px) {
    .tier-badge::after {
      content: 'large (≥1000px)';
    }
  }

  .proto-page {
    max-width: var(--proto-width, 1100px);
    margin: 0 auto;
  }

  .proto-spec {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin: 0 0 2px;
  }

  .proto-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* From FilterSlot.svelte's scoped styles — these move to global.css for real
     (#131 §9); copied here so the chrome is judged at the right weight. */
  .fp-slot-label {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 var(--space-xs);
  }

  .fp-see-more {
    display: inline-block;
    margin-top: var(--space-xs);
    font-size: 0.85rem;
  }

  .proto-bar {
    position: fixed;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
    justify-content: center;
    max-width: calc(100vw - 2 * var(--space-md));
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-selected-bg);
    color: var(--color-selected-fg);
    -webkit-text-stroke-color: var(--color-selected-bg);
    border: var(--border-width) solid var(--color-selected-bg);
    font-size: 0.8rem;
    z-index: 50;
  }

  .proto-bar a {
    color: var(--color-selected-fg);
    text-decoration: none;
  }

  .proto-arrow {
    padding: 0 var(--space-xs);
    font-size: 1rem;
  }

  .proto-sep {
    width: 1px;
    align-self: stretch;
    background: var(--color-selected-fg);
  }

  .proto-group {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .proto-chip {
    border: 1px solid var(--color-selected-fg);
    padding: 0 4px;
  }

  .proto-chip.is-on {
    background: var(--color-selected-fg);
    color: var(--color-selected-bg);
  }
</style>
