---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import {
  buildArticleJsonLd,
  buildSiteJsonLd,
  buildSocialMeta,
  resolveCanonical,
  resolveOgImage,
  SITE_NAME,
  SITE_URL,
} from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Resolved header-image URL (emitted asset path or remote URL). Falls back to the site default — see resolveOgImage. */
  image?: string;
  /** `article` for a dated card; `website` for lenses and the front page. */
  ogType?: 'article' | 'website';
  /** Publish date of a dated card — drives article:published_time / datePublished. */
  date?: Date;
}

const { title = SITE_NAME, description, image, ogType = 'website', date } = Astro.props as Props;
const pageTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;

// Thin applier: every decision below is made by pure functions in src/lib/seo.ts.
// Astro.site is configured in astro.config.mjs, so SITE_URL is only a
// type-narrowing fallback — but it must be the same one /sitemap.xml uses, or a
// page's canonical and its sitemap <loc> could disagree.
const site = Astro.site?.href ?? SITE_URL;
const seoPage = {
  title,
  description,
  canonical: resolveCanonical(Astro.url.pathname, site),
  image: resolveOgImage(image, site),
  type: ogType,
  publishedTime: date?.toISOString(),
};
const socialMeta = buildSocialMeta(seoPage);
// Person/WebSite identity belongs at the root only (issue #71) — repeating it on
// every card would assert the site's identity 293 times over. A dated card
// carries an Article instead.
const isRoot = resolveCanonical('/', site) === seoPage.canonical;
const jsonLd = [
  ...(isRoot ? [buildSiteJsonLd(site)] : []),
  ...(seoPage.type === 'article' && seoPage.publishedTime ? [buildArticleJsonLd(seoPage)] : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={seoPage.canonical} />
    {socialMeta.map(tag => (
      tag.property
        ? <meta property={tag.property} content={tag.content} />
        : <meta name={tag.name} content={tag.content} />
    ))}
    {jsonLd.map(doc => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(doc)} />
    ))}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;400;700&family=Saira+Stencil&display=swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="pdyxs.wtf" href="/rss.xml" />
    <script is:inline>
      (function () {
        var pref = localStorage.getItem('theme');
        var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var resolved = (pref === 'light') ? 'light' : (pref === 'dark') ? 'dark' : (systemDark ? 'dark' : 'light');
        document.documentElement.dataset.theme = resolved;

        if (!pref || pref === 'system') {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
            if (!localStorage.getItem('theme') || localStorage.getItem('theme') === 'system') {
              document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
            }
          });
        }
      })();
    </script>
    <script is:inline>
      // Anti-FOUC for filtered cold loads. Lens pages are statically prerendered
      // with the FULL card set (the build has no query string), so a refresh on
      // a filtered URL would paint every card before the client reads the filter
      // and reduces the set. Set a pre-paint flag when the URL carries filters;
      // CSS hides the browse results until BrowseLensBrowser clears it once the
      // filtered view is in the DOM (see lensFiltersSynced).
      //
      // A second trigger, same guard (issue #81): a RANKED lens's order also
      // changes on hydration, because the chain's unseen-before-seen rung
      // (src/lib/ranking.ts) can only be evaluated against localStorage. The
      // server can't know that state, so it renders the build-time rungs and
      // the browser re-sorts — which, unguarded, is a whole grid visibly
      // reshuffling a beat after it paints, and reads as a bug rather than as
      // "cards you've read moved down".
      //
      // Deliberately conditional on there BEING a read history: a first-time
      // visitor's hydration re-sort is a no-op, so they get an instant paint
      // and pay nothing. Scoped to /lens/ paths — a card page has no results
      // grid to hold, and `/` (the home lens) has slots, not a grid.
      (function () {
        var s = window.location.search;
        var active = false;
        if (s) {
          new URLSearchParams(s).forEach(function (_value, key) {
            if (key === 'filter' || key.indexOf('filter.') === 0) {
              active = true;
            }
          });
        }
        if (!active && window.location.pathname.indexOf('/lens/') === 0) {
          try {
            for (var i = 0; i < localStorage.length; i++) {
              if ((localStorage.key(i) || '').indexOf('pdyxs:view-state:') === 0) {
                active = true;
                break;
              }
            }
          } catch (e) { /* storage blocked — nothing to re-rank on */ }
        }
        if (!active) return;
        document.documentElement.setAttribute('data-filters-pending', '');
        // Safety net: if the filter island never hydrates (script error, etc.),
        // reveal the full set rather than hiding results forever.
        setTimeout(function () {
          document.documentElement.removeAttribute('data-filters-pending');
        }, 3000);
      })();
    </script>
  </head>
  <body>
    <div class="site-wrapper">
      <slot />
      <footer class="site-footer">
        <div class="footer-toggle"><ThemeToggle /></div>
        <span><a href="/">pdyxs.wtf</a> · <a href="/rss.xml">RSS</a></span>
      </footer>
    </div>
  </body>
</html>
