---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'pdyxs.wtf', description } = Astro.props;
const pageTitle = title === 'pdyxs.wtf' ? title : `${title} — pdyxs.wtf`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;400;700&family=Saira+Stencil&display=swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="pdyxs.wtf" href="/rss.xml" />
    <script is:inline>
      (function () {
        var pref = localStorage.getItem('theme');
        var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var resolved = (pref === 'light') ? 'light' : (pref === 'dark') ? 'dark' : (systemDark ? 'dark' : 'light');
        document.documentElement.dataset.theme = resolved;

        if (!pref || pref === 'system') {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
            if (!localStorage.getItem('theme') || localStorage.getItem('theme') === 'system') {
              document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
            }
          });
        }
      })();
    </script>
    <script is:inline>
      // Anti-FOUC for filtered cold loads. Lens pages are statically prerendered
      // with the FULL card set (the build has no query string), so a refresh on
      // a filtered URL would paint every card before the client reads the filter
      // and reduces the set. Set a pre-paint flag when the URL carries filters;
      // CSS hides the browse results until BrowseLensBrowser clears it once the
      // filtered view is in the DOM (see lensFiltersSynced).
      (function () {
        var s = window.location.search;
        if (!s) return;
        var active = false;
        new URLSearchParams(s).forEach(function (_value, key) {
          if (key === 'filter' || key === 'when.from' || key === 'when.to' || key.indexOf('filter.') === 0) {
            active = true;
          }
        });
        if (!active) return;
        document.documentElement.setAttribute('data-filters-pending', '');
        // Safety net: if the filter island never hydrates (script error, etc.),
        // reveal the full set rather than hiding results forever.
        setTimeout(function () {
          document.documentElement.removeAttribute('data-filters-pending');
        }, 3000);
      })();
    </script>
  </head>
  <body>
    <div class="site-wrapper">
      <slot />
      <footer class="site-footer">
        <div class="footer-toggle"><ThemeToggle /></div>
        <span><a href="/">pdyxs.wtf</a> · <a href="/rss.xml">RSS</a></span>
      </footer>
    </div>
  </body>
</html>
