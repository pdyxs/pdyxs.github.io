---
import Base from '../layouts/Base.astro';
// Throwaway: Pace experiments (delta over base setup). B&W.
---
<Base title="Pace experiments">
  <main style="max-width:44rem;margin:2rem auto;padding:0 1rem;font-family:system-ui;color:#000">
    <h1>Pace: experiments (prototype)</h1>
    <p>An experiment is a delta over the base setup. Today's schedule = base + every active delta. Use the day controls to move "today" and watch experiments start, progress and end. At the end choose Keep (delta merges into base) or Discard (archived, base untouched). Scheduling an experiment that overlaps another on the same intervention is blocked.</p>
    <div class="tabs"><button data-tab="today" class="on">Today + base</button><button data-tab="exp">Experiments</button></div>
    <div id="ph" class="ph"></div>
  </main>
  <style is:global>
    .tabs{display:flex;gap:6px;margin-bottom:8px}
    .tabs button,.ph button{border:1.5px solid #000;background:#fff;font:inherit;font-size:14px;padding:3px 9px;cursor:pointer;color:#000}
    .tabs button.on,.ph button.on{background:#000;color:#fff}
    .ph{width:360px;border:2px solid #000;background:#fff;padding:12px;font-size:16px;position:relative;min-height:560px}
    .ph input,.ph select{font:inherit;border:1.5px solid #000;padding:4px;box-sizing:border-box;background:#fff;color:#000}
    .clock{display:flex;align-items:center;gap:6px;border-bottom:2px solid #000;padding-bottom:8px;margin-bottom:8px;font-size:14px}
    .clock b{flex:1}
    .hd{font-weight:700;font-size:13px;letter-spacing:.05em;text-transform:uppercase;margin:14px 0 0;border-bottom:2px solid #000;padding:4px 0}
    .row{padding:7px 0;border-bottom:1px solid #000;display:flex;gap:8px;align-items:center}
    .row .n{flex:1} .row small{display:block;font-size:13px}
    .tag{font-size:12px;border:1.5px solid #000;padding:0 5px;white-space:nowrap}
    .bar{height:10px;border:1.5px solid #000;margin:6px 0}.bar i{display:block;height:100%;background:#000}
    .card{border:1.5px solid #000;padding:8px;margin-top:10px}
    .card.dim{border-style:dashed}
    .btns{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
    .err{border:2px solid #000;padding:6px;margin-top:8px;font-size:14px;font-weight:700}
    .lab{display:block;font-size:12px;font-weight:700;margin:10px 0 3px;text-transform:uppercase}
    .del{font-size:13px;padding:2px 0;border-bottom:1px dotted #000}
    .sheet{position:absolute;inset:0;background:#fff;padding:12px;overflow:auto}
    del{text-decoration:line-through}
  </style>
  <script is:inline>
    const DAY = 86400000;
    const T0 = new Date('2026-10-23T00:00:00').getTime();
    const fmt = (d) => new Date(T0 + d * DAY).toLocaleDateString('en-AU', { weekday: 'short', day: 'numeric', month: 'short' });
    let today = 0, tab = 'today', sheet = null, err = '', nid = 10;
    let periods = [{ id: 'm', name: 'Morning' }, { id: 'a', name: 'Arvo' }, { id: 'v', name: 'Evening' }];
    let base = [
      { id: 'pea', name: 'PEA-LUT', n: 1, unit: 'pills', p: 'm' },
      { id: 'pills', name: 'Morning pills', n: 3, unit: 'pills', p: 'm' },
      { id: 'iva', name: 'Ivabradine', n: 5, unit: 'mg', p: 'm' },
      { id: 'mag', name: 'Magnesium', n: 200, unit: 'mg', p: 'v' },
    ];
    // delta: {k:'dose',i,n,unit} | {k:'add',i(name),n,unit,p} | {k:'remove',i}
    let exps = [
      { id: 1, name: 'Ivabradine up to 7.5 mg', start: 0, days: 14, deltas: [{ k: 'dose', i: 'iva', n: 7.5, unit: 'mg' }], fate: null },
      { id: 2, name: 'Try magnesium glycinate', start: 3, days: 10, deltas: [{ k: 'add', i: 'Mg glycinate', n: 1, unit: 'pills', p: 'v' }, { k: 'remove', i: 'mag' }], fate: null },
    ];
    const end = (e) => e.start + e.days;
    const status = (e) => e.fate ? e.fate : today < e.start ? 'scheduled' : today < end(e) ? 'active' : 'ended';
    // ended-but-undecided keeps applying: logs stay honest until you decide
    const applying = (e) => { const s = status(e); return s === 'active' || s === 'ended'; };
    const name = (id) => base.find((b) => b.id === id)?.name || id;
    const dose = (n, u) => n + ' ' + u;
    function schedule() {
      let rows = base.map((b) => ({ ...b, tag: null, was: null }));
      for (const e of exps.filter(applying)) for (const d of e.deltas) {
        if (d.k === 'remove') rows = rows.filter((r) => r.id !== d.i);
        if (d.k === 'dose') rows.forEach((r) => { if (r.id === d.i) { r.was = dose(r.n, r.unit); r.n = d.n; r.unit = d.unit; r.tag = e.name; } });
        if (d.k === 'add') rows.push({ id: 'x' + e.id + d.i, name: d.i, n: d.n, unit: d.unit, p: d.p, tag: e.name, was: null, added: true });
      }
      return rows;
    }
    const touches = (e) => e.deltas.map((d) => d.i);
    function clash(cand, skipId) {
      for (const o of exps) {
        if (o.id === skipId || o.fate) continue;
        if (cand.start < end(o) && o.start < end(cand)) {
          const shared = touches(cand).find((x) => touches(o).includes(x));
          if (shared) return `Blocked: "${o.name}" (${fmt(o.start)}–${fmt(end(o) - 1)}) also changes ${name(shared)}.`;
        }
      }
      return '';
    }
    const ph = document.getElementById('ph');
    function clock() {
      return `<div class="clock"><b>Today: ${fmt(today)}</b><button data-d="-1">−1d</button><button data-d="1">+1d</button><button data-d="7">+7d</button></div>`;
    }
    function viewToday() {
      const rows = schedule();
      let h = '<div class="hd" style="margin-top:0">Today\'s schedule</div>';
      for (const p of periods) {
        const rs = rows.filter((r) => r.p === p.id);
        if (!rs.length) continue;
        h += `<div style="font-size:13px;margin-top:8px;font-weight:700">${p.name}</div>`;
        h += rs.map((r) => `<div class="row"><span class="n">${r.name}<small>${r.was ? '<del>' + r.was + '</del> ' : ''}${dose(r.n, r.unit)}</small></span>${r.tag ? `<span class="tag">⚗ ${r.tag}</span>` : ''}</div>`).join('');
      }
      h += '<div class="hd">Base setup (untouched by running experiments)</div>';
      h += base.map((b) => `<div class="row"><span class="n">${b.name}<small>${dose(b.n, b.unit)} · ${periods.find((p) => p.id === b.p).name}</small></span></div>`).join('');
      return h;
    }
    function card(e) {
      const s = status(e), pct = Math.max(0, Math.min(1, (today - e.start) / e.days));
      const dl = e.deltas.map((d) => d.k === 'dose' ? `<div class="del">${name(d.i)} → ${dose(d.n, d.unit)}</div>` : d.k === 'add' ? `<div class="del">+ ${d.i} ${dose(d.n, d.unit)} (${periods.find((p) => p.id === d.p).name})</div>` : `<div class="del">− remove ${name(d.i)}</div>`).join('');
      let h = `<div class="card ${s === 'kept' || s === 'discarded' ? 'dim' : ''}"><div style="display:flex;justify-content:space-between"><b>${e.name}</b><span class="tag">${s === 'ended' ? 'ended: decide' : s}</span></div>`;
      h += `<div style="font-size:13px">${fmt(e.start)} → ${fmt(end(e) - 1)} · ${e.days} days</div>${dl}`;
      if (s === 'active') h += `<div class="bar"><i style="width:${pct * 100}%"></i></div><div style="font-size:13px">Day ${today - e.start + 1} of ${e.days}</div>`;
      if (s === 'ended') h += `<div class="bar"><i style="width:100%"></i></div><div style="font-size:13px">Still applying until you decide.</div><div class="btns"><button data-keep="${e.id}">Keep</button><button data-disc="${e.id}">Discard</button></div>`;
      if (s === 'scheduled') h += `<div class="btns"><button data-edit="${e.id}">Edit</button><button data-cancel="${e.id}">Cancel</button></div>`;
      if (s === 'kept') h += '<div style="font-size:13px">Merged into base.</div>';
      if (s === 'discarded') h += '<div style="font-size:13px">Archived, nothing kept.</div>';
      return h + '</div>';
    }
    function viewExp() {
      const order = { ended: 0, active: 1, scheduled: 2, kept: 3, discarded: 3 };
      const list = [...exps].sort((a, b) => order[status(a)] - order[status(b)] || a.start - b.start);
      return `<button data-new>+ experiment</button>${err ? `<div class="err">${err}</div>` : ''}` + list.map(card).join('');
    }
    function sheetHtml() {
      const e = sheet;
      const opts = (sel) => base.map((b) => `<option value="${b.id}" ${sel === b.id ? 'selected' : ''}>${b.name}</option>`).join('');
      let h = `<div class="sheet"><b>${e.isNew ? 'New experiment' : 'Edit experiment'}</b>
        <span class="lab">Name</span><input id="e-name" value="${e.name}" style="width:100%">
        <span class="lab">Start (days from today)</span><input id="e-start" type="number" value="${e.start}" style="width:80px"> <span style="font-size:13px">${fmt(e.start)}</span>
        <span class="lab">Duration (days)</span><input id="e-days" type="number" value="${e.days}" style="width:80px"> <span style="font-size:13px">ends ${fmt(e.start + e.days - 1)}</span>
        <span class="lab">Changes</span>`;
      e.deltas.forEach((d, k) => {
        h += `<div class="card" style="margin-top:6px">`;
        if (d.k === 'dose') h += `Change dose of <select data-di="${k}">${opts(d.i)}</select> to <input data-dn="${k}" value="${d.n}" style="width:60px"> <input data-du="${k}" value="${d.unit}" style="width:60px">`;
        if (d.k === 'remove') h += `Remove <select data-di="${k}">${opts(d.i)}</select>`;
        if (d.k === 'add') h += `Add <input data-dname="${k}" value="${d.i}" style="width:110px"> <input data-dn="${k}" value="${d.n}" style="width:50px"> <input data-du="${k}" value="${d.unit}" style="width:60px"> in <select data-dp="${k}">${periods.map((p) => `<option value="${p.id}" ${d.p === p.id ? 'selected' : ''}>${p.name}</option>`).join('')}</select>`;
        h += ` <button data-rm="${k}">✕</button></div>`;
      });
      h += `<div class="btns"><button data-ad="dose">+ dose change</button><button data-ad="add">+ add</button><button data-ad="remove">+ remove</button></div>`;
      if (err) h += `<div class="err">${err}</div>`;
      h += `<div class="btns" style="margin-top:16px"><button id="save">Schedule</button><button id="cancel">Cancel</button></div></div>`;
      return h;
    }
    function render() {
      ph.innerHTML = clock() + (tab === 'today' ? viewToday() : viewExp()) + (sheet ? sheetHtml() : '');
      wire();
    }
    function readSheet() {
      const g = (s) => ph.querySelector(s);
      if (!g('#e-name')) return;
      sheet.name = g('#e-name').value; sheet.start = +g('#e-start').value || 0; sheet.days = Math.max(1, +g('#e-days').value || 1);
      sheet.deltas.forEach((d, k) => {
        const v = (s) => g(`[${s}="${k}"]`)?.value;
        if (v('data-di') !== undefined) d.i = v('data-di');
        if (v('data-dname') !== undefined) d.i = v('data-dname');
        if (v('data-dn') !== undefined) d.n = parseFloat(v('data-dn')) || 0;
        if (v('data-du') !== undefined) d.unit = v('data-du');
        if (v('data-dp') !== undefined) d.p = v('data-dp');
      });
    }
    function wire() {
      const $ = (s) => ph.querySelectorAll(s);
      $('[data-d]').forEach((b) => b.onclick = () => { today += +b.dataset.d; err = ''; render(); });
      $('[data-new]').forEach((b) => b.onclick = () => { err = ''; const last = Math.max(today, ...exps.filter((e) => !e.fate).map(end)); sheet = { isNew: true, id: nid++, name: '', start: last, days: 14, deltas: [{ k: 'dose', i: base[0].id, n: 1, unit: base[0].unit }], fate: null }; render(); });
      $('[data-edit]').forEach((b) => b.onclick = () => { err = ''; sheet = JSON.parse(JSON.stringify(exps.find((e) => e.id == b.dataset.edit))); render(); });
      $('[data-cancel]').forEach((b) => b.onclick = () => { exps = exps.filter((e) => e.id != b.dataset.cancel); render(); });
      $('[data-keep]').forEach((b) => b.onclick = () => {
        const e = exps.find((x) => x.id == b.dataset.keep);
        for (const d of e.deltas) {
          if (d.k === 'remove') base = base.filter((r) => r.id !== d.i);
          if (d.k === 'dose') base.forEach((r) => { if (r.id === d.i) { r.n = d.n; r.unit = d.unit; } });
          if (d.k === 'add') base.push({ id: 'b' + nid++, name: d.i, n: d.n, unit: d.unit, p: d.p });
        }
        e.fate = 'kept'; render();
      });
      $('[data-disc]').forEach((b) => b.onclick = () => { exps.find((x) => x.id == b.dataset.disc).fate = 'discarded'; render(); });
      document.querySelectorAll('.tabs button').forEach((b) => b.onclick = () => { tab = b.dataset.tab; err = ''; document.querySelectorAll('.tabs button').forEach((x) => x.classList.toggle('on', x === b)); render(); });
      if (!sheet) return;
      $('[data-ad]').forEach((b) => b.onclick = () => { readSheet(); const k = b.dataset.ad; sheet.deltas.push(k === 'dose' ? { k, i: base[0].id, n: 1, unit: base[0].unit } : k === 'remove' ? { k, i: base[0].id } : { k, i: 'New thing', n: 1, unit: 'pills', p: periods[0].id }); render(); });
      $('[data-rm]').forEach((b) => b.onclick = () => { readSheet(); sheet.deltas.splice(+b.dataset.rm, 1); render(); });
      $('[data-di]').forEach((s) => s.onchange = () => { readSheet(); const d = sheet.deltas[+s.dataset.di]; if (d.k === 'dose') { const b = base.find((x) => x.id === d.i); d.unit = b.unit; } render(); });
      $('#e-start,#e-days').forEach((i) => i.onchange = () => { readSheet(); render(); });
      document.getElementById('cancel').onclick = () => { sheet = null; err = ''; render(); };
      document.getElementById('save').onclick = () => {
        readSheet();
        if (!sheet.name.trim()) { err = 'Give it a name.'; return render(); }
        if (!sheet.deltas.length) { err = 'Add at least one change.'; return render(); }
        const c = clash(sheet, sheet.id);
        if (c) { err = c; return render(); }
        const { isNew, ...e } = sheet;
        const k = exps.findIndex((x) => x.id === e.id);
        k >= 0 ? exps[k] = e : exps.push(e);
        sheet = null; err = ''; tab = 'exp'; document.querySelectorAll('.tabs button').forEach((x) => x.classList.toggle('on', x.dataset.tab === 'exp')); render();
      };
    }
    render();
  </script>
</Base>
