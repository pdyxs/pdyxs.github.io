---
// The "home" lens body: the sole acceptsFilters:false lens in the registry
// (src/lib/lens-registry.ts). Renders the same day-seeded pinned/filter slots
// as the old front page, without the filter bar. Chrome (header + body-wrapper
// shell) is owned by LensStackCard.astro — this component renders body content
// only.
//
// Slot resolution happens client-side (HomeLensSlots.svelte) because it reads
// per-viewer view-state from localStorage, which isn't available at
// server-render time.
import { getAllCards } from '../../lib/cards';
import { FRONTPAGE_CONFIG } from '../../content/frontpage';
import HomeLensSlots from './HomeLensSlots.svelte';

const allCards = await getAllCards();
const serialisedCards = allCards.map(card => ({
  ...card,
  date: card.date?.toISOString() ?? null,
}));
---
<HomeLensSlots client:load config={FRONTPAGE_CONFIG} cards={serialisedCards} />
