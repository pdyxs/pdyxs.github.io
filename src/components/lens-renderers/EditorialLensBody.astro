---
// Thin Astro shim, only here so EditorialLensBrowser.svelte can be a static
// import (client:load requires a statically analyzable component reference —
// a dynamically-resolved variable breaks Astro's hydration bundling). The
// lazy-load boundary is one level up: lens-components.ts dynamically imports
// *this file*, not EditorialLensBrowser.svelte directly. Mirrors
// BrowseLensBody.astro's shape, including its slice-8 prop list.
import EditorialLensBrowser from './EditorialLensBrowser.svelte';

interface Props {
  config?: Record<string, unknown>;
}

const { config } = Astro.props;
---
<EditorialLensBrowser client:load {config} />
