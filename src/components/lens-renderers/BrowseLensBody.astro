---
// Thin Astro shim, only here so BrowseLensBrowser.svelte can be a static
// import (client:load requires a statically analyzable component reference —
// a dynamically-resolved variable breaks Astro's hydration bundling). The
// lazy-load boundary is one level up: lens-components.ts dynamically imports
// *this file*, not BrowseLensBrowser.svelte directly.
//
// `config` is the whole of it since slice 8 of docs/plans/shared-card-pool.md:
// the cards, their labels and the card-backed value set are byte-identical on
// every lens, so the island fetches them from /cards.json instead.
import BrowseLensBrowser from '@components/lens-renderers/BrowseLensBrowser.svelte';

interface Props {
  config?: Record<string, unknown>;
}

const { config } = Astro.props;
---
<BrowseLensBrowser client:load {config} />
