---
// Dev-only content-audit dashboard (issue #72) — the thin renderer around the
// pure auditCards() decision in src/lib/audit.ts. All of the logic lives there;
// this file only gathers the raw material and prints the result.
//
// Plain Astro, no island: the audit is a static server-rendered worklist with
// no interaction beyond `card:` links, which CardStack's delegated
// onDocumentClick already handles. (Contrast EditorialLensBody.astro, which
// needs a Svelte shim because it participates in the live lensFilterStore.)
//
// It deliberately does NOT use the `cards` prop LensStackCard passes every lens
// body. That pool is listing-filtered and folder-collapsed — exactly the cards
// most in need of auditing (unlisted drafts, individual series members like the
// arctic story chapters) are missing from it, and it carries no bodies. The
// audit reads the raw collection instead, so its counts cover everything.
import { getCollection } from 'astro:content';
import { makeFileReader, resolveFolderCascade } from '../../lib/folder-config';
import {
  getAllCards,
  inertDerivationControls,
  resolveCardDescription,
  resolveCardTitle,
} from '../../lib/cards';
import { generatorFrontmatterKeys } from '../../lib/filter-generators';
import { localAssetFilenames } from '../../lib/images';
import { serialiseBrowseCards } from '../../lib/browse-card';
import { auditCards, auditedCardCount, type AuditCard } from '../../lib/audit';
import { ORPHANED_OLD_URLS } from '../../data/redirects.generated';
import type { BrowseCardData } from '../../lib/browse-helpers';
import type { TagDisplay } from '../../lib/tag-display';
import BrowseCard from '../BrowseCard.svelte';

interface Props {
  cards?: unknown[];
  tagDisplay?: Record<string, TagDisplay>;
  config?: Record<string, unknown>;
}

const { tagDisplay = {} } = Astro.props as Props;

const entries = await getCollection('content');
const reader = makeFileReader();
const frontmatterKeys = generatorFrontmatterKeys();

// uid → the old Jekyll URLs it orphaned. One card can own several (a project
// had both a /what/projects/ and a collection permalink), so this is a
// multimap, not a lookup.
const orphanedByUid = new Map<string, string[]>();
for (const { uid, from } of ORPHANED_OLD_URLS) {
  const list = orphanedByUid.get(uid);
  if (list) list.push(from);
  else orphanedByUid.set(uid, [from]);
}

const auditInput: AuditCard[] = await Promise.all(
  entries.map(async e => {
    const cascade = await resolveFolderCascade(e.id, reader, frontmatterKeys);
    return {
      uid: e.id,
      title: resolveCardTitle(e.data),
      // The description *before* body-excerpt fallback — resolveDescription is
      // what the audit applies, so handing it an already-excerpted value would
      // make the "no description" finding structurally unreachable.
      description: resolveCardDescription(e.data, cascade.cardDescriptionParts),
      date: e.data.date,
      // Frontmatter tags only: path-derived, cascade and generated tags are all
      // excluded so "declares nothing of its own" stays decidable.
      authoredTags: e.data.tags,
      image: e.data.image,
      images: e.data.images,
      body: e.body,
      inspected: e.data.inspected,
      localAssets: localAssetFilenames(e.id),
      orphanedOldUrls: orphanedByUid.get(e.id),
      // Needs the same cascade + generator run resolveCard() does, which is why
      // the cascade above is resolved WITH the generator-read field names.
      inertDerivationControls: inertDerivationControls(e.id, e.data, cascade, frontmatterKeys),
    } satisfies AuditCard;
  }),
);

const findings = auditCards(auditInput);
const flaggedCards = auditedCardCount(findings);
const totalRefs = findings.reduce((sum, f) => sum + f.refCount, 0);
// auditCards() returns every finding type, including cleared ones, because the
// count is its deliverable. The dashboard is a worklist, so a cleared section is
// noise here — drop it and let the summary line carry "done".
const openFindings = findings.filter(f => f.cardCount > 0);

// The read-through worklist is the one finding you work by *looking* at the
// card, so it renders the same BrowseCard preview the browse-family lenses
// show — the point is to see what the preview looks like before ticking
// `inspected`. Every other finding stays a compact one-line list.
//
// BrowseCard is server-rendered with no client directive: its only
// interaction is the `data-push-card` anchor, which CardStack's delegated
// document listener already handles.
const PREVIEW_FINDING = 'not-inspected';
const previewUids = new Set(
  findings.find(f => f.type === PREVIEW_FINDING)?.cards.map(c => c.uid) ?? [],
);

// Resolved cards, not the raw entries above: the preview must match what the
// browse lenses would actually render (resolved title, description, merged
// tags). Thumbnails are generated only for the cards being previewed — the
// audit pool is the whole content set, and getImage() over all of it would
// cost far more than this dashboard is worth.
const previewCards = new Map<string, BrowseCardData>(
  (
    await serialiseBrowseCards(
      (await getAllCards()).filter(card => previewUids.has(card.uid)),
    )
  ).map(card => [card.uid, card] as const),
);
---

<div class="audit" aria-label="Content audit findings">
  <p class="audit-summary">
    <b>{flaggedCards}</b> of <b>{auditInput.length}</b> cards have at least one finding.
    Dev-only worklist — every count below should fall to zero as content work lands.
  </p>

  {openFindings.length === 0 && (
    <p class="audit-clear">Nothing to do — every finding is clear.</p>
  )}

  {openFindings.map(finding => (
    <section class="audit-finding">
      <h2 class="audit-finding-heading">
        {finding.label}
        <span class="audit-count">
          {finding.cardCount} {finding.cardCount === 1 ? 'card' : 'cards'}
          {finding.refCount > 0 && ` / ${finding.refCount} ${finding.refCount === 1 ? 'ref' : 'refs'}`}
        </span>
      </h2>
      <p class="audit-hint">{finding.hint}</p>
      {finding.type === PREVIEW_FINDING ? (
        <div class="audit-previews">
          {finding.cards.map(hit => {
            const card = previewCards.get(hit.uid);
            return (
              <div class="audit-preview">
                {/* BrowseCard renders its own <li>, so it needs a list parent to
                    be valid HTML — `display: contents` keeps that wrapper out of
                    the layout so the card and its path stack as siblings. */}
                <ul class="audit-preview-card">
                  {card
                    ? <BrowseCard {card} {tagDisplay} />
                    : (
                      <li class="audit-item">
                        <a class="audit-item-link" href={`card:${hit.uid}`}>{hit.title}</a>
                      </li>
                    )}
                </ul>
                {/* The uid IS the content path: src/content/<uid>/index.md. */}
                <code class="audit-preview-path">{hit.uid}</code>
              </div>
            );
          })}
        </div>
      ) : (
      <ul class="audit-list">
        {finding.cards.map(hit => (
          <li class="audit-item">
            <a class="audit-item-link" href={`card:${hit.uid}`}>{hit.title}</a>
            <code class="audit-item-uid">{hit.uid}</code>
            {hit.refs.length > 0 && (
              <ul class="audit-refs">
                {[...new Set(hit.refs)].map(ref => <li class="audit-ref"><code>{ref}</code></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
      )}
    </section>
  ))}

  <p class="audit-footer">{totalRefs} offending references in total.</p>
</div>

<style>
  .audit {
    padding: var(--space-md) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .audit-summary,
  .audit-footer {
    margin: 0;
    font-family: var(--font-heading);
  }

  .audit-footer {
    border-top: 1px solid var(--color-border-light);
    padding-top: var(--space-md);
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .audit-finding-heading {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    margin: 0 0 var(--space-xs) 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .audit-count {
    color: var(--color-text-muted);
    font-weight: normal;
    font-size: 0.85em;
    white-space: nowrap;
  }

  .audit-hint {
    margin: 0 0 var(--space-sm) 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .audit-clear {
    margin: 0;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .audit-list,
  .audit-refs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Same grid as BrowseResults' .fp-browse-list — the previews are meant to
     read exactly as they do on a browse lens, at the same tile width. */
  .audit-previews {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  /* The grid cell: card on top, its content path underneath. Stretching the
     cell to full height keeps the paths off the card bottoms in a row of
     uneven-height previews. */
  .audit-preview {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .audit-preview-card {
    display: contents;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .audit-preview-path {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    word-break: break-all;
    /* Pushed to the bottom of the cell so paths line up across a row. */
    margin-top: auto;
  }

  .audit-item {
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--color-border-light);
  }

  .audit-item-link {
    font-weight: 600;
  }

  .audit-item-uid,
  .audit-ref code {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    word-break: break-all;
  }

  .audit-item-uid {
    margin-inline-start: var(--space-sm);
  }

  .audit-refs {
    margin-top: var(--space-xs);
    /* Long dead-host URLs must scroll inside the row, never widen the card. */
    overflow-x: auto;
  }

  .audit-ref {
    padding-inline-start: var(--space-md);
  }
</style>
