---
// Thin Astro shim, only here so HomeLensSlots.svelte can be a static import
// (client:load requires a statically analyzable component reference — a
// dynamically-resolved variable breaks Astro's hydration bundling). The
// lazy-load boundary is one level up: lens-components.ts dynamically imports
// *this file*, not HomeLensSlots.svelte directly.
//
// `config` is the whole of it since slice 8 of docs/plans/shared-card-pool.md.
// The slot LAYOUT is this config and renders server-side from it alone; the
// cards that fill the slots come from /cards.json (issue #133's placeholder
// interiors are what stand in until they land).
import HomeLensSlots from '@components/lens-renderers/HomeLensSlots.svelte';
import type { FrontPageConfig } from '@browse/home/frontpage';

interface Props {
  config: FrontPageConfig;
}

const { config } = Astro.props as Props;
---
<HomeLensSlots client:load {config} />
