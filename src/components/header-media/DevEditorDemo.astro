---
// Throwaway renderer for the dev-editors demo (deleted with the demo editor).
// A renderer reads the envelope's `.data`; the card's index.json sits beside
// its index.md, so it is found by the card's uid.
import type { HeaderMediaProps } from '@render/header-media';

const envelopes = import.meta.glob('/src/content/**/index.json', { eager: true, import: 'default' }) as Record<
  string,
  { data?: { text?: string; count?: number } }
>;

const { entryId } = Astro.props as HeaderMediaProps;
const data = envelopes[`/src/content/${entryId}/index.json`]?.data;
---
<p class="dev-editor-demo">
  <span class="dev-editor-demo-text">{data?.text}</span>
  <span class="dev-editor-demo-count">{data?.count}</span>
</p>
