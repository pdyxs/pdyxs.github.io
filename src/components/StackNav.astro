---
// StackNav: card stack navigation logic.
// Include this component on any page that hosts a #card-stack element.
// On index.astro (has #homepage): toggles between panel links and stack.
// On full-page card routes (no #homepage): closing the last card goes to /.
---

<script>
  const homepage = document.getElementById('homepage');
  const cardStack = document.getElementById('card-stack')!;

  type VTResult = { finished: Promise<void> };
  const startVT = ((document as any).startViewTransition?.bind(document)) as ((cb: () => void) => VTResult) | undefined;

  function setVTName(el: Element, name: string) {
    (el as HTMLElement).style.setProperty('view-transition-name', name);
  }
  function clearVTName(el: Element) {
    (el as HTMLElement).style.removeProperty('view-transition-name');
  };

  function showStack() {
    if (homepage) homepage.hidden = true;
    cardStack.hidden = false;
  }

  function showHomepage() {
    cardStack.replaceChildren();
    cardStack.hidden = true;
    if (homepage) {
      homepage.hidden = false;
    } else {
      window.location.href = '/';
    }
  }

  function collapseCard(card: Element) {
    card.classList.add('stack-card--collapsed');
    card.classList.remove('stack-card--active');
    card.querySelector<HTMLElement>('.body-wrapper')?.classList.remove('open');
  }

  function expandCard(card: Element) {
    card.classList.remove('stack-card--collapsed');
    card.classList.add('stack-card--active');
    card.querySelector<HTMLElement>('.body-wrapper')?.classList.add('open');
  }

  async function fetchCard(url: string): Promise<Element | null> {
    const res = await fetch(url);
    if (!res.ok) return null;
    const tmp = document.createElement('div');
    tmp.innerHTML = (await res.text()).trim();
    return tmp.querySelector('.stack-card');
  }

  function uidToFetchUrl(uid: string): string {
    return `/card/${uid}`;
  }

  function urlToUid(url: string): string {
    if (url.startsWith('/card/')) return url.slice('/card/'.length);
    return url;
  }

  // Build the URL for the current stack state and push it into history.
  function updateUrl() {
    const cards = Array.from(cardStack.children);
    if (cards.length === 0) {
      history.pushState(null, '', '/');
      return;
    }
    const activeCard = cardStack.querySelector('.stack-card--active') ?? cards[cards.length - 1];
    const activeUid = (activeCard as HTMLElement).dataset.uid!;
    const activeIndex = cards.indexOf(activeCard);
    const fromUids = cards.slice(0, activeIndex).map(c => (c as HTMLElement).dataset.uid!);
    const toUids = cards.slice(activeIndex + 1).map(c => (c as HTMLElement).dataset.uid!);

    const basePath = `/card/${activeUid}`;
    const params = new URLSearchParams();
    if (fromUids.length) params.set('from', fromUids.join(','));
    if (toUids.length) params.set('to', toUids.join(','));
    const query = params.toString();
    history.pushState(null, '', query ? `${basePath}?${query}` : basePath);
  }

  async function pushCard(url: string, clickedLink?: Element | null) {
    // If the target is already in the stack, navigate to it without pruning
    const uid = urlToUid(url);
    const existingCard = cardStack.querySelector(`[data-uid="${uid}"]`);
    if (existingCard) {
      cardStack.querySelectorAll('.stack-card--active').forEach(collapseCard);
      expandCard(existingCard);
      showStack();
      existingCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      updateUrl();
      return;
    }

    // New card: prune everything after the active card, then push
    const activeCard = cardStack.querySelector('.stack-card--active');
    if (activeCard) {
      while (activeCard.nextElementSibling) {
        activeCard.nextElementSibling.remove();
      }
      collapseCard(activeCard);
    } else {
      cardStack.querySelectorAll('.stack-card--active').forEach(collapseCard);
    }

    const card = await fetchCard(url);
    if (!card) return;

    if (clickedLink && startVT) {
      // VT path: morph panel link → stack card
      setVTName(clickedLink, 'panel-card-open');
      setVTName(card, 'panel-card-open');
      // Mark active but keep body collapsed for VT snapshot
      card.classList.add('stack-card--active');
      card.classList.remove('stack-card--collapsed');
      const vt = startVT(() => {
        cardStack.appendChild(card);
        showStack();
      });
      await vt.finished;
      clearVTName(clickedLink);
      clearVTName(card);
      // Body grows after VT completes
      card.querySelector<HTMLElement>('.body-wrapper')?.classList.add('open');
    } else {
      // Instant fallback
      expandCard(card);
      cardStack.appendChild(card);
      showStack();
    }

    card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    updateUrl();
  }

  // Reconstruct the stack from ?from= and ?to= query params.
  async function initFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const fromUids = params.get('from')?.split(',').filter(Boolean) ?? [];
    const toUids = params.get('to')?.split(',').filter(Boolean) ?? [];
    if (fromUids.length === 0 && toUids.length === 0) return;

    // Insert 'from' cards as collapsed before the active card
    const activeCard = cardStack.querySelector('.stack-card--active');
    for (const uid of fromUids) {
      const card = await fetchCard(uidToFetchUrl(uid));
      if (card) {
        collapseCard(card);
        if (activeCard) {
          cardStack.insertBefore(card, activeCard);
        } else {
          cardStack.appendChild(card);
        }
      }
    }

    // Insert 'to' cards as collapsed after the active card
    for (const uid of toUids) {
      const card = await fetchCard(uidToFetchUrl(uid));
      if (card) {
        collapseCard(card);
        cardStack.appendChild(card);
      }
    }
  }

  // All stack interactions via a single delegated listener
  cardStack.addEventListener('click', async e => {
    const target = e.target as Element;

    // Close button on the active card
    const closeBtn = target.closest('.stack-card-close');
    if (closeBtn) {
      const card = closeBtn.closest<HTMLElement>('.stack-card')!;
      const prev = card.previousElementSibling;
      if (prev) {
        card.remove();
        expandCard(prev);
        updateUrl();
      } else {
        // Last card: VT morph back to panel link
        const uid = card.dataset.uid!;

        // If homepage is empty (direct URL / after refresh), fetch and inject it first
        if (homepage && homepage.children.length === 0) {
          const res = await fetch('/');
          if (res.ok) {
            const tmp = document.createElement('div');
            tmp.innerHTML = await res.text();
            const fetched = tmp.querySelector('#homepage');
            if (fetched) homepage.innerHTML = fetched.innerHTML;
          }
        }

        // Collapse body first (in parallel with any fetch above via early start)
        const bodyWrapper = card.querySelector<HTMLElement>('.body-wrapper');
        if (bodyWrapper) {
          bodyWrapper.classList.remove('open');
          await new Promise<void>(resolve => {
            bodyWrapper.addEventListener('transitionend', () => resolve(), { once: true });
          });
        }

        const matchingLink = homepage?.querySelector<HTMLElement>(`.card-link[data-push-card="${uid}"]`);
        if (matchingLink && startVT) {
          setVTName(card, 'panel-card-close');
          setVTName(matchingLink, 'panel-card-close');
          const vt = startVT(() => {
            card.remove();
            showHomepage();
            history.pushState(null, '', '/');
          });
          await vt.finished;
          clearVTName(matchingLink);
        } else {
          // Instant fallback (no VT support, or fetch failed)
          card.remove();
          showHomepage();
          history.pushState(null, '', '/');
        }
      }
      return;
    }

    // Card listing item → push that card
    const listItem = target.closest<HTMLElement>('[data-push-card]');
    if (listItem) {
      pushCard(uidToFetchUrl(listItem.dataset.pushCard!));
      return;
    }

    // Collapsed card header → activate it, keeping the rest of the stack intact
    const collapsedCard = target.closest('.stack-card--collapsed');
    if (collapsedCard) {
      cardStack.querySelectorAll('.stack-card--active').forEach(collapseCard);
      expandCard(collapsedCard);
      collapsedCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      updateUrl();
      return;
    }
  });

  // Homepage panel links — delegated listener on #homepage
  if (homepage) {
    homepage.addEventListener('click', e => {
      const target = e.target as Element;
      const link = target.closest<HTMLElement>('[data-push-card]');
      if (link) pushCard(uidToFetchUrl(link.dataset.pushCard!), link.closest('.card-link'));
    });
  }

  // tag: links — global, works in panel links and stack cards
  document.addEventListener('click', e => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="tag:"]');
    if (!link) return;
    e.preventDefault();
    const slug = link.getAttribute('href')!.slice(4);
    pushCard(`/card/tag/${slug}`);
  });

  // Handle browser back/forward
  window.addEventListener('popstate', async () => {
    cardStack.replaceChildren();
    const path = window.location.pathname;
    if (path === '/' || path === '') {
      showHomepage();
      return;
    }
    if (path.startsWith('/card/')) {
      const activeUid = path.slice('/card/'.length);
      const activeCard = await fetchCard(uidToFetchUrl(activeUid));
      if (activeCard) {
        expandCard(activeCard);
        cardStack.appendChild(activeCard);
        showStack();
        await initFromUrl();
      }
    }
  });

  // On load: if the stack has a pre-rendered active card, open its body and hydrate from/to context
  const preRenderedActive = cardStack.querySelector('.stack-card--active');
  if (preRenderedActive) {
    preRenderedActive.querySelector<HTMLElement>('.body-wrapper')?.classList.add('open');
    showStack();
    initFromUrl();
  }
</script>
