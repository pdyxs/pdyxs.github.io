---
// Renders the `.stack-card` fragment for a card location. Shared by the
// full-page route (src/pages/card/[...path].astro) and the fragment-partial
// route (src/pages/fragment/card/[...path].astro) — both wrap this in whatever
// shell they need (or none, for the fragment).
//
// This component resolves NOTHING. Every piece of card metadata it renders —
// title, description hash, status, renderer names, width — arrives on the
// `card` prop as a ResolvedCard, produced once by resolveCard() (src/lib/cards.ts)
// in the route's getStaticPaths(), which already calls getAllCards().
//
// That is the whole point of #77. This file used to re-derive title, status,
// renderer, nav renderer and content hash independently, guarded only by
// comments asserting it matched getAllCards(); a content-hash mismatch would
// silently break client-side read tracking (getViewState keys on the hash).
// There is now one computation, so there is nothing to keep in sync — and
// CardStackCard.test.ts guards against local resolution creeping back in.
import { getCollection, render } from 'astro:content';
import type { ResolvedCard } from '../lib/cards';
import type { BrowseCardData } from '../lib/browse-helpers';
import { resolveCardRenderer, resolveNavRenderer } from '../lib/location-resolver';
import type { TagDisplay } from '../lib/tag-display';
import { resolveSeriesCards } from '../lib/series-cards';
import { computeSeriesDateBar } from '../lib/series';
import CardHeader from './CardHeader.astro';

interface Props {
  /** The resolved card to render — produced by resolveCard() in the route's getStaticPaths(). */
  card: ResolvedCard;
  /** Flat value -> display-name map from the tag registry, threaded down to whichever renderer shows per-card tag chips. */
  tagDisplay?: Record<string, TagDisplay>;
  /** Cards that link to this one via a card-backed tag, threaded down to GenericRenderer's "Related" section. */
  relatedCards?: BrowseCardData[];
  /** Cards this one points at via its own card-backed tags (see computeSubjectCardsIndex) — the "This is about" section. */
  subjectCards?: BrowseCardData[];
}

// Cast is load-bearing: Astro's props-type extraction falls back to
// Record<string, any> for a Props interface with a Record<…> member (tagDisplay),
// leaving Astro.props untyped — `as Props` restores the real prop types.
const { card, tagDisplay = {}, relatedCards = [], subjectCards = [] } = Astro.props as Props;

// Entry lookup is IO, not resolution: the renderers take the raw entry for its
// frontmatter, and a NavComponent takes the full collection as sibling
// candidates (getSeriesSiblings in src/lib/series.ts narrows by matching
// `data.series`, so no path-prefix filtering is needed here). Both routes would
// otherwise duplicate this, and getCollection() is cached per build.
const allEntries = await getCollection('content');
const entry = allEntries.find((e: any) => e.id === card.uid) ?? null;
const rendered = entry ? await render(entry as any) : null;
const Content = rendered?.Content;

const Renderer = resolveCardRenderer(card.renderer);
const NavComponent = resolveNavRenderer(card.navRenderer);

// The series preview is resolved here, not in SeriesNavRenderer: a nav
// renderer takes the content renderer as a slot, so anything it appended
// would sit below "This is about" / "Cards about this" instead of leading
// them (or, for the 'dots' style, below the body instead of above it). The
// condition is the `series:` frontmatter alone — the same thing
// getSeriesSiblings matches on — so a subset of a folder that declares its
// own run gets a preview too, with no dependency on `navRenderer`.
// `seriesPreview: 'none'` (or 'dots', which GenericRenderer renders from the
// same array without the images/description a 'strip' tile needs) is the
// caller's business, not this resolution's — the whole array is fetched
// either way and it's cheap.
const seriesCards = entry?.data?.series && card.seriesPreview !== 'none'
  ? await resolveSeriesCards(entry as any, allEntries as any, {
      isDev: import.meta.env.DEV,
      now: new Date(),
    })
  : [];

// The date bar is a separate, purely synchronous decision (no card images to
// resolve) — see computeSeriesDateBar. `dateBar` opts a folder in; a series
// with no `storyDate` data still resolves to null even when opted in.
const seriesDateBar = card.dateBar && entry?.data?.series
  ? computeSeriesDateBar(entry as any, allEntries as any, {
      isDev: import.meta.env.DEV,
      now: new Date(),
    })
  : null;
---
<div
  class="stack-card stack-card--active"
  data-uid={card.uid}
  data-content-hash={card.contentHash}
  data-width={card.width}
>
  {/* The spine sits outside the nav-renderer branch deliberately: a nav
      renderer owns the *header and body* of the card, not the `.stack-card`
      element itself (its output is a sibling pair inside this div), so one
      spine here covers both branches. It is the first child so it precedes
      everything it will overlay once slice #109 gives its column a width;
      until then `--left-col` is unset and the column is 0px. */}
  <div class="stack-card-spine">
    <div class="stack-card-spine-inner">
      <span class="stack-card-spine-title">{card.title}</span>
    </div>
  </div>
  {NavComponent ? (
    <NavComponent
      title={card.title}
      titleSuffix={card.titleSuffix}
      {entry}
      {allEntries}
      status={card.status}
      date={card.date}
      {tagDisplay}
    >
      <Renderer {entry} {Content} {tagDisplay} {relatedCards} {subjectCards} {seriesCards} {seriesDateBar} seriesPreview={card.seriesPreview} cardTags={card.tags} date={card.date} dateLabel={card.dateLabel} gallery={card.gallery} collapsedContainer={card.collapsedContainer} />
    </NavComponent>
  ) : (
    <>
      {/* 1px IntersectionObserver target for the sticky active header (slice
          #110). The nav-renderer branch has its own, in SeriesNavRenderer —
          a nav renderer renders the header, so it renders the sentinel. */}
      <div class="card-header-sentinel"></div>
      <CardHeader
        title={card.title}
        titleSuffix={card.titleSuffix}
        status={card.status}
        date={card.date}
      >
        <button class="stack-card-close" aria-label="Close">×</button>
      </CardHeader>
      <div class="body-wrapper open">
        <div class="stack-card-body">
          <div class="stack-card-body-inner">
            <Renderer {entry} {Content} {tagDisplay} {relatedCards} {subjectCards} {seriesCards} {seriesDateBar} seriesPreview={card.seriesPreview} cardTags={card.tags} date={card.date} dateLabel={card.dateLabel} gallery={card.gallery} collapsedContainer={card.collapsedContainer} />
          </div>
        </div>
      </div>
    </>
  )}
</div>
