---
// Renders the `.stack-card` fragment for a card location. Shared by the
// full-page route (src/pages/card/[...path].astro) and the fragment-partial
// route (src/pages/fragment/card/[...path].astro) — both wrap this in whatever
// shell they need (or none, for the fragment).
//
// This component resolves NOTHING. Every piece of card metadata it renders —
// title, description hash, status, renderer names, width — arrives on the
// `card` prop as a ResolvedCard, produced once by resolveCard() (src/lib/cards.ts)
// in the route's getStaticPaths(), which already calls getAllCards().
//
// That is the whole point of #77. This file used to re-derive title, status,
// renderer, nav renderer and content hash independently, guarded only by
// comments asserting it matched getAllCards(); a content-hash mismatch would
// silently break client-side read tracking (getViewState keys on the hash).
// There is now one computation, so there is nothing to keep in sync — and
// CardStackCard.test.ts guards against local resolution creeping back in.
import { getCollection, render } from 'astro:content';
import type { ResolvedCard, CardMeta } from '../lib/cards';
import { resolveCardRenderer, resolveNavRenderer } from '../lib/location-resolver';
import type { TagDisplay } from '../lib/tag-display';
import CardHeader from './CardHeader.astro';

interface Props {
  /** The resolved card to render — produced by resolveCard() in the route's getStaticPaths(). */
  card: ResolvedCard;
  /** Flat value -> display-name map from the tag registry, threaded down to whichever renderer shows per-card tag chips. */
  tagDisplay?: Record<string, TagDisplay>;
  /** Cards that link to this one via a card-backed tag, threaded down to GenericRenderer's "Related" section. */
  relatedCards?: CardMeta[];
}

// Cast is load-bearing: Astro's props-type extraction falls back to
// Record<string, any> for a Props interface with a Record<…> member (tagDisplay),
// leaving Astro.props untyped — `as Props` restores the real prop types.
const { card, tagDisplay = {}, relatedCards = [] } = Astro.props as Props;

// Entry lookup is IO, not resolution: the renderers take the raw entry for its
// frontmatter, and a NavComponent takes the full collection as sibling
// candidates (getSeriesSiblings in src/lib/series.ts narrows by matching
// `data.series`, so no path-prefix filtering is needed here). Both routes would
// otherwise duplicate this, and getCollection() is cached per build.
const allEntries = await getCollection('content');
const entry = allEntries.find((e: any) => e.id === card.uid) ?? null;
const rendered = entry ? await render(entry as any) : null;
const Content = rendered?.Content;

const Renderer = resolveCardRenderer(card.renderer);
const NavComponent = resolveNavRenderer(card.navRenderer);
---
<div
  class="stack-card stack-card--active"
  data-uid={card.uid}
  data-content-hash={card.contentHash}
  data-width={card.width}
>
  {NavComponent ? (
    <NavComponent
      title={card.title}
      titleSuffix={card.titleSuffix}
      {entry}
      {allEntries}
      status={card.status}
      date={card.date}
    >
      <Renderer {entry} {Content} {tagDisplay} {relatedCards} />
    </NavComponent>
  ) : (
    <>
      <CardHeader
        title={card.title}
        titleSuffix={card.titleSuffix}
        status={card.status}
        date={card.date}
      >
        <button class="stack-card-close" aria-label="Close">×</button>
      </CardHeader>
      <div class="body-wrapper open">
        <div class="stack-card-body">
          <div class="stack-card-body-inner">
            <Renderer {entry} {Content} {tagDisplay} {relatedCards} />
          </div>
        </div>
      </div>
    </>
  )}
</div>
