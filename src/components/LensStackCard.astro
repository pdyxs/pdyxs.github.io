---
// Renders the `.stack-card` fragment for a lens location ("home", "newest").
// Shared by the full-page route (src/pages/lens/[name].astro), the `/` shortcut
// (via LensPage.astro), and the fragment-partial route
// (src/pages/fragment/lens/[name].astro).
//
// LensStackCard owns the *chrome* — it renders BOTH a page-mode header
// (site-header: title + subtitle + divider) and a card-mode header, and the
// lens component only renders the body. Which chrome shows is a pure decision
// of stack position (presentationMode in stack-layout.ts): a lens that is the
// sole/root entry is "page" mode, otherwise "card" mode. The `presentation`
// prop seeds the initial class for cold loads; CardStack.svelte toggles
// `stack-card--page` reactively thereafter and morphs between the two headers
// via View Transitions. Both headers live in the DOM at once so that morph has
// stable old/new targets.
//
// Resolution of the lens's own Astro component goes through resolveLocation()
// (src/lib/location-resolver.ts) and only ever reaches the component via the
// lazy dynamic import() in src/lib/lens-components.ts — nothing here imports a
// lens's rendering code eagerly.
import { resolveLocation } from '../lib/location-resolver';
import { getLensDefinition } from '../lib/lens-registry';
import { deriveLensChrome } from '../lib/lens-chrome';
import type { FilterState } from '../lib/filters';

interface Props {
  name: string;
  /** Initial chrome for cold loads. Defaults to card mode (in-app pushes). */
  presentation?: 'page' | 'card';
}

const { name, presentation = 'card' } = Astro.props;
const uid = `lens/${name}`;
const resolution = resolveLocation(uid);
const lens = getLensDefinition(name);

const LensComponent = resolution.kind === 'lens' ? (await resolution.loadComponent()).default : null;

// Cold-load chrome uses the empty filter state — these are fully static routes
// with no live query string (see NewestLens.astro). The client refines the
// title once the browsing island reads window.location.search.
const filterState: FilterState = { selections: {} };
const chrome = lens ? deriveLensChrome(lens, filterState) : null;

// Home is the root of the stack and is never closable; other lenses are.
const isHome = lens?.dimension === 'root';
---
{LensComponent && lens && chrome ? (
  <div
    class:list={['stack-card', 'stack-card--active', presentation === 'page' && 'stack-card--page']}
    data-uid={uid}
  >
    <header class="page-header">
      <h1 class="page-title">{chrome.pageTitle}</h1>
      <p class="page-subtitle">{chrome.pageSubtitle}</p>
    </header>
    <div class="card-header">
      <span class="card-header-title"><b>{chrome.cardTitle}</b></span>
      {!isHome && <button class="stack-card-close" aria-label="Close">×</button>}
    </div>
    <div class="body-wrapper open">
      <div class="stack-card-body">
        <div class="stack-card-body-inner">
          <LensComponent />
        </div>
      </div>
    </div>
  </div>
) : (
  <div class="stack-card stack-card--active" data-uid={uid}>
    <p class="lens-not-found">Unknown lens: {name}</p>
  </div>
)}
