---
// Renders the `.stack-card` fragment for a lens location ("home", "newest").
// Shared by the full-page route (src/pages/lens/[name].astro), the `/` shortcut
// (via LensPage.astro), and the fragment-partial route
// (src/pages/fragment/lens/[name].astro).
//
// LensStackCard owns the *chrome* — it renders BOTH a page-mode header
// (site-header: title + subtitle + divider) and a card-mode header. Which
// chrome shows is a pure decision of stack position (presentationMode in
// stack-layout.ts): a lens that is the sole/root entry is "page" mode,
// otherwise "card" mode. The `presentation` prop seeds the initial class for
// cold loads; CardStack.svelte toggles `stack-card--page` reactively
// thereafter and morphs between the two headers via View Transitions. Both
// headers live in the DOM at once so that morph has stable old/new targets.
//
// LensStackCard is also the shared-fetch owner for every lens: it takes
// allCards/hierarchies/tagDisplay from the shared card pool (src/lib/card-pool.ts,
// built once per process — every lens body wants the same universe of cards)
// and resolves the lens's body component via an awaited dynamic import() —
// the lazy-load boundary in src/lib/lens-components.ts.
// The dimension-filter bar (LensFilterShell) and the resolved body render as
// SIBLING islands: Astro's client:* islands can't share live reactive props
// across independent hydration boundaries, so they coordinate only through
// the shared lensFilterStore (src/stores/lens-filter-store.ts) — see that
// store's header comment.
import { getLensDefinition } from '../lib/lens-registry';
import { deriveLensChrome } from '../lib/lens-chrome';
import { buildCardPool, toSharedAsset } from '../lib/card-pool';
import { emptyFilterState } from '../dimensions';
import type { FilterState } from '../dimensions';
import { LENS_BODY_LOADERS, DEFAULT_BODY_LOADER } from '../lib/lens-components';
import LensFilterShell from './LensFilterShell.svelte';

interface Props {
  name: string;
  /** Initial chrome for cold loads. Defaults to card mode (in-app pushes). */
  presentation?: 'page' | 'card';
}

const { name, presentation = 'card' } = Astro.props;
const uid = `lens/${name}`;
const lens = getLensDefinition(name);

// Cold-load chrome uses the empty filter state — these are fully static routes
// with no live query string, and a fragment is fetched by uid, so what renders
// here is always the UNFILTERED lens. The filters are part of the location's
// identity rather than the fragment's, so CardStack applies them to the title
// on the client (applyLensTitle; see src/lib/lens-chrome.ts).
const filterState: FilterState = emptyFilterState();
const chrome = lens ? deriveLensChrome(lens, filterState) : null;

// Home is the root of the stack and is never closable; other lenses are.
// Identified by id, not dimension — home is filed under 'what' so it also
// appears in that dimension's panel, but is still the sole stack anchor.
const isHome = lens?.id === 'home';

let hierarchies: any = null;
let groupOrder: any = {};
let tagDisplay: any = {};
let serialisedCards: any[] = [];
// Serialised (array) form of the card-backed value set, for the client island.
let cardBackedValuesList: string[] = [];
let BodyComponent: any = null;

if (lens) {
  // The card pool is built once per process and shared by every lens route and
  // fragment — see src/lib/card-pool.ts for the pipeline and for why the
  // module-level memo there is the deliberate opposite of #102's rule.
  const pool = await buildCardPool();
  ({
    cards: serialisedCards,
    tagDisplay,
    hierarchies,
    groupOrder,
    cardBackedValues: cardBackedValuesList,
  } = toSharedAsset(pool));

  const bodyLoader = LENS_BODY_LOADERS[lens.component] ?? DEFAULT_BODY_LOADER;
  BodyComponent = (await bodyLoader()).default;
}
---
{lens && chrome ? (
  <div
    class:list={['stack-card', 'stack-card--active', presentation === 'page' && 'stack-card--page']}
    data-uid={uid}
    data-width={lens.width}
  >
    {/* One spine serves both chrome modes: page and card mode are the same
        DOM with a class toggled, so the spine (like the borders) belongs to
        the `.stack-card` element rather than to either header. Its column is
        0px until slice #109 sets --left-col. */}
    <div class="stack-card-spine">
      <div class="stack-card-spine-inner">
        <span class="stack-card-spine-title">{chrome.cardTitle}</span>
      </div>
    </div>
    <header class="page-header">
      <h1 class="page-title"><a href="/" class="page-title-link">{chrome.pageTitle}</a></h1>
      {/* The SITE's subtitle, not the lens's — page mode is the root of the
          stack, so its header says what the site is. The lens names itself in
          card mode (and, once it is behind another card, in its spine). Its
          footnote goes with that name, so it isn't rendered here either. */}
      {chrome.pageSubtitle && <p class="page-subtitle">{chrome.pageSubtitle}</p>}
    </header>
    {/* 1px IntersectionObserver target for the sticky active header (slice #110). */}
    <div class="card-header-sentinel"></div>
    <div class="card-header">
      {/* The footnote is a SIBLING of .card-header-title, not part of it —
          CardStack reads that element's textContent as the card's name when it
          builds a placeholder, and would otherwise name the card after its own
          disclaimer. */}
      <span class="card-header-title"><b>{chrome.cardTitle}</b></span>
      {chrome.note && <small class="lens-note">{chrome.note}</small>}
      {!isHome && <button class="stack-card-close" aria-label="Close">×</button>}
    </div>
    <div class="body-wrapper open">
      <div class="stack-card-body">
        <div class="stack-card-body-inner">
          <LensFilterShell client:load lens={lens} hierarchies={hierarchies} groupOrder={groupOrder} tagDisplay={tagDisplay} />
          {BodyComponent && (
            <BodyComponent cards={serialisedCards} tagDisplay={tagDisplay} config={lens.config} cardBackedValues={cardBackedValuesList} />
          )}
        </div>
      </div>
    </div>
  </div>
) : (
  <div class="stack-card stack-card--active" data-uid={uid}>
    <p class="lens-not-found">Unknown lens: {name}</p>
  </div>
)}
