---
// Renders the `.stack-card` fragment for a lens location ("home", "newest").
// Shared by the full-page route (src/pages/lens/[name].astro), the `/` shortcut
// (via LensPage.astro), and the fragment-partial route
// (src/pages/fragment/lens/[name].astro).
//
// LensStackCard owns the *chrome* — it renders BOTH a page-mode header
// (site-header: title + subtitle + divider) and a card-mode header. Which
// chrome shows is a pure decision of stack position (presentationMode in
// stack-layout.ts): a lens that is the sole/root entry is "page" mode,
// otherwise "card" mode. The `presentation` prop seeds the initial class for
// cold loads; CardStack.svelte toggles `stack-card--page` reactively
// thereafter and morphs between the two headers via View Transitions. Both
// headers live in the DOM at once so that morph has stable old/new targets.
//
// LensStackCard is also the shared-fetch owner for every lens: it fetches
// allCards/hierarchies/tagDisplay ONCE here (every lens body wants the same
// universe of cards) and resolves the lens's body component via an awaited
// dynamic import() — the lazy-load boundary in src/lib/lens-components.ts.
// The dimension-filter bar (LensFilterShell) and the resolved body render as
// SIBLING islands: Astro's client:* islands can't share live reactive props
// across independent hydration boundaries, so they coordinate only through
// the shared lensFilterStore (src/stores/lens-filter-store.ts) — see that
// store's header comment.
import { getImage } from 'astro:assets';
import { resolveLocalImage } from '../lib/images';
import { getLensDefinition } from '../lib/lens-registry';
import { deriveLensChrome } from '../lib/lens-chrome';
import { getAllCards } from '../lib/cards';
import { getTagRegistry, getDimensionGroupOrder, flattenTagDisplay, makeContentTreeReader } from '../lib/tag-registry';
import { discoverCollapseConfig } from '../lib/collapse-config';
import { collapseCollections } from '../lib/collapse';
import { buildAllDimensionHierarchies } from '../lib/browse-helpers';
import { DIMENSIONS } from '../lib/filters';
import type { FilterState } from '../lib/filters';
import { LENS_BODY_LOADERS, DEFAULT_BODY_LOADER } from '../lib/lens-components';
import LensFilterShell from './LensFilterShell.svelte';

const REMOTE_IMAGE_URL = /^https?:\/\/.*\.(jpe?g|png|gif|webp|avif)(\?.*)?$/i;

interface Props {
  name: string;
  /** Initial chrome for cold loads. Defaults to card mode (in-app pushes). */
  presentation?: 'page' | 'card';
}

const { name, presentation = 'card' } = Astro.props;
const uid = `lens/${name}`;
const lens = getLensDefinition(name);

// Cold-load chrome uses the empty filter state — these are fully static routes
// with no live query string. The client refines the title once
// LensFilterShell reads window.location.search.
const filterState: FilterState = { selections: {} };
const chrome = lens ? deriveLensChrome(lens, filterState) : null;

// Home is the root of the stack and is never closable; other lenses are.
// Identified by id, not dimension — home is filed under 'what' so it also
// appears in that dimension's panel, but is still the sole stack anchor.
const isHome = lens?.id === 'home';

let hierarchies: any = null;
let groupOrder: any = {};
let tagDisplay: any = {};
let serialisedCards: any[] = [];
let BodyComponent: any = null;

if (lens) {
  const allCards = await getAllCards();
  // Listing filter (see computeStatusVisibility): the pool every lens/browse/
  // timeline view draws from excludes cards whose status isn't listed (e.g.
  // draft, outside isDev). getAllCards() itself stays unfiltered — the
  // reachability filter (getStaticPaths in card/[...path].astro) applies
  // independently over the same source list.
  const listedCards = allCards.filter(c => c.visibility.listed);
  const registry = await getTagRegistry(listedCards);
  groupOrder = await getDimensionGroupOrder();
  tagDisplay = flattenTagDisplay(registry);
  const declaredValues = DIMENSIONS.flatMap(d => registry[d].values);

  // Collapse opted-in folders (e.g. story series) to a single representative
  // card BEFORE building hierarchies/counts and serialising — so the results
  // grid, frontpage slots, and dimension-panel counts all browse the collapsed
  // view. The tag registry above stays on the full listed-card list so each
  // folder's declared identity and every value still register. getAllCards()
  // itself is never collapsed: member cards remain real cards for direct nav
  // + series nav.
  const collapseConfig = await discoverCollapseConfig(makeContentTreeReader());
  const browseCards = collapseCollections(listedCards, collapseConfig, v => tagDisplay[v] ?? {});

  hierarchies = buildAllDimensionHierarchies(browseCards, declaredValues, tagDisplay);

  // Resolve each card's header `image` to a small thumbnail URL for the
  // condensed browse cards: local images go through astro:assets; remote images
  // are used as-is only when the URL ends in a known image extension (dead
  // Jekyll-era embed/video links are dropped so they never render a broken img).
  serialisedCards = await Promise.all(
    browseCards.map(async card => {
      const localImage = resolveLocalImage(card.uid, card.image);
      let thumb: string | undefined;
      let thumbSrcset: string | undefined;
      if (localImage) {
        // Responsive widths cover a full-width mobile card at 2x (720) down to a
        // 3-up desktop column; `sizes` on the <img> lets the browser pick.
        const generated = await getImage({ src: localImage, widths: [360, 720], format: 'webp' });
        thumb = generated.src;
        thumbSrcset = generated.srcSet.attribute;
      } else if (card.image && REMOTE_IMAGE_URL.test(card.image)) {
        thumb = card.image;
      }
      return { ...card, date: card.date?.toISOString() ?? null, thumb, thumbSrcset };
    })
  );

  const bodyLoader = LENS_BODY_LOADERS[lens.component] ?? DEFAULT_BODY_LOADER;
  BodyComponent = (await bodyLoader()).default;
}
---
{lens && chrome ? (
  <div
    class:list={['stack-card', 'stack-card--active', presentation === 'page' && 'stack-card--page']}
    data-uid={uid}
    data-width={lens.width}
  >
    <header class="page-header">
      <h1 class="page-title"><a href="/" class="page-title-link">{chrome.pageTitle}</a></h1>
      <p class="page-subtitle">{chrome.pageSubtitle}</p>
    </header>
    <div class="card-header">
      <span class="card-header-title"><b>{chrome.cardTitle}</b></span>
      {!isHome && <button class="stack-card-close" aria-label="Close">×</button>}
    </div>
    <div class="body-wrapper open">
      <div class="stack-card-body">
        <div class="stack-card-body-inner">
          <LensFilterShell client:load lens={lens} hierarchies={hierarchies} groupOrder={groupOrder} tagDisplay={tagDisplay} />
          {BodyComponent && (
            <BodyComponent cards={serialisedCards} tagDisplay={tagDisplay} config={lens.config} />
          )}
        </div>
      </div>
    </div>
  </div>
) : (
  <div class="stack-card stack-card--active" data-uid={uid}>
    <p class="lens-not-found">Unknown lens: {name}</p>
  </div>
)}
