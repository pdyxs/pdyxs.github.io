---
import CardHeader from './CardHeader.astro';

interface Props {
  uid: string;
  title: string;
  titleSuffix?: string;
}
const { uid, title, titleSuffix } = Astro.props;
---
<div
  class="card-link"
  data-push-card={uid}
>
  <CardHeader {title} {titleSuffix} />
</div>

<style>
  .card-link {
    cursor: pointer;
  }

  /* Card headers sit at L2 already, so hover steps up to the strong level. */
  .card-link:hover :global(.card-header) {
    background: var(--color-bg-hover-strong);
  }
</style>
