---
// A compact "where am I in this series" strip — the stripped-down alternative
// to the full-thumbnail "In this series" CardStrip (see `seriesPreview` on
// ResolvedCard). One small square per sibling, no numbers/thumbnails, so a
// 20+ chapter run (Svalbard) still reads as one line instead of a wrapped
// grid — plus `‹`/`›` arrows at the ends, so stepping through doesn't require
// aiming at a specific square.
//
// Static markup, no island: unlike CardStrip (a scrolling row that needs to
// measure overflow and drag a custom scrollbar), the squares just shrink to
// fit via flexbox — there is nothing here that needs measuring. Uses
// `data-replace-slot` (not `data-push-card`): browsing a series steps through
// it in place, the same way the strip lens's "See all N →" terminal tile
// swaps the active lens rather than stacking on top of it — CardStack.svelte's
// delegated click handler is what actually navigates.
import type { BrowseCardData } from '@browse/results/browse-helpers';

interface Props {
  cards: BrowseCardData[];
  /** uid of the card already open — renders as a marked, non-navigating square, same rule as CardStrip/BrowseCard's `current`. */
  currentUid: string;
  /**
   * The series' own name — the declared identity of the collapsed folder the
   * chapter sits in (GenericRenderer resolves it; absent for a
   * frontmatter-only run, which has no folder identity to borrow).
   *
   * It is here because the chip that used to say it was dropped: a chapter's
   * path tag names the story it is a part of, which is a containment relation
   * and not a facet (see computeCardTagDisplay's `selfContainer`). This is
   * where the relation actually belongs — on the thing already drawing the
   * run — so a chapter titled "Themes" still says what it is a chapter of.
   *
   * Plain text, deliberately not a link: the only target would be the `tag:`
   * lens the chip already linked to, which holds exactly one result — the
   * collapsed representative, i.e. where the reader already is.
   */
  label?: string;
}

const { cards, currentUid, label } = Astro.props;
const currentIndex = cards.findIndex(c => c.uid === currentUid);
const prev = currentIndex > 0 ? cards[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < cards.length - 1 ? cards[currentIndex + 1] : undefined;
---

<nav class="series-dot-strip" aria-label={label ? `Position in ${label}` : 'Position in series'}>
  {label && <span class="series-dot-label">{label}</span>}

  {prev ? (
    <a class="series-dot-arrow card-link" href={`/card/${prev.uid}`} data-replace-slot={prev.uid} aria-label="Previous chapter">‹</a>
  ) : (
    <span class="series-dot-arrow series-dot-arrow--disabled" aria-hidden="true">‹</span>
  )}

  <ol class="series-dot-track">
    {cards.map((card, i) => {
      const current = i === currentIndex;
      return (
        <li class="series-dot-item" class:list={{ 'series-dot-item--current': current }}>
          {current ? (
            <span class="series-dot" aria-current="true" title={card.title}></span>
          ) : (
            <a class="series-dot card-link" href={`/card/${card.uid}`} data-replace-slot={card.uid} aria-label={card.title} title={card.title}></a>
          )}
        </li>
      );
    })}
  </ol>

  {next ? (
    <a class="series-dot-arrow card-link" href={`/card/${next.uid}`} data-replace-slot={next.uid} aria-label="Next chapter">›</a>
  ) : (
    <span class="series-dot-arrow series-dot-arrow--disabled" aria-hidden="true">›</span>
  )}
</nav>

{/* Scoped, even though this markup ships inside a card FRAGMENT injected into
    a page that never rendered this component: `cssCodeSplit: false`
    (astro.config.mjs, guarded by src/config.test.ts) merges every page's CSS
    into one bundle that every page links, so a scoped rule exists wherever its
    component's markup can land.

    One rule about this strip lives elsewhere on purpose:
    `.stack-card-body-inner .generic-bleed + .series-dot-strip`
    (src/styles/generic-card.css) is about the strip's ADJACENCY to the
    masthead, not about the strip, and at (0,3,0) it still outranks the
    scoped `.series-dot-strip` below. */}
<style>
  .series-dot-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Wraps only for the label, which claims a full row of its own below —
       the arrows and the track never wrap (the track shrinks instead). */
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0 0 var(--space-md);
  }

  /* The series' own name, above its dots — see the `label` prop's note in
     this component's frontmatter for why this line exists at all.
     De-emphasised by size and letterform, never by a faded colour: the
     palette has no grey. */
  .series-dot-label {
    flex: 1 0 100%;
    text-align: center;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    margin-bottom: calc(var(--space-xs) * -1);
  }

  .series-dot-track {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
    /* Allows the row to shrink below its natural width instead of wrapping —
       the whole point for a 22-chapter series (see the component header). */
    min-width: 0;
    flex: 0 1 auto;
  }

  .series-dot-item {
    display: contents;
  }

  .series-dot {
    display: block;
    /* Basis, not a fixed size: shrinks on a narrow/long series, never grows
       past it on a short one — a wrapper that stretched to fill the card
       would make Fate's Hand's 6 squares comically large. */
    flex: 0 1 12px;
    width: 12px;
    height: 12px;
    min-width: 4px;
    min-height: 4px;
    border: var(--border-width) solid var(--color-border);
    padding: 0;
  }

  a.series-dot:hover {
    background: var(--color-bg-hover);
  }

  /* "You are here" — the mirror of every flat-surface rule, same tokens as
     BrowseCard's --current tile (see the --color-selected-* table in
     docs/agents/styling.md). No text/stroke to restate here — an empty square
     carries no glyph. */
  .series-dot-item--current .series-dot {
    background: var(--color-selected-bg);
    border-color: var(--color-selected-bg);
    cursor: default;
  }

  .series-dot:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 1px;
  }

  .series-dot-strip > .series-dot-arrow {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1;
  }

  /* State rules restate the same parent as the base rule above, and that is
     load-bearing. Astro's scoping appends `[data-astro-cid-*]` to EVERY
     compound in a selector, so the two-compound base rule gains (0,2,0) while
     a bare `a.series-dot-arrow:hover` gains only (0,1,0) — the base then
     outranks the hover it used to lose to, and the glyph stays ink-on-ink on
     an inverted surface. Naming the parent here keeps hover exactly one
     pseudo-class above the base, which is the relationship it had as a global
     rule. */
  .series-dot-strip > a.series-dot-arrow:hover {
    background: var(--color-selected-bg);
    color: var(--color-selected-fg);
    -webkit-text-stroke-color: var(--color-selected-bg);
  }

  .series-dot-arrow--disabled {
    color: var(--color-text-muted);
  }
</style>
