---
import CardHeader from '../CardHeader.astro';
import { getSeriesSiblings } from '../../lib/series';
import type { StoryEntry } from '../../lib/series';

interface Props {
  entry: StoryEntry | undefined;
  allEntries: StoryEntry[];
  title: string;
  titleSuffix?: string;
}

const { entry, allEntries, title, titleSuffix } = Astro.props;

const siblings = entry
  ? getSeriesSiblings(entry, allEntries, { isDev: import.meta.env.DEV, now: new Date() })
  : null;
---

<CardHeader {title} {titleSuffix}>
  {siblings && (
    <span class="series-position">{siblings.current}/{siblings.total}</span>
  )}
  <button class="stack-card-close" aria-label="Close">×</button>
</CardHeader>

<div class="body-wrapper open">
  <div class="stack-card-body">
    <div class="stack-card-body-inner">
      <slot />
      {siblings && (
        <nav class="series-footer-nav">
          {siblings.prev && (
            <button data-replace-slot={siblings.prev.id} class="series-nav-btn series-nav-btn--prev">
              ← {siblings.prev.data.title ?? 'Previous'}
            </button>
          )}
          {siblings.next && (
            <button data-replace-slot={siblings.next.id} class="series-nav-btn series-nav-btn--next">
              {siblings.next.data.title ?? 'Next'} →
            </button>
          )}
        </nav>
      )}
    </div>
  </div>
</div>

<style>
  .series-position {
    font-size: 0.85em;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  .series-footer-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .series-nav-btn {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm, 4px);
    padding: var(--space-sm) var(--space-md);
    cursor: pointer;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.9rem;
    transition: background 0.15s;
  }

  .series-nav-btn:hover {
    background: var(--color-bg-hover, var(--color-surface));
  }

  .series-nav-btn--next {
    margin-left: auto;
  }
</style>
