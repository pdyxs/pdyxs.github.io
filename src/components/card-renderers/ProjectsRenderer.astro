---
import { getCollection } from 'astro:content';
import { getAllCards } from '../../lib/cards';
import { getAvailableTagsForCards } from '../../lib/collection-views';
import CardHeader from '../CardHeader.astro';
import CollectionBrowser from '../CollectionBrowser.svelte';

const allCards = await getAllCards();
const allTags = await getCollection('tag');
const projectCards = allCards.filter(c => c.collection === 'projects');
const availableTags = getAvailableTagsForCards(projectCards, allTags);
---

<CardHeader title="Projects">
  <button class="stack-card-close" aria-label="Close">×</button>
</CardHeader>
<div class="body-wrapper open">
  <div class="stack-card-body">
    <div class="stack-card-body-inner">
      <CollectionBrowser client:load entries={projectCards} {availableTags} title="Projects" uid="projects" />
    </div>
  </div>
</div>
