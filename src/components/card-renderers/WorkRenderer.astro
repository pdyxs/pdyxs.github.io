---
import type { RenderResult } from 'astro:content';
import { Image } from 'astro:assets';
import { resolveLocalImage } from '../../lib/images';

interface Props {
  entry: { id: string; data: { title: string; when?: string; roles?: string; image?: string } } | undefined;
  Content: RenderResult['Content'] | undefined;
}

const { entry, Content } = Astro.props;
if (!entry) return;

const { when, roles, image } = entry.data;
const localImage = resolveLocalImage(entry.id, image);
const remoteImageSrc = !localImage && image?.startsWith('http') ? image : undefined;
---

{remoteImageSrc && <img class="work-image" src={remoteImageSrc} alt="" />}
{localImage && <Image class="work-image" src={localImage} alt="" />}
{(when || roles) && (
  <dl class="work-meta">
    {when && <><dt>When</dt><dd>{when}</dd></>}
    {roles && <><dt>Role</dt><dd>{roles}</dd></>}
  </dl>
)}
{Content && <Content />}

<style>
  .work-image {
    width: 100%;
    max-height: 200px;
    object-fit: cover;
    border-radius: var(--radius-sm, 4px);
    margin-bottom: var(--space-md);
  }

  .work-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs) var(--space-md);
    margin-bottom: var(--space-lg);
    font-size: 0.9rem;
  }

  .work-meta dt {
    font-weight: 600;
    color: var(--color-text-muted, var(--color-text));
    opacity: 0.7;
  }
</style>
