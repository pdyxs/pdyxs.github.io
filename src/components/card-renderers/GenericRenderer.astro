---
import type { RenderResult } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { resolveLocalImage, resolveLocalVideo, resolveGalleryImages } from '../../lib/images';
import { displayFor } from '../../lib/tag-display';
import { computeCardTagDisplay } from '../../lib/card-tag-display';
import type { TagDisplay } from '../../lib/tag-display';
import type { BrowseCardData } from '../../lib/browse-helpers';
import { resolveMetaRows } from '../../lib/card-meta';
import { resolveActions } from '../../lib/card-actions';
import { bodyHasInlineImage } from '../../lib/inline-images';
import { resolveDateline } from '../../lib/card-date';
import type { RawMetaRow } from '../../lib/card-meta';
import type { Action } from '../../lib/card-actions';
import ImageGallery from '../ImageGallery.svelte';
import InlineImageViewer from '../InlineImageViewer.svelte';
import CardStrip from '../CardStrip.svelte';

interface Quote {
  quote: string;
  by?: string;
  in?: { text: string; url: string };
}

interface Props {
  entry: {
    id: string;
    /** Raw markdown — read only to spot images the body already renders inline (see resolveGalleryImages). */
    body?: string;
    data: {
      description?: string;
      image?: string;
      medium?: string;
      puzzle_type?: string;
      difficulty?: string;
      sudokupad_url?: string;
      url?: string;
      meta?: RawMetaRow[];
      canonical_url?: string;
      source?: string;
      actions?: Action[];
      quotes?: Quote[];
      images?: string[];
      tags?: string[];
    };
  } | undefined;
  Content: RenderResult['Content'] | undefined;
  /** Flat value -> display-name map from the tag registry (see tag-registry.ts's flattenTagDisplay). */
  tagDisplay?: Record<string, TagDisplay>;
  /** Cards that link to this one via a card-backed tag (see card-identity.ts's computeRelatedCardsIndex) — the "Cards about this" section. */
  relatedCards?: BrowseCardData[];
  /** Cards this one points at via its own card-backed tags (computeSubjectCardsIndex) — the "This is about" section. Same tags as the masthead chips, re-listed as previews. */
  subjectCards?: BrowseCardData[];
  /** The card's RESOLVED tags (folder-derived + cascade + frontmatter + generated), from `ResolvedCard.tags`. Not `entry.data.tags`, which is frontmatter only and omits the card's own folder category. */
  cardTags?: string[];
  /** `ResolvedCard.date` — the card's date, if it has one (most do). */
  date?: Date;
  /** `ResolvedCard.dateLabel` — what that date *means*, and the switch for showing it at all. Absent → no dateline. */
  dateLabel?: string;
  /** `ResolvedCard.gallery` — `false` suppresses the gallery strip. Default true. */
  gallery?: boolean;
}

// Cast is load-bearing: Astro's props-type extraction falls back to
// Record<string, any> for a Props interface with a Record<…> member (tagDisplay),
// leaving Astro.props untyped — `as Props` restores the real prop types.
const { entry, Content, tagDisplay = {}, relatedCards = [], subjectCards = [], cardTags = [], date, dateLabel, gallery = true } = Astro.props as Props;
const data = entry?.data;

// Whether this card is a dated thing, and how its date is worded — decided by
// resolveDateline (card-date.ts) from the cascaded `dateLabel`, since nearly
// every card carries a `date` and presence alone would show it everywhere.
const dateline = resolveDateline(dateLabel, date);

const localImage = entry ? resolveLocalImage(entry.id, data?.image) : undefined;
// A header `image:` that points to a colocated video renders as <video>.
const localVideo = entry && !localImage ? resolveLocalVideo(entry.id, data?.image) : undefined;
const remoteImageSrc = !localImage && !localVideo && data?.image?.startsWith('http') ? data.image : undefined;

const sourceLabel = data?.source
  ? data.source.charAt(0).toUpperCase() + data.source.slice(1)
  : undefined;

// Credits/facts, with the legacy `medium:` shorthand folded in — see card-meta.ts.
const metaRows = resolveMetaRows(data);

// Authored `actions:` plus the named URL fields that fold in as actions — see
// resolveActions (card-actions.ts). Never filtered or reordered here.
const actions = resolveActions(data);
const quotes = data?.quotes?.filter((q: Quote) => q.quote) ?? [];

// Same chip rule as every listing (computeCardTagDisplay) so a card's tags read
// identically on its own masthead and in a browse result — including dropping
// the date-derived `when:` tag. No filter state here (a single card is never a
// filtered view) and no cap: the masthead is the card's own header and has room
// for the full set, where a condensed preview does not.
const tags = computeCardTagDisplay(cardTags, {}, Infinity).tags.map(chip => chip.value);

const hasInlineImages = bodyHasInlineImage(entry?.body);

const hasHeaderMedia = Boolean(remoteImageSrc || localImage || localVideo);
const hasMasthead = tags.length > 0 || actions.length > 0;

const gallerySources = entry && gallery
  ? resolveGalleryImages(entry.id, data?.image, data?.images, entry.body)
  : [];
const galleryImages = await Promise.all(
  gallerySources.map(async ({ src, kind, poster }) => {
    // An embed's `full` is the iframe URL and its `thumb` is the provider
    // poster, which may not exist (Vimeo without a generated poster) — the
    // gallery falls back to a labelled tile.
    if (kind === 'embed') return { thumb: poster ?? '', full: src as string, kind };
    // Videos and remote images are plain URL strings — only local images (ImageMetadata) go through astro:assets.
    if (kind === 'video' || typeof src === 'string') return { thumb: src as string, full: src as string, kind };
    const [thumb, full] = await Promise.all([
      getImage({ src, width: 200 }),
      getImage({ src, width: 1600 }),
    ]);
    return { thumb: thumb.src, full: full.src, kind };
  })
);
---

{data && (
  <>
    {/* Full-bleed masthead: the header image and the tags/actions band are the
        top edge of the card, so one wrapper cancels the body's inset for both
        rather than each element redoing the margin maths. */}
    {(hasHeaderMedia || hasMasthead) && (
      <div class="generic-bleed">
        {remoteImageSrc && <img src={remoteImageSrc} alt="" class="generic-image" />}
        {localImage && <Image src={localImage} alt="" class="generic-image" />}
        {localVideo && <video src={localVideo} class="generic-video" controls preload="metadata"></video>}

        {hasMasthead && (
          <div class="generic-masthead">
            {tags.length > 0 && (
              <ul class="generic-tags" aria-label="Tags">
                {tags.map((tag: string) => {
                  const info = displayFor(tag, tagDisplay);
                  return info.cardUid ? (
                    <li><a href={`/card/${info.cardUid}`} data-push-card={info.cardUid} class="generic-tag">{info.name}</a></li>
                  ) : (
                    <li><a href={`tag:${tag}`} class="generic-tag">{info.name}</a></li>
                  );
                })}
              </ul>
            )}

            {actions.length > 0 && (
              <div class="generic-actions">
                {actions.map((a: Action) => (
                  <a href={a.url} target="_blank" rel="noopener noreferrer" class="generic-action-link">{a.text}</a>
                ))}
              </div>
            )}
          </div>
        )}
      </div>
    )}

    {/* A byline, not a credit row: it opens the body as a line of prose above
        everything else, rather than joining the labelled `.generic-meta` facts.
        The date is the reader-facing fact; the label just words it. */}
    {dateline && (
      <p class="generic-dateline">
        {dateline.label}{' '}<time datetime={dateline.iso}>{dateline.text}</time>
      </p>
    )}

    {/* Credits lead the body: the labels are self-describing, so the list needs
        no heading of its own to be read as facts-about-the-thing. */}
    {metaRows.length > 0 && (
      <dl class="generic-meta">
        {metaRows.map((row) => (
          <>
            <dt>{row.label}</dt>
            <dd>
              {row.items.map((item, i) => (
                <>
                  {i > 0 && <br />}
                  {item.url
                    ? <a href={item.url} target="_blank" rel="noopener noreferrer">{item.text}</a>
                    : item.ariaLabel
                      ? <span role="img" aria-label={item.ariaLabel}>{item.text}</span>
                      : item.text}
                </>
              ))}
            </dd>
          </>
        ))}
      </dl>
    )}

    {data.canonical_url && (
      <p class="generic-source-note">
        Originally published{sourceLabel ? ` on ${sourceLabel}` : ''}
        {' '}<a href={data.canonical_url} target="_blank" rel="noopener noreferrer">↗</a>
      </p>
    )}

    {Content
      ? <Content />
      : data.description
        ? <p>{data.description}</p>
        : null}

    {galleryImages.length > 0 && <ImageGallery images={galleryImages} client:load />}

    {/* No UI of its own — it makes the images the body rendered inline openable
        full-screen. Mounted only when the markdown actually has one, so the
        island isn't shipped to the ~250 cards with none. */}
    {hasInlineImages && <InlineImageViewer client:load />}

    {/* Grouped and labelled so press reviews read as a different class of thing
        from a blockquote the body itself uses. */}
    {quotes.length > 0 && (
      <section class="generic-section">
        <h3 class="generic-section-heading">Press</h3>
        <ul class="generic-quotes">
          {quotes.map((q: Quote) => (
            <li>
              <blockquote class="generic-quote">{q.quote}</blockquote>
              {(q.by || q.in) && (
                <p class="generic-quote-attribution">
                  {q.by}
                  {q.by && q.in && ', '}
                  {q.in && <a href={q.in.url} target="_blank" rel="noopener noreferrer">{q.in.text}</a>}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* The two directions of a card-backed tag, named so the arrow is obvious:
        this card's own tags point out, other cards' tags point in. */}
    {subjectCards.length > 0 && (
      <section class="generic-section">
        <h3 class="generic-section-heading">This is about</h3>
        <CardStrip cards={subjectCards} {tagDisplay} label="Cards this is about" client:load />
      </section>
    )}

    {relatedCards.length > 0 && (
      <section class="generic-section generic-related">
        <h3 class="generic-section-heading">Cards about this</h3>
        <CardStrip cards={relatedCards} {tagDisplay} label="Cards about this" client:load />
      </section>
    )}
  </>
)}
