---
import type { RenderResult } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { resolveLocalImage, resolveGalleryImages } from '../../lib/images';
import ImageGallery from '../ImageGallery.svelte';

interface Action {
  text: string;
  url: string;
}

interface Quote {
  quote: string;
  by?: string;
  in?: { text: string; url: string };
}

interface Props {
  entry: {
    id: string;
    data: {
      description?: string;
      image?: string;
      status?: string;
      medium?: string;
      canonical_url?: string;
      source?: string;
      actions?: Action[];
      quotes?: Quote[];
      images?: string[];
      tags?: string[];
    };
  } | undefined;
  Content: RenderResult['Content'] | undefined;
}

const { entry, Content } = Astro.props;
const data = entry?.data;

const localImage = entry ? resolveLocalImage(entry.id, data?.image) : undefined;
const remoteImageSrc = !localImage && data?.image?.startsWith('http') ? data.image : undefined;

const sourceLabel = data?.source
  ? data.source.charAt(0).toUpperCase() + data.source.slice(1)
  : undefined;

const actions = data?.actions?.filter(a => a.text && a.url) ?? [];
const quotes = data?.quotes?.filter(q => q.quote) ?? [];
const tags = data?.tags ?? [];

const gallerySources = entry ? resolveGalleryImages(entry.id, data?.image, data?.images) : [];
const galleryImages = await Promise.all(
  gallerySources.map(async ({ src }) => {
    if (typeof src === 'string') return { thumb: src, full: src };
    const [thumb, full] = await Promise.all([
      getImage({ src, width: 200 }),
      getImage({ src, width: 1600 }),
    ]);
    return { thumb: thumb.src, full: full.src };
  })
);
---

{data && (
  <>
    {remoteImageSrc && <img src={remoteImageSrc} alt="" class="generic-image" />}
    {localImage && <Image src={localImage} alt="" class="generic-image" />}

    {(data.status || data.medium) && (
      <dl class="generic-meta">
        {data.status && <><dt>Status</dt><dd>{data.status}</dd></>}
        {data.medium && <><dt>Medium</dt><dd>{data.medium}</dd></>}
      </dl>
    )}

    {data.canonical_url && (
      <p class="generic-source-note">
        Originally published{sourceLabel ? ` on ${sourceLabel}` : ''}
        {' '}<a href={data.canonical_url} target="_blank" rel="noopener noreferrer">↗</a>
      </p>
    )}

    {Content
      ? <Content />
      : data.description
        ? <p>{data.description}</p>
        : null}

    {galleryImages.length > 0 && <ImageGallery images={galleryImages} client:load />}

    {quotes.length > 0 && (
      <ul class="generic-quotes">
        {quotes.map(q => (
          <li>
            <blockquote class="generic-quote">{q.quote}</blockquote>
            {(q.by || q.in) && (
              <p class="generic-quote-attribution">
                {q.by}
                {q.by && q.in && ', '}
                {q.in && <a href={q.in.url} target="_blank" rel="noopener noreferrer">{q.in.text}</a>}
              </p>
            )}
          </li>
        ))}
      </ul>
    )}

    {actions.length > 0 && (
      <div class="generic-actions">
        {actions.map(a => (
          <a href={a.url} target="_blank" rel="noopener noreferrer" class="generic-action-link">{a.text}</a>
        ))}
      </div>
    )}

    {tags.length > 0 && (
      <ul class="generic-tags" aria-label="Tags">
        {tags.map(tag => (
          <li><a href={`tag:${tag}`} class="generic-tag">{tag}</a></li>
        ))}
      </ul>
    )}
  </>
)}
