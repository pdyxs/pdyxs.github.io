---
import { getAllCards, getCardsForTag } from '../../lib/cards';

interface Props {
  entry: {
    id: string;
    data: {
      name: string;
      description?: string;
      aliases: string[];
    };
  } | undefined;
  Content: unknown;
}

const { entry } = Astro.props;
if (!entry) return;

const allCards = await getAllCards();
const matching = getCardsForTag(entry, allCards);
---

{entry.data.description && <p class="tag-description">{entry.data.description}</p>}
{matching.length > 0 ? (
  <ul class="card-listing">
    {matching.map(card => (
      <li class="card-listing-item" data-push-card={card.uid}>
        <div class="card-listing-header">
          <p class="card-listing-title">{card.title}</p>
          {card.date && <time class="card-listing-date" datetime={card.date.toISOString()}>{card.date.toLocaleDateString('en-AU', { year: 'numeric', month: 'short', day: 'numeric' })}</time>}
        </div>
        {card.description && <p class="card-listing-desc">{card.description}</p>}
      </li>
    ))}
  </ul>
) : (
  <p>No items tagged with this yet.</p>
)}
