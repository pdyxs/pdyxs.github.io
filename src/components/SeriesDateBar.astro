---
// The calendar-style date bar from the old site's trip-story pages (a
// Bootstrap carousel with a day-of-month row above it, the active day
// highlighted) — ported as a static CSS grid instead of a <table>, matching
// the site's dither/`--color-selected-*` tokens rather than reproducing
// Bootstrap's own styling. See computeSeriesDateBar (src/lib/series.ts) for
// the data this renders — one column per day the trip spanned, gaps included.
import type { SeriesDateBar as SeriesDateBarModel } from '../lib/series';

interface Props {
  bar: SeriesDateBarModel;
}

const { bar } = Astro.props;
---

<div class="series-date-bar" style={`--series-date-bar-cols: ${bar.cells.length}`}>
  <div class="series-date-bar-months" role="presentation">
    {bar.months.map(m => (
      <span class="series-date-bar-month" style={`grid-column: span ${m.span}`}>{m.label}</span>
    ))}
  </div>
  <ol class="series-date-bar-days" aria-label="Trip date">
    {bar.cells.map(cell => (
      <li class="series-date-bar-cell" class:list={{ 'series-date-bar-cell--active': cell.active }}>
        {cell.uid ? (
          <a class="series-date-bar-day card-link" href={`/card/${cell.uid}`} data-replace-slot={cell.uid}>{cell.day}</a>
        ) : (
          <span class="series-date-bar-day" aria-current={cell.active ? 'true' : undefined}>{cell.day}</span>
        )}
      </li>
    ))}
  </ol>
</div>

{/* No scoped <style>: this markup ships inside a card FRAGMENT, which is
    injected into whatever page the visitor is already on, and Astro only
    bundles a component's scoped CSS into pages that render it at build time —
    so on a lens page the rules simply wouldn't exist. `.series-date-bar*`
    lives in global.css, beside .series-floating-* for the same reason. */}
