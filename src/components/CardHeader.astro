---
interface Props {
  title: string;
  titleSuffix?: string;
}
const { title, titleSuffix } = Astro.props;
---
<div class="card-header">
  <span class="card-header-title"><b>{title}</b>{titleSuffix}</span>
  <slot />
</div>

<style>
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--color-text);
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 18px,
      var(--color-bg-stripes) 19px,
      var(--color-bg-stripes) 20px
    );
    user-select: none;
  }

  .card-header-title,
  :global(.card-header > *) {
    background: var(--color-surface);
    padding: 0 2px;
  }

  :global(.stack-card--collapsed) .card-header {
    font-size: 0.75em;
    padding: var(--space-xs) var(--space-lg);
    background: var(--color-surface);
  }

  :global(.stack-card--collapsed) .card-header-title,
  :global(.stack-card--collapsed .card-header > *) {
    background: none;
    padding: 0;
  }
</style>
