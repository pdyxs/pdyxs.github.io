---
// The suspended mark: the full stop in the site title, drawn as a dot hanging
// from five threads tied to the letters around it (src/data/mark-rig.ts).
// Mounted once, in Base.astro, outside #card-stack. The build plan is
// docs/plans/suspended-mark.md; /experiments/suspended-dot is its tuning bench.
//
// What it does so far (slice 6): in page mode it draws over the title's
// `.page-title-mark` slot, and clicking the dot pulls the threads taut and lets
// them go. When the page header leaves (page → card) the title rises, grows
// and drifts to the centre line, and the dot is caught at the top edge and
// hangs there for as long as the stack is in card mode; the way back reverses
// it. Where there is no title to leave (a cold load of a card, a deep link, a
// page with no stack) the dot hangs from the start: the server draws that pose
// (`.site-mark-hang`, laid out by src/lib/site/mark/hang.ts and sized in CSS)
// so it is there before any script runs, and the script takes over drawing the
// same picture. Both are sized by `--mark-hang-em` / `--mark-hang-size`
// (tokens.css), and so is the hang after an exit.
//
// It learns the mode from `site:presentation` (src/lib/site/presentation-event.ts),
// which CardStack.svelte announces, with the View Transition when there is one.
// It never mutates the stack. It reads the geometry of the one visible
// page-mode title, names that title and subtitle for a transition through a
// state attribute on <html> (see the CSS), and on the one close that has no
// transition animates the live title's transform (see `#returnLive`).
//
// Clicking the dot opens the tools (slice 7): the threads that carry one pull
// taut, and on the release each tool drops on a string of its own. Every tool
// is drawn the same way, from its config (src/data/mark-tools.ts, the `tools`
// prop); what a tool DOES is its behaviour, looked up by key in the registry
// (src/lib/site/mark-tools/index.ts). This file knows nothing else about any
// tool, and mark/boundary.test.ts keeps it that way. With no tools configured
// the click is still the slice-4 tug, and the hit button stays decorative.
//
// A self-contained custom element, like PalettePicker.astro. The motion and
// the posing are pure, in src/lib/site/mark/; this file reads the page and
// writes the SVG.
import { MARK_RIG } from '@data/mark-rig';
import { MARK_TOOLS, type ToolConfig } from '@data/mark-tools';
import { MIN_STROKE } from '@site/mark/geometry';
import { HANG_UNITS, hangMarkup } from '@site/mark/hang';
import { HANG_Y } from '@site/mark/motion';
import MarkTool from '@components/site/MarkTool.astro';

interface Props {
  /** The tools that drop from the dot. Production takes MARK_TOOLS; a dev bench passes its own. */
  tools?: ToolConfig[];
}

const { tools = MARK_TOOLS } = Astro.props;
const hasTools = tools.length > 0;

// The hanging pose, in 1/HANG_UNITS em about the dot's resting centre. CSS
// scales the viewBox by --mark-hang-em and puts that centre at the top-centre
// of the screen, so nothing about it needs measuring.
const hang = hangMarkup(MARK_RIG);
const em = (n: number) => +(n / HANG_UNITS).toFixed(4);
const hangStyle = [
  `--hang-x: ${em(hang.box.x)}`,
  `--hang-y: ${em(hang.box.y)}`,
  `--hang-w: ${em(hang.box.width)}`,
  `--hang-h: ${em(hang.box.height)}`,
  `--hang-top: ${HANG_Y}px`,
  `--hang-stroke-em: ${MARK_RIG.width}`,
  `--hang-stroke-min: ${MIN_STROKE}px`,
].join('; ');
const n = (v: number) => +v.toFixed(2);
---

<site-mark data-mode="card">
  {/* The hanging pose as the server draws it, for the first paint of a page
      that loads in card mode (html[data-cold-presentation="card"], Base.astro),
      and for good without JS. Retired the moment the script draws the live
      overlay (html[data-mark-ready]), which draws the same picture. */}
  <svg
    class="site-mark-hang"
    viewBox={`${hang.box.x} ${hang.box.y} ${hang.box.width} ${hang.box.height}`}
    style={hangStyle}
    aria-hidden="true"
    focusable="false"
  >
    <g class="site-mark-threads">
      {hang.paths.map((d) => <path d={d}></path>)}
    </g>
    <rect class="site-mark-dot" x={n(hang.dot.x)} y={n(hang.dot.y)} width={n(hang.dot.size)} height={n(hang.dot.size)}></rect>
  </svg>
  {/* With tools, the overlay holds their baubles, so only the threads and the
      dot are hidden from assistive tech; with none, all of it is. */}
  <svg class="site-mark-overlay" aria-hidden={hasTools ? undefined : 'true'} focusable="false">
    <g class="site-mark-threads" aria-hidden={hasTools ? 'true' : undefined}>
      {MARK_RIG.threads.map(() => <path></path>)}
    </g>
    <rect class="site-mark-dot" aria-hidden={hasTools ? 'true' : undefined}></rect>
    {hasTools && (
      <g class="site-mark-tools" id="site-mark-tools" role="group" aria-label="Tools">
        {tools.map((tool) => <MarkTool tool={tool} />)}
      </g>
    )}
  </svg>
  {/* The "Tools" button when there are tools to open. With none (production
      until the palette lands) a click only tugs the threads, so it stays
      decorative: out of the tab order and hidden from assistive tech. */}
  {hasTools ? (
    <button type="button" class="site-mark-hit" aria-label="Tools" aria-expanded="false" aria-controls="site-mark-tools"></button>
  ) : (
    <button type="button" class="site-mark-hit" tabindex="-1" aria-hidden="true"></button>
  )}
  {/* Lays out a full stop in the title's font so the engine itself says where
      the baseline sits in the slot's box (an empty inline-block's bottom edge is
      the baseline). See src/lib/site/mark/measure.ts. */}
  <span class="site-mark-probe" aria-hidden="true"><span class="site-mark-probe-text">.<span class="site-mark-probe-base"></span></span></span>
  {/* Resolves the hang's two tokens to px for the script: width is
      --mark-hang-size, height --mark-hang-em. */}
  <span class="site-mark-hang-probe" aria-hidden="true"></span>
</site-mark>

<style>
  /* No box of its own: the overlay and the hit target position themselves. */
  site-mark {
    display: contents;
    /* Read back by the script: 0 means nothing animates (the tug, the exit). */
    --site-mark-motion: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    site-mark {
      --site-mark-motion: 0;
    }
  }

  /* On the viewport by default, which is where it hangs in card mode, so
     scrolling a card never moves it. At rest in the title it lives in the
     document instead (`data-overlay="doc"`), so it scrolls natively with the
     text: a redraw on scroll would trail it by a frame. A sibling of the page,
     never an ancestor of anything dithered (styling.md). */
  .site-mark-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: var(--z-mark);
  }
  site-mark[data-overlay='doc'] .site-mark-overlay,
  site-mark[data-overlay='doc'] .site-mark-hit {
    position: absolute;
  }

  .site-mark-threads path {
    fill: none;
    stroke: var(--color-text);
    stroke-linecap: round;
  }
  .site-mark-dot {
    fill: var(--color-text);
  }

  /* The server's hanging pose. Shown only on a page that loads in card mode,
     and only until the script draws (html[data-mark-ready]): from then on the
     live overlay draws the same pose, so there is nothing to swap visibly. On
     a page that loads in page mode it never shows, so the dot can't flash at
     the top before the title is measured. The viewBox's (0, 0) is the dot's
     centre; this box puts it at the top-centre of the screen, scaled by the
     hang's em. The stroke is in screen px (non-scaling), the width the
     script draws: the rig's, in em, never under the minimum. */
  .site-mark-hang {
    display: none;
    position: fixed;
    left: calc(50% + var(--mark-hang-em) * var(--hang-x));
    top: calc(var(--hang-top) + var(--mark-hang-em) * var(--hang-y));
    width: calc(var(--mark-hang-em) * var(--hang-w));
    height: calc(var(--mark-hang-em) * var(--hang-h));
    overflow: visible;
    pointer-events: none;
    z-index: var(--z-mark);
  }
  :global(html[data-cold-presentation='card']:not([data-mark-ready])) .site-mark-hang {
    display: block;
  }
  .site-mark-hang path {
    stroke-width: max(var(--hang-stroke-min), calc(var(--mark-hang-em) * var(--hang-stroke-em)));
    vector-effect: non-scaling-stroke;
  }

  .site-mark-hang-probe {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--mark-hang-size);
    height: var(--mark-hang-em);
    visibility: hidden;
    pointer-events: none;
  }

  /* Centred on the dot, never smaller than --mark-hit-min. The script writes
     the dot's centre and size; the sizing is decided here. */
  .site-mark-hit {
    --site-mark-hit-size: max(var(--mark-hit-min), calc(var(--site-mark-size, 0px) * 1.6));
    position: fixed;
    z-index: calc(var(--z-mark) + 1);
    left: calc(var(--site-mark-x, 0px) - var(--site-mark-hit-size) / 2);
    top: calc(var(--site-mark-y, 0px) - var(--site-mark-hit-size) / 2);
    width: var(--site-mark-hit-size);
    height: var(--site-mark-hit-size);
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    touch-action: manipulation;
  }
  :global(html:not([data-mark-ready])) .site-mark-hit {
    display: none;
  }

  .site-mark-hit:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  /* ── Tools ──────────────────────────────────────────────────────
     Their markup is MarkTool.astro's (and the icons' are set as HTML), so
     these reach it from the overlay with :global. A tool is drawn only while
     it hangs (`data-open`, set and cleared by the script); a child is nested
     in its parent, so it can't show without it. Positions are the script's:
     a transform on the bauble, the SVG child of a sibling of the page. */
  .site-mark-overlay :global(.site-mark-tool:not([data-open])) {
    display: none;
  }
  .site-mark-overlay :global(.site-mark-tool-string) {
    stroke: var(--color-text);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .site-mark-overlay :global(.site-mark-bauble) {
    pointer-events: auto;
    cursor: pointer;
    touch-action: none;
    outline: none;
  }
  .site-mark-overlay :global(.site-mark-bauble[data-kind='drag']) {
    cursor: grab;
  }
  .site-mark-overlay :global(.site-mark-bauble[data-dragging]) {
    cursor: grabbing;
  }
  /* The hit target: the body, or --mark-hit-min across, whichever is bigger.
     --site-mark-tool-r is the configured radius, inline from MarkTool. */
  .site-mark-overlay :global(.site-mark-bauble-hit) {
    r: max(calc(var(--mark-hit-min) / 2), var(--site-mark-tool-r));
    fill: transparent;
  }
  .site-mark-overlay :global(.site-mark-bauble-body) {
    fill: var(--color-bg);
    stroke: var(--color-text);
    stroke-width: 2.5;
  }
  .site-mark-overlay :global(.site-mark-bauble:focus-visible .site-mark-bauble-body) {
    stroke-width: 4;
  }
  .site-mark-overlay :global(.site-mark-icon-ink) {
    fill: var(--color-text);
  }
  .site-mark-overlay :global(.site-mark-icon-paper) {
    fill: var(--color-bg);
  }

  .site-mark-probe {
    position: absolute;
    left: 0;
    top: 0;
    visibility: hidden;
    pointer-events: none;
    white-space: nowrap;
  }
  .site-mark-probe-base {
    display: inline-block;
    width: 0;
    height: 0;
  }

  /* The title's full stop keeps its advance and kerning, but once the mark has
     drawn, the mark is what shows. Until then (and without JS) it is just text. */
  :global(html[data-mark-ready] .page-title-mark) {
    color: transparent;
  }

  /* ── The page ↔ card View Transition ─────────────────────────────

     The mark's three names. They are not written onto the elements: the mark
     sets `html[data-mark-vt]` when CardStack announces a transition (before
     the old state is captured) and removes it on `finished`, and these rules
     do the naming. That is what lets the RETURNING title be named in the new
     state: the mark has no hook inside CardStack's update callback, and by the
     time `updateCallbackDone` settles the browser has already captured the new
     state (the spec resolves it in the same step that captures). A selector
     names whatever is laid out at each capture instead: the page-mode title is
     on the old side going to a card and on the new side coming back, and on
     neither side twice, because only the sole entry is ever `stack-card--page`.

     `title`: the overlay, the title and the subtitle. `mark` (reduced motion):
     the overlay only, so the title swaps with the root, at once. */
  :global(html[data-mark-vt]) .site-mark-overlay {
    view-transition-name: site-mark;
  }
  :global(html[data-mark-vt='title'] .stack-card--page > .page-header .page-title) {
    view-transition-name: page-title;
  }
  :global(html[data-mark-vt='title'] .stack-card--page > .page-header .page-subtitle) {
    view-transition-name: page-subtitle;
  }
</style>

<style is:global>
  /* The pseudos for the names above. With the mark, not with the stack's VT
     rules in layout.css: these are the mark's names, set and animated by its
     script, and CardStack never sees them. (cssCodeSplit is off, so this sheet
     is on every page either way.)

     The overlay renders live through the transition: no old image, and the new
     one (a live view of the SVG the rAF loop is drawing) neither fades nor
     moves. Above the title and subtitle, which on a return are new-only and so
     would otherwise stack after it. */
  ::view-transition-old(site-mark) {
    display: none;
  }
  ::view-transition-new(site-mark),
  ::view-transition-group(site-mark) {
    animation: none;
  }
  ::view-transition-group(site-mark) {
    z-index: 2;
  }
  /* The title and subtitle have one side only (old leaving, new returning), so
     the UA gives them no group morph, only a fade on the image. No fade: the
     script moves the image with keyframes sampled from titleExit. Over the
     morphing rule (`page-rule`, layout.css), which has no z-index. */
  ::view-transition-old(page-title),
  ::view-transition-new(page-title),
  ::view-transition-old(page-subtitle),
  ::view-transition-new(page-subtitle) {
    animation: none;
  }
  ::view-transition-group(page-title),
  ::view-transition-group(page-subtitle) {
    z-index: 1;
  }
</style>

<script>
  import { MARK_RIG } from '@data/mark-rig';
  import {
    DROP,
    REEL,
    baubleAt,
    baubleMoving,
    baublePos,
    poseThreads,
    stepBauble,
    threadPathData,
    threadStroke,
    tauten,
    toolPivot,
    type Bauble,
    type V,
  } from '@site/mark/geometry';
  import {
    DOT_AT_REST,
    REST,
    clamp01,
    TITLE_EXIT_MS,
    TOOLS_CLOSED,
    dotMoving,
    hangSeparation,
    lapseTug,
    poseBlend,
    setWant,
    stepDot,
    stepToolSize,
    stepTools,
    subStep,
    tautness,
    toolReeledIn,
    titleExit,
    titleExitKeyframes,
    type DotState,
    type Spring,
    type TitleStart,
    type ToolsState,
    type Viewport,
  } from '@site/mark/motion';
  import { caughtDot, exitTime, slotSource } from '@site/mark/exit';
  import { HANG_DEPTH, anchorSlot, grownDot, hangSlot, type HangMetrics } from '@site/mark/hang';
  import { FALLBACK_DOT_INK, dotInSlot, inkBounds, inkEm, plausibleDotInk, type InkEm, type SlotDot } from '@site/mark/measure';
  import { PRESENTATION_EVENT, coldPresentation, currentPresentation, type Presentation, type PresentationDetail } from '@site/presentation-event';
  import {
    childPivot,
    focusFallback,
    focusOrder,
    isTug,
    tautThreads,
    toolLength,
    visibleTools,
    type ToolNode,
  } from '@site/mark/tools';
  import { toolBehaviour, type ToolBehaviour, type ViewportPoint } from '@site/mark-tools';

  /** The one place the mark looks into the page: the page-mode title's full stop. */
  const SLOT_SELECTOR = '.stack-card--page .page-title-mark';
  /** How many frames to keep looking for the slot after a switch to page mode. */
  const SLOT_RETRIES = 10;
  /** The size the full stop is drawn at to scan its ink, px. */
  const SCAN_PX = 200;

  /** Scanned ink boxes, per font (family, weight, style): one scan serves every size. */
  const inkCache = new Map<string, InkEm>();

  /**
   * The full stop's ink in `cs`'s font, scanned from an offscreen canvas
   * (measure.ts says why not measureText). Falls back to the Chromium-measured
   * box when the font isn't usable in canvas or the scan isn't a full stop.
   */
  function scanInk(cs: CSSStyleDeclaration): { ink: InkEm; scanned: boolean } {
    const key = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontFamily}`;
    const hit = inkCache.get(key);
    if (hit) return { ink: hit, scanned: true };
    const font = `${cs.fontStyle} ${cs.fontWeight} ${SCAN_PX}px ${cs.fontFamily}`;
    const side = SCAN_PX * 2;
    const canvas = document.createElement('canvas');
    canvas.width = canvas.height = side;
    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    if (!ctx || !document.fonts.check(font, '.')) return { ink: FALLBACK_DOT_INK, scanned: false };
    ctx.font = font;
    ctx.textBaseline = 'alphabetic';
    // Any opaque colour: only the alpha channel is read.
    ctx.fillStyle = 'black';
    const origin = { x: SCAN_PX / 2, y: SCAN_PX * 1.5 };
    ctx.fillText('.', origin.x, origin.y);
    const box = inkBounds(ctx.getImageData(0, 0, side, side).data, side, side);
    const ink = box ? inkEm(box, origin, SCAN_PX) : null;
    if (!ink || !plausibleDotInk(ink)) return { ink: FALLBACK_DOT_INK, scanned: false };
    inkCache.set(key, ink);
    return { ink, scanned: true };
  }

  /** The dot measured off a slot at rest: its size and centre in the slot's box, the font size, the slot's width. */
  type Measured = SlotDot & { em: number; slotW: number };

  /**
   * The title's exit (or return) in flight.
   *  - `vt`: over a View Transition. Only the snapshots move, so the slot is
   *    `titleExit` at the title snapshot's own clock.
   *  - `live`: the trim close back onto a page, which has no transition. The
   *    live title and subtitle are animated, and the slot is read off them.
   *  - `instant`: a View Transition under reduced motion. Nothing animates;
   *    the overlay is named only so the dot jumps to its end state live.
   */
  interface Run {
    kind: 'vt' | 'live' | 'instant';
    direction: 'leave' | 'return';
    /** Where the title starts from at rest. A return measures it once the new state is laid out. */
    start: TitleStart | null;
    viewport: Viewport;
    /** The title's animation, whose clock the dot samples; null until `ready`. */
    clock: Animation | null;
    anims: Animation[];
    /** Whether the header has a subtitle to move, read while it is laid out. */
    subtitle: boolean;
  }

  /** Whether the header `slot`'s title is in has a subtitle. */
  const hasSubtitle = (slot: HTMLElement) => !!slot.closest('.page-header')?.querySelector('.page-subtitle');

  /** The current layout viewport: the box the fixed overlay covers, scrollbar excluded. */
  const viewportNow = (): Viewport => ({
    width: document.documentElement.clientWidth,
    height: document.documentElement.clientHeight,
  });

  /**
   * One tool as the mark drives it: its config (read off MarkTool's markup),
   * its parts, and its motion. What it does is its behaviour, looked up by key.
   */
  interface Tool extends ToolNode {
    el: SVGGElement;
    /** The string, drawn (its length paid out is `string`, from the config). */
    line: SVGLineElement;
    bauble: SVGGElement;
    /** The string and swing, about its pivot (geometry.ts). */
    b: Bauble;
    /** Its size, 0..1: grows out of the pivot as it falls, shrinks back as it is reeled in. */
    s: Spring;
    /** Where its bauble was last drawn, overlay coords, and at what scale: a child's pivot. */
    at: V | null;
    scale: number;
    /** The pointer, viewport coords, while the bauble is dragged, and which pointer. */
    pointer: V | null;
    dragId: number | null;
  }

  /** A tool's config, as MarkTool.astro wrote it into the markup. Document order is depth-first. */
  function readTool(el: SVGGElement): Tool {
    const d = el.dataset;
    return {
      id: d.tool!,
      behaviour: d.behaviour!,
      thread: d.thread === undefined ? null : +d.thread,
      parent: d.parent ?? null,
      string: +d.string!,
      radius: +d.radius!,
      icon: '',
      label: el.querySelector(':scope > .site-mark-bauble')?.getAttribute('aria-label') ?? '',
      el,
      line: el.querySelector(':scope > .site-mark-tool-string')!,
      bauble: el.querySelector(':scope > .site-mark-bauble')!,
      b: { r: 0, rv: 0, theta: 0, omega: 0 },
      s: REST,
      at: null,
      scale: 0,
      pointer: null,
      dragId: null,
    };
  }

  /** A swing as it falls, rad/s, so it never drops dead straight. */
  const DROP_KICK = 0.9;

  class SiteMark extends HTMLElement {
    #overlay!: SVGSVGElement;
    #paths: SVGPathElement[] = [];
    #dot!: SVGRectElement;
    #hit!: HTMLButtonElement;
    #probeText!: HTMLElement;
    #probeBase!: HTMLElement;
    #hangProbe!: HTMLElement;

    #mode: Presentation | null = null;
    /**
     * `#mode` is the load-time seed, not yet anything the stack announced. A
     * first announcement that differs from it is a correction, not a change:
     * a lens deep link's stack announces `page` on mount and only then
     * restores the cards above it, and no title should come back down for it.
     */
    #seeded = false;
    /** The page-mode title slot, while one is laid out. */
    #slot: HTMLElement | null = null;
    /** The dot, measured off the slot at rest: where an exit starts from. */
    #measured: Measured | null = null;
    /** The last title start measured at rest. */
    #start: TitleStart | null = null;
    /** The hang's size and em, px, as the CSS tokens resolve now (`#readHang`). */
    #hang: HangMetrics | null = null;
    /** poseBlend's denominator, for #start. */
    #separation = 1;
    #run: Run | null = null;
    #state: DotState = DOT_AT_REST;
    #prevY: number | null = null;
    #fontsReady = false;
    /** The pull → release → rest machine (motion.ts): opening and closing the tools, or a tug. */
    #ts: ToolsState = TOOLS_CLOSED;
    /** The tools, read off the markup; none where none are configured. */
    #tools: Tool[] = [];
    #group: SVGGElement | null = null;
    /** The tools that hang (or are about to): decided on open, and again whenever a behaviour says `changed`. */
    #visible: ReadonlySet<string> = new Set();
    /** The pull in progress drops nothing, so it lapses (`lapseTug`). Always, with no tools. */
    #tug = true;
    /** The top-level tools whose threads take the pull in progress; null pulls every thread (a tug). */
    #pulled: ReadonlySet<string> | null = null;
    /** Unsubscribes from the behaviours' `changed`, while the tools are open. */
    #unsubscribe: (() => void)[] | null = null;
    /** Behaviour keys already reported missing. */
    #missing = new Set<string>();
    #frame = 0;
    #last = 0;
    #ro = new ResizeObserver(() => this.#relayout());

    connectedCallback() {
      // The live overlay's, not the server's hanging copy (.site-mark-hang),
      // which has the same parts and is only ever drawn by CSS.
      this.#overlay = this.querySelector('.site-mark-overlay')!;
      this.#paths = [...this.#overlay.querySelectorAll<SVGPathElement>('.site-mark-threads path')];
      this.#dot = this.#overlay.querySelector('.site-mark-dot')!;
      this.#hit = this.querySelector('.site-mark-hit')!;
      this.#probeText = this.querySelector('.site-mark-probe-text')!;
      this.#probeBase = this.querySelector('.site-mark-probe-base')!;
      this.#hangProbe = this.querySelector('.site-mark-hang-probe')!;
      this.#group = this.#overlay.querySelector('.site-mark-tools');
      this.#tools = [...this.#overlay.querySelectorAll<SVGGElement>('.site-mark-tool')].map(readTool);
      for (const t of this.#tools) this.#wireTool(t);

      document.addEventListener(PRESENTATION_EVENT, this.#onPresentation);
      document.addEventListener('keydown', this.#onKey);
      window.addEventListener('resize', this.#onResize);
      this.#hit.addEventListener('click', this.#onHit);
      // Nothing is drawn until the title's real font is in: until then the
      // title shows its own full stop, so there is nothing to flash.
      document.fonts.ready.then(() => {
        this.#fontsReady = true;
        this.#relayout();
      });
      // The stack may have announced before this script ran. If it hasn't
      // (or there is no stack to), start in the mode the page loaded in, which
      // is what the server and the pre-paint script drew: on a page with no
      // stack that is card mode, hanging, for good.
      const now = currentPresentation();
      if (now) return this.#present({ to: now, vt: null });
      const cold = coldPresentation();
      if (!cold) return;
      this.#present({ to: cold, vt: null });
      this.#seeded = true;
    }

    disconnectedCallback() {
      document.removeEventListener(PRESENTATION_EVENT, this.#onPresentation);
      document.removeEventListener('keydown', this.#onKey);
      window.removeEventListener('resize', this.#onResize);
      this.#hit.removeEventListener('click', this.#onHit);
      this.#unwatch();
      this.#endRun();
      this.#ro.disconnect();
      cancelAnimationFrame(this.#frame);
      this.#frame = 0;
      this.#setReady(false);
    }

    // ── Mode ───────────────────────────────────────────────────────

    #onPresentation = (e: CustomEvent<PresentationDetail>) => this.#present(e.detail);
    #onResize = () => this.#relayout();

    /** Reduced motion is decided in CSS (`--site-mark-motion`), and read back here. */
    #moves(): boolean {
      return getComputedStyle(this).getPropertyValue('--site-mark-motion').trim() !== '0';
    }

    #present({ to, vt }: PresentationDetail) {
      const from = this.#seeded ? null : this.#mode;
      if (this.#seeded && to === this.#mode && !vt) {
        this.#seeded = false;
        return;
      }
      this.#seeded = false;
      // Any change of presentation closes the tools (they reel in over it),
      // as the bench does.
      this.#setOpen(false);
      // A change while an exit is still running ends that exit first: its
      // names and animations never outlive it.
      this.#endRun();
      if (to === from && !vt) return;
      if (vt && !this.#moves()) return this.#instant(to, vt);
      if (to === 'card') this.#toCard(vt);
      else this.#toPage(vt, from === 'card');
    }

    #setMode(mode: Presentation) {
      this.#mode = mode;
      this.dataset.mode = mode;
    }

    /** At rest in the title the overlay is document-positioned; anything else is on the viewport. */
    #setAnchored(on: boolean) {
      if (on) this.dataset.overlay = 'doc';
      else delete this.dataset.overlay;
    }

    /**
     * Page → card. With `vt`, the title leaves over it. Without one it has
     * already gone, or there never was one (a cold load of a card, a page with
     * no stack), and the dot just hangs: the same pose the server drew, which
     * this draw replaces without a visible change.
     */
    #toCard(vt: ViewTransition | null) {
      // Read the title before anything changes: the stack hasn't run the
      // transition's update yet (it announces before the old capture), so
      // the page-mode title is still laid out.
      const slot = this.#findSlot();
      if (slot && this.#fontsReady) this.#restMeasure(slot);
      this.#ro.disconnect();
      this.#slot = null;
      this.#setMode('card');
      this.#setAnchored(false);
      this.#readHang();
      const start = this.#start;
      if (!vt || !slot || !start || !this.#measured) {
        this.#state = caughtDot(this.#state);
        this.#draw();
        this.#setReady(true);
        this.#wake();
        return;
      }
      const run: Run = { kind: 'vt', direction: 'leave', start, viewport: viewportNow(), clock: null, anims: [], subtitle: hasSubtitle(slot) };
      this.#begin(run, vt);
      // Hand the overlay to the viewport where the dot already is (t = 0),
      // before the old state is captured.
      this.#draw();
      vt.ready
        .then(() => this.#animateSnapshots(run, 'old'))
        .catch(() => { /* skipped: `finished` still settles */ });
    }

    /**
     * Card → page. With `vt`, the title comes back over it. Without one (the
     * trim close back onto a page already in the stack), the live title does.
     * `fromCard` is false for the first announcement, at load: nothing returns.
     */
    #toPage(vt: ViewTransition | null, fromCard: boolean) {
      this.#setMode('page');
      if (!vt) {
        const slot = this.#findSlot();
        if (fromCard && slot && this.#fontsReady && this.#moves()) return this.#returnLive(slot);
        this.#setAnchored(true);
        this.#attach();
        return;
      }
      // On the viewport for the whole transition, and caught at the edge for
      // the title to come back to: until the new title is measured, the dot
      // goes on hanging.
      this.#setAnchored(false);
      this.#readHang();
      this.#state = caughtDot(this.#state);
      const run: Run = { kind: 'vt', direction: 'return', start: null, viewport: viewportNow(), clock: null, anims: [], subtitle: false };
      this.#begin(run, vt);
      vt.updateCallbackDone
        .then(() => {
          // The new state is laid out: the title the dot is coming back to is
          // there, at rest (only its snapshot will move).
          if (this.#run !== run) return;
          const slot = this.#findSlot();
          if (!slot || !this.#fontsReady) return;
          this.#follow(slot);
          this.#restMeasure(slot);
          run.start = this.#start;
          run.subtitle = hasSubtitle(slot);
          this.#setReady(true);
        })
        .catch(() => {});
      vt.ready
        .then(() => this.#animateSnapshots(run, 'new'))
        .catch(() => {});
    }

    /**
     * Reduced motion: the stack's transition still runs (at 0ms), but nothing
     * here animates. Only the overlay is named, so it renders live, and the
     * dot is put straight into its end state once the new state is laid out.
     * The title is in the root snapshot and swaps with it.
     */
    #instant(to: Presentation, vt: ViewTransition) {
      const run: Run = { kind: 'instant', direction: to === 'card' ? 'leave' : 'return', start: null, viewport: viewportNow(), clock: null, anims: [], subtitle: false };
      // Going to a card, the title has to be measured now, while it is laid out.
      if (to === 'card') {
        const slot = this.#findSlot();
        if (slot && this.#fontsReady) this.#restMeasure(slot);
      }
      this.#begin(run, vt);
      vt.updateCallbackDone
        .then(() => {
          if (this.#run !== run) return;
          if (to === 'card') this.#toCard(null);
          else this.#toPage(null, false);
          this.#state = to === 'card' ? caughtDot(this.#state) : DOT_AT_REST;
          this.#draw();
        })
        .catch(() => {});
    }

    /**
     * The trim close: card → page with no View Transition. The stack's own
     * motion brings the page card back; the mark runs titleExit backwards on
     * the LIVE title and subtitle, transforms only (nothing in the page header
     * is dithered, so a transform there can't re-anchor the dither grid), and
     * reads the slot off the live title each frame, so the stack's motion and
     * any scroll are in it. The animation is cancelled when it ends: it changes
     * no structure, class or style attribute in the stack.
     */
    #returnLive(slot: HTMLElement) {
      this.#follow(slot);
      // Measured at rest, before the first keyframe moves it.
      this.#restMeasure(slot);
      const start = this.#start!;
      const header = slot.closest<HTMLElement>('.page-header');
      const title = slot.closest<HTMLElement>('.page-title');
      const subtitle = header?.querySelector<HTMLElement>('.page-subtitle') ?? null;
      this.#setAnchored(false);
      this.#state = caughtDot(this.#state);
      const viewport = viewportNow();
      const kf = titleExitKeyframes(start, viewport, { direction: 'return' });
      const opts = { duration: TITLE_EXIT_MS, fill: 'both' as const };
      const run: Run = { kind: 'live', direction: 'return', start, viewport, clock: null, anims: [], subtitle: !!subtitle };
      if (title) run.clock = title.animate(kf.title, opts);
      if (subtitle) run.anims.push(subtitle.animate(kf.subtitle, opts));
      if (run.clock) run.anims.push(run.clock);
      this.#run = run;
      this.#setReady(true);
      if (run.clock) run.clock.finished.then(() => this.#endRun(run), () => {});
      else this.#endRun(run);
      this.#wake();
    }

    /** Take on `run`, riding `vt`: the names go on now, and everything comes off with it. */
    #begin(run: Run, vt: ViewTransition) {
      this.#run = run;
      document.documentElement.dataset.markVt = run.kind === 'instant' ? 'mark' : 'title';
      vt.finished.finally(() => this.#endRun(run)).catch(() => {});
      if (run.kind === 'vt') this.#wake();
    }

    /**
     * Move the title and subtitle snapshots (the image, not the group: the
     * group's transform is what places it, and a one-sided group has no
     * animation of its own to override). Its clock is what the dot samples.
     */
    #animateSnapshots(run: Run, side: 'old' | 'new') {
      if (this.#run !== run || !run.start) return;
      const kf = titleExitKeyframes(run.start, run.viewport, { direction: run.direction });
      const opts = { duration: TITLE_EXIT_MS, fill: 'both' as const };
      const html = document.documentElement;
      run.clock = html.animate(kf.title, { ...opts, pseudoElement: `::view-transition-${side}(page-title)` });
      run.anims.push(run.clock);
      if (run.subtitle) {
        run.anims.push(html.animate(kf.subtitle, { ...opts, pseudoElement: `::view-transition-${side}(page-subtitle)` }));
      }
      this.#wake();
    }

    /**
     * End the run in flight (`run`, if given, only if it is still the one).
     * `fill: both` outlives the pseudo it targeted, and would apply its end
     * transform to the next transition's same-named pseudo, so every animation
     * is cancelled; and the names come off.
     */
    #endRun(run?: Run) {
      const r = this.#run;
      if (!r || (run && r !== run)) return;
      this.#run = null;
      for (const a of r.anims) a.cancel();
      delete document.documentElement.dataset.markVt;
      this.#prevY = null;
      // Back in the title, at rest: follow the live slot again.
      if (this.#mode === 'page') this.#attach();
      this.#wake();
    }

    // ── Finding and measuring the title ────────────────────────────

    /** The page-mode title's slot, if one is laid out. Only ever one shows. */
    #findSlot(): HTMLElement | null {
      return [...document.querySelectorAll<HTMLElement>(SLOT_SELECTOR)].find((el) => el.getClientRects().length > 0) ?? null;
    }

    /** Follow `slot`'s box: its own catches a font-size change, its header's the page's width. */
    #follow(slot: HTMLElement) {
      if (slot === this.#slot) return;
      this.#ro.disconnect();
      this.#slot = slot;
      this.#ro.observe(slot);
      const header = slot.closest('.page-header');
      if (header) this.#ro.observe(header);
    }

    /**
     * Find the slot and follow it. Announced from inside the stack's own
     * update, the slot is normally there already; when it isn't (a fragment
     * still landing), look again for a few frames.
     */
    #attach(tries = 0) {
      if (this.#mode !== 'page') return;
      const slot = this.#findSlot();
      if (!slot) {
        this.#setReady(false);
        if (tries < SLOT_RETRIES) requestAnimationFrame(() => this.#attach(tries + 1));
        return;
      }
      this.#follow(slot);
      this.#relayout();
    }

    /** An exit is moving the title (an `instant` run moves nothing). */
    #exiting(): boolean {
      return !!this.#run && this.#run.kind !== 'instant';
    }

    #relayout() {
      // Mid-exit, the trajectory is fixed: it was measured when it began.
      if (this.#exiting() || !this.#mode) return;
      if (this.#mode === 'card') {
        // The hang's tokens follow the viewport (the title's size is in vw).
        this.#readHang();
        this.#draw();
        return;
      }
      if (!this.#fontsReady) return;
      const slot = this.#slot;
      if (!slot || !slot.isConnected || slot.getClientRects().length === 0) {
        if (this.#findSlot()) this.#attach();
        else this.#setReady(false);
        return;
      }
      this.#restMeasure(slot);
      this.#state = DOT_AT_REST;
      this.#setAnchored(true);
      this.#draw();
      this.#setReady(true);
    }

    /** Measure the dot in `slot` and the title's start, with the header at rest. */
    #restMeasure(slot: HTMLElement) {
      const m = this.#measure(slot);
      this.#measured = m;
      const r = slot.getBoundingClientRect();
      const title = slot.closest<HTMLElement>('.page-title') ?? slot;
      const tr = title.getBoundingClientRect();
      const hr = (slot.closest<HTMLElement>('.page-header') ?? title).getBoundingClientRect();
      this.#start = {
        slot: { x: r.left + m.centre.x, y: r.top + m.centre.y },
        titleOrigin: { x: tr.left, y: tr.top },
        // Far enough up to take the whole header off the top: its height, or
        // its bottom edge if something sits above it.
        headerHeight: Math.ceil(Math.max(hr.height, hr.bottom)),
      };
      this.#separation = hangSeparation(this.#start.headerHeight, this.#start.slot.y);
    }

    #measure(slot: HTMLElement): Measured {
      const cs = getComputedStyle(slot);
      const px = parseFloat(cs.fontSize);
      // The baseline, from the engine's own layout of a full stop in this font.
      const ps = this.#probeText.style;
      ps.fontFamily = cs.fontFamily;
      ps.fontSize = cs.fontSize;
      ps.fontWeight = cs.fontWeight;
      ps.fontStyle = cs.fontStyle;
      const baseline = this.#probeBase.getBoundingClientRect().bottom - this.#probeText.getBoundingClientRect().top;
      const { ink } = scanInk(cs);
      return { ...dotInSlot(ink, px, baseline), em: px, slotW: slot.getBoundingClientRect().width };
    }

    /** The hang's size and em, px: `--mark-hang-size` and `--mark-hang-em`, resolved by the browser. */
    #readHang() {
      const r = this.#hangProbe.getBoundingClientRect();
      this.#hang = r.width > 0 && r.height > 0 ? { size: r.width, em: r.height } : null;
    }

    /**
     * While the mark is drawn, the title's own full stop is hidden, and the
     * server's hanging pose is retired (`html[data-mark-ready]`).
     */
    #setReady(on: boolean) {
      document.documentElement.toggleAttribute('data-mark-ready', on);
    }

    // ── Where the slot is now ──────────────────────────────────────

    /**
     * Where the dot is drawn from now: the slot's centre (viewport coords),
     * the dot's size and em there, and `poseBlend`'s denominator.
     */
    #now(): { c: V; size: number; em: number; separation: number } | null {
      if (!this.#mode) return null;
      const m = this.#measured;
      const run = this.#run && this.#run.kind !== 'instant' ? this.#run : null;
      const source = slotSource({
        mode: this.#mode,
        run: run ? (run.kind === 'live' ? 'live' : 'vt') : null,
        direction: run?.direction,
        runStart: !!run?.start && !!m,
        slot: !!this.#slot?.isConnected && this.#slot.getClientRects().length > 0,
      });
      const hang = this.#hang;
      if (source === 'hang') {
        // No title: the slot is the hang's own, HANG_DEPTH em above the edge.
        if (!hang) return null;
        return { c: hangSlot(viewportNow().width / 2, hang.em), ...hang, separation: HANG_DEPTH * hang.em };
      }
      if (source === 'none' || !m) return null;
      /** The title's dot grown by `k`, landing on the hang's as it finishes growing. */
      const grown = (k: number) => (hang ? grownDot(m, k, hang) : { size: m.size * k, em: m.em * k });
      if (source === 'exit' || source === 'tracked') {
        const f = titleExit(run!.start!, run!.viewport, exitTime(run!.clock?.currentTime), { direction: run!.direction });
        const g = grown(f.title.scale);
        if (source === 'exit') return { c: f.title.slot, ...g, separation: this.#separation };
        // The new element itself isn't transformed (its snapshot is), so its
        // slot is where it is laid out now; the snapshot's keyframes move it
        // from there by the trajectory's offset, and grow it about the slot.
        const r = this.#slot!.getBoundingClientRect();
        const o = f.title.offset;
        return { c: { x: r.left + m.centre.x + o.x, y: r.top + m.centre.y + o.y }, ...g, separation: this.#separation };
      }
      // `live`: transforms included, since the trim close animates the live title.
      const r = this.#slot!.getBoundingClientRect();
      const k = m.slotW > 0 ? r.width / m.slotW : 1;
      return { c: { x: r.left + m.centre.x * k, y: r.top + m.centre.y * k }, ...grown(k), separation: this.#separation };
    }

    // ── Drawing ────────────────────────────────────────────────────

    #draw(): boolean {
      const s = this.#now();
      if (!s) return false;
      // In the overlay's own coordinates, whichever box it is positioned
      // against. The hit target shares that box.
      const o = this.#overlay.getBoundingClientRect();
      const shift = (v: V): V => ({ x: v.x - o.left, y: v.y - o.top });
      const { size, em } = s;
      const stopped = this.#state.stopped;
      // Caught at the edge, the dot's height is its own; otherwise it is in the slot.
      const y = stopped ? this.#state.y.x : s.c.y;
      const centre = shift({ x: s.c.x, y });
      const corner: V = { x: centre.x - size / 2, y: centre.y - size / 2 };
      const f = (n: number) => n.toFixed(2);
      this.#dot.setAttribute('x', f(corner.x));
      this.#dot.setAttribute('y', f(corner.y));
      this.#dot.setAttribute('width', f(size));
      this.#dot.setAttribute('height', f(size));

      const k = tautness(this.#ts);
      const p = poseBlend(stopped, s.c.y, s.separation);
      // The anchors leave the letters for the hang's own as the pose blends
      // (hang.ts), so the end of an exit is the picture a cold load starts with.
      const anchors = anchorSlot(s.c, em, p);
      const geoms = poseThreads(MARK_RIG, { slot: shift(anchors), dot: corner, size, em, p });
      // Only the threads that carry a tool in play take the pull (all of them, for a tug).
      const taut = tautThreads(this.#tools, this.#pulled, geoms.length);
      const pulled = geoms.map((g, i) => (k > 0 && taut[i] ? tauten(g, k) : g));
      pulled.forEach((g, i) => this.#paths[i]?.setAttribute('d', threadPathData(g)));
      const stroke = String(threadStroke(MARK_RIG, em));
      for (const path of this.#paths) path.style.setProperty('stroke-width', stroke);

      // Hanging, only the lower part of the dot is on screen: aim at that.
      const top = Math.max(-o.top, centre.y - size / 2);
      const hy = stopped ? (top + centre.y + size / 2) / 2 : centre.y;
      const hs = this.#hit.style;
      hs.setProperty('--site-mark-x', `${f(centre.x)}px`);
      hs.setProperty('--site-mark-y', `${f(hy)}px`);
      hs.setProperty('--site-mark-size', `${f(size)}px`);
      this.#drawTools(pulled, o, stopped);
      return true;
    }

    /**
     * Hang each open tool from its pivot and draw its string and bauble. A
     * top-level tool's pivot is its thread's (`toolPivot`: the anchor in the
     * title, or where the thread crosses the top edge when hanging); a child's
     * is its parent's bauble, as just drawn (parents come first).
     */
    #drawTools(geoms: ReturnType<typeof poseThreads>, o: DOMRect, hanging: boolean) {
      const byId = new Map(this.#tools.map((t) => [t.id, t]));
      const f = (n: number) => n.toFixed(1);
      for (const t of this.#tools) {
        t.at = null;
        if (!t.el.hasAttribute('data-open')) continue;
        let pivot: V;
        if (t.parent === null) {
          const g = t.thread === null ? undefined : geoms[t.thread];
          if (!g) continue;
          pivot = toolPivot(g, hanging, -o.top);
        } else {
          const p = byId.get(t.parent);
          if (!p?.at) continue;
          pivot = childPivot(p.at, p.radius, p.scale);
        }
        // Dragged, the bauble is where the pointer is and the string follows.
        if (t.pointer) t.b = baubleAt(pivot, { x: t.pointer.x - o.left, y: t.pointer.y - o.top });
        const at = baublePos(pivot, t.b);
        t.at = at;
        t.scale = t.pointer ? 1 : clamp01(t.s.x);
        t.line.setAttribute('x1', f(pivot.x));
        t.line.setAttribute('y1', f(pivot.y));
        t.line.setAttribute('x2', f(at.x));
        t.line.setAttribute('y2', f(at.y));
        t.bauble.setAttribute('transform', `translate(${f(at.x)} ${f(at.y)}) scale(${t.scale.toFixed(3)})`);
      }
    }

    // ── The loop ───────────────────────────────────────────────────

    #wake() {
      if (this.#frame) return;
      this.#last = 0;
      this.#frame = requestAnimationFrame(this.#tick);
    }

    /** Runs only while something moves: an exit, the dot settling, or a tug. */
    #tick = (now: number) => {
      this.#frame = 0;
      const dt = this.#last ? Math.min(0.05, (now - this.#last) / 1000) : 1 / 60;
      this.#last = now;
      const s = this.#now();
      if (!s || !this.#mode) {
        // Nothing to draw yet (a return still waiting for its new title).
        if (this.#run) this.#frame = requestAnimationFrame(this.#tick);
        return;
      }
      const moves = this.#moves();
      const size = s.size;
      const vy = this.#prevY === null ? 0 : (s.c.y - this.#prevY) / dt;
      this.#prevY = s.c.y;
      // Carried up with the title, the dot is caught at the edge and settles
      // there; carried back down, it lets go (motion.ts).
      this.#state = stepDot(this.#state, {
        slotY: s.c.y,
        slotVy: vy,
        mode: this.#mode,
        size,
        taut: this.#ts.taut.x,
        dt,
        reduced: !moves,
      });
      if (this.#ts.phase !== 'rest') {
        this.#ts = stepTools(this.#ts, dt, !moves);
        if (this.#tug) {
          this.#ts = lapseTug(this.#ts);
          if (this.#ts.phase === 'rest') this.#ts = TOOLS_CLOSED;
        }
      }
      const toolsBusy = this.#stepTools(dt, !moves);
      const busy = !!this.#run || this.#ts.phase !== 'rest' || toolsBusy || dotMoving(this.#state, size, this.#ts.taut.x);
      // Settled in the title: hand the overlay to the document, where it
      // scrolls with the text. Hanging, it stays on the viewport.
      if (!busy && this.#mode === 'page' && !this.#state.stopped) this.#setAnchored(true);
      this.#draw();
      this.#setReady(true);
      if (busy) this.#frame = requestAnimationFrame(this.#tick);
      else this.#prevY = null;
    };

    // ── The dot: open and close the tools, or tug ───────────────────

    #onHit = (e: MouseEvent) => {
      e.preventDefault();
      // Mid-exit, nothing to pull. Hanging, there is always a dot; in the
      // title, only once it is measured.
      if (this.#exiting()) return;
      if (this.#mode === 'page' ? !this.#measured : this.#mode !== 'card') return;
      // A click from the keyboard (Enter/Space on the button) has no pointer
      // detail: focus goes into the tools it opens.
      if (this.#ts.want && !this.#tug) this.#setOpen(false);
      else this.#setOpen(true, e.detail === 0);
    };

    /**
     * Escape cancels a drag in progress, wherever focus is (a pointer drag
     * doesn't move it); otherwise it closes the tools. A focused bauble's own
     * handler has had it first, and the behaviour's `key` may have taken it.
     */
    #onKey = (e: KeyboardEvent) => {
      if (e.key !== 'Escape' || e.defaultPrevented || !this.#ts.want || this.#tug) return;
      const dragged = this.#tools.filter((t) => t.dragId !== null);
      if (dragged.length) {
        e.preventDefault();
        for (const t of dragged) this.#endDrag(t, true);
        return;
      }
      this.#setOpen(false);
    };

    /**
     * Ask for the tools open or closed: a pull on the threads that carry them,
     * then they drop (or are reeled in) on the release (motion.ts). When
     * nothing would drop it is the tug, which does nothing under reduced motion.
     */
    #setOpen(open: boolean, fromKeyboard = false) {
      const reduced = !this.#moves();
      if (open) {
        const visible = this.#resolveVisible();
        if (isTug(this.#tools, visible)) {
          if (reduced) return;
          const next = setWant(this.#ts, true, false);
          if (next === this.#ts) return;
          this.#tug = true;
          this.#pulled = null;
          this.#ts = next;
          this.#wake();
          return;
        }
        const next = setWant(this.#ts, true, reduced);
        if (next === this.#ts) return;
        this.#tug = false;
        this.#ts = next;
        this.#visible = visible;
        this.#pulled = new Set(this.#tools.filter((t) => t.parent === null && visible.has(t.id)).map((t) => t.id));
        this.#watch();
        for (const t of this.#tools) if (visible.has(t.id)) this.#hangOut(t, reduced);
        this.#hit.setAttribute('aria-expanded', 'true');
        if (fromKeyboard) this.#focusTool(focusOrder(this.#tools, visible)[0] ?? null);
        this.#wake();
        return;
      }
      // Closing. A tug lapses on its own.
      if (this.#tug || !this.#ts.want) return;
      for (const t of this.#tools) if (t.dragId !== null) this.#endDrag(t, true);
      this.#pulled = new Set(this.#tools.filter((t) => t.parent === null && t.el.hasAttribute('data-open')).map((t) => t.id));
      this.#ts = setWant(this.#ts, false, reduced);
      this.#hit.setAttribute('aria-expanded', 'false');
      // Focus in a tool that is going away goes back to the dot.
      if (this.#group?.contains(document.activeElement)) this.#hit.focus();
      this.#wake();
    }

    /** Start `t` hanging: drawn from its pivot, nothing paid out yet, with a swing to fall into. */
    #hangOut(t: Tool, reduced: boolean) {
      if (t.el.hasAttribute('data-open')) return;
      t.el.setAttribute('data-open', '');
      t.b = { r: 0, rv: 0, theta: 0, omega: reduced ? 0 : DROP_KICK };
      t.s = { x: reduced ? 1 : 0, v: 0 };
      const kind = this.#behaviour(t)?.kind;
      if (kind) t.bauble.dataset.kind = kind;
    }

    #behaviour(t: Tool): ToolBehaviour | undefined {
      const b = toolBehaviour(t.behaviour);
      if (!b && !this.#missing.has(t.behaviour)) {
        this.#missing.add(t.behaviour);
        console.warn(`site-mark: no tool behaviour "${t.behaviour}" registered; "${t.id}" stays up.`);
      }
      return b;
    }

    /** Which tools hang now: shown by their behaviour, and hanging from something that hangs. */
    #resolveVisible(): Set<string> {
      const byId = new Map(this.#tools.map((t) => [t.id, t]));
      return visibleTools(this.#tools, (n) => {
        const b = this.#behaviour(byId.get(n.id)!);
        return !!b && (b.shown ? b.shown() : true);
      });
    }

    /** Follow the behaviours' `changed` while the tools are open. */
    #watch() {
      if (this.#unsubscribe) return;
      const seen = new Set<ToolBehaviour>();
      this.#unsubscribe = [];
      for (const t of this.#tools) {
        const b = toolBehaviour(t.behaviour);
        if (!b?.subscribe || seen.has(b)) continue;
        seen.add(b);
        this.#unsubscribe.push(b.subscribe(this.#onShownChanged));
      }
    }

    #unwatch() {
      for (const off of this.#unsubscribe ?? []) off();
      this.#unsubscribe = null;
    }

    /**
     * A behaviour says its `shown()` may have changed. While open, each tool
     * that now hangs and didn't drops on its own, and each that no longer
     * hangs is reeled in on its own; no pull on the threads.
     */
    #onShownChanged = () => {
      if (!this.#ts.want || this.#tug) return;
      const before = this.#visible;
      const now = this.#resolveVisible();
      this.#visible = now;
      const reduced = !this.#moves();
      const active = document.activeElement;
      for (const t of this.#tools) {
        if (now.has(t.id) && !before.has(t.id)) this.#hangOut(t, reduced);
        else if (!now.has(t.id) && before.has(t.id)) {
          if (t.dragId !== null) this.#endDrag(t, true);
          if (active instanceof Element && t.el.contains(active)) this.#focusTool(focusFallback(this.#tools, t.id, now));
        }
      }
      this.#wake();
    };

    /** Focus a tool's bauble, or the dot for null. */
    #focusTool(id: string | null) {
      const t = id === null ? null : this.#tools.find((x) => x.id === id);
      (t?.bauble ?? this.#hit).focus({ preventScroll: true });
    }

    /**
     * One frame of every open tool: its string pays out to its length (or in
     * to nothing) and it swings; it grows as it drops and shrinks as it is
     * reeled in, and once reeled in it is no longer drawn. True while any of
     * it still moves.
     */
    #stepTools(dt: number, reduced: boolean): boolean {
      let busy = false;
      const ts = this.#ts;
      for (const t of this.#tools) {
        if (!t.el.hasAttribute('data-open')) continue;
        const len = toolLength(t, ts.toolsOut, this.#visible);
        const out = len > 0;
        if (!t.pointer) {
          const spring = out ? DROP : REEL;
          t.b = reduced ? { r: len, rv: 0, theta: 0, omega: 0 } : subStep(t.b, dt, (b, h) => stepBauble(b, len, h, spring));
        }
        t.s = stepToolSize(t.s, out, dt, reduced);
        if (toolReeledIn({ ...ts, toolsOut: out }, t.b.r, t.s.x, !!t.pointer)) {
          t.el.removeAttribute('data-open');
          t.at = null;
          continue;
        }
        if (t.pointer || baubleMoving(t.b, len) || Math.abs(t.s.x - (out ? 1 : 0)) > 0.005) busy = true;
      }
      // Closed and every tool in: stop listening until the next open.
      if (!ts.want && ts.phase === 'rest' && !this.#tools.some((t) => t.el.hasAttribute('data-open'))) {
        this.#unwatch();
        this.#pulled = null;
      }
      return busy;
    }

    // ── A tool's own pointer and keys ──────────────────────────────

    /**
     * Every bauble gets the same wiring; what a gesture does is decided by its
     * behaviour's `kind` when it happens (a behaviour may register after the
     * mark has connected).
     */
    #wireTool(t: Tool) {
      const point = (e: PointerEvent | MouseEvent): ViewportPoint => ({ x: e.clientX, y: e.clientY });
      const el = t.bauble;
      el.addEventListener('pointerdown', (e) => {
        if (e.button !== 0 || !t.el.hasAttribute('data-open') || t.dragId !== null) return;
        const b = this.#behaviour(t);
        if (b?.kind !== 'drag') return;
        e.preventDefault();
        el.setPointerCapture(e.pointerId);
        el.setAttribute('data-dragging', '');
        t.dragId = e.pointerId;
        t.pointer = point(e);
        b.dragStart?.(point(e));
        this.#wake();
      });
      el.addEventListener('pointermove', (e) => {
        if (e.pointerId !== t.dragId) return;
        t.pointer = point(e);
        this.#behaviour(t)?.dragMove?.(point(e));
        this.#wake();
      });
      el.addEventListener('pointerup', (e) => {
        if (e.pointerId === t.dragId) this.#endDrag(t, false, point(e));
      });
      el.addEventListener('pointercancel', (e) => {
        if (e.pointerId === t.dragId) this.#endDrag(t, true, point(e));
      });
      el.addEventListener('click', (e) => {
        const b = this.#behaviour(t);
        if (b?.kind !== 'press') return;
        e.preventDefault();
        b.press?.();
      });
      el.addEventListener('keydown', (e) => {
        // Escape mid-drag cancels the drag, and only that.
        if (e.key === 'Escape' && t.dragId !== null) {
          e.preventDefault();
          this.#endDrag(t, true);
          return;
        }
        const b = this.#behaviour(t);
        if (b?.key?.(e)) {
          e.preventDefault();
          return;
        }
        if (b?.kind === 'press' && (e.key === 'Enter' || e.key === ' ')) {
          e.preventDefault();
          b.press?.();
        }
      });
    }

    /** Let go of a drag: the bauble swings back to hang from its string. */
    #endDrag(t: Tool, cancelled: boolean, p?: ViewportPoint) {
      const at = p ?? t.pointer ?? { x: 0, y: 0 };
      const id = t.dragId;
      t.dragId = null;
      t.pointer = null;
      t.bauble.removeAttribute('data-dragging');
      if (id !== null && t.bauble.hasPointerCapture(id)) t.bauble.releasePointerCapture(id);
      this.#behaviour(t)?.dragEnd?.(at, cancelled);
      this.#wake();
    }
  }

  if (!customElements.get('site-mark')) customElements.define('site-mark', SiteMark);
</script>
