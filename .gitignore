dist/
node_modules/
.env
.env.*
!.env.example
.astro/

# Dev files live in Obsidian vault
dev/plans/
dev/bugs/
dev/milestones/

# Playwright MCP session artifacts (snapshots, traces)
.playwright-mcp/

# Content vault: src/content is its own Obsidian vault. Shared settings are
# committed so vault behaviour is reproducible across devices; per-device state
# and vendored plugin code are not.
src/content/.obsidian/workspace*.json
src/content/.obsidian/cache
src/content/.obsidian/plugins/*/*
!src/content/.obsidian/plugins/*/data.json
# ...except our own plugin, which is source, not vendored code.
!src/content/.obsidian/plugins/pdyxs-card-links/**
# obsidian-git's data.json can carry git credentials — never commit it.
src/content/.obsidian/plugins/obsidian-git/data.json
src/content/.trash/

# Houston build SWFs for the comparison page (#200): fetched from Koofr, never committed.
# Fetch commands are at the top of src/pages/experiments/houston-builds.astro.
public/experiments/houston/
