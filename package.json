{
    "name": "pdyxs-temp",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "predev": "npm run generate:lenses && npm run generate:lens-icons && npm run generate:dither && node scripts/generate-stack-manifest.mjs && npm run generate:redirects",
        "dev": "astro dev",
        "prebuild": "npm run generate:lenses && npm run generate:lens-icons && npm run generate:dither && node scripts/generate-stack-manifest.mjs && npm run generate:redirects",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "check": "astro check",
        "generate:lenses": "node scripts/generate-lens-registry.mjs",
        "generate:lens-icons": "node scripts/generate-lens-icons.mjs",
        "generate:dither": "node scripts/gen-dither.mjs",
        "generate:manifest": "node scripts/generate-stack-manifest.mjs",
        "generate:redirects": "node scripts/generate-redirects.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "restart-server": "systemctl --user restart astro-preview.service"
    },
    "dependencies": {
        "@astrojs/rss": "^4.0.18",
        "@astrojs/svelte": "^8.0.5",
        "astro": "^6.1.4",
        "svelte": "^5.55.4"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@types/js-yaml": "^4.0.9",
        "@vitest/ui": "^4.1.4",
        "gray-matter": "^4.0.3",
        "happy-dom": "^20.8.9",
        "svgo": "^4.0.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.4"
    }
}
